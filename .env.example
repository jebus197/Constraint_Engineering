# CDSFL model-route credentials — copy real values into .env (gitignored).
# .env is APPEND-ONLY for agents: never rewrite the whole file. Lines may use `export KEY=value`
# (shell style) or `KEY=value` — python-dotenv and the preflight accept BOTH (2026-07-08 fix).
# Verify with: python3 scripts/check_model_keys.py
OPENROUTER_API_KEY=        # REQUIRED — Codex + ChatGPT + Gemini panel routes
DEEPSEEK_API_KEY=          # REQUIRED — DeepSeek direct route
SEMANTIC_SCHOLAR_API_KEY=  # optional — ouroboros literature route (fast tier)
GEMINI_API_KEY=            # optional — legacy direct-Google fallback
