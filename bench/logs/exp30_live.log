      "PROPOSED_FIX": "FIND: `bench/immune_agents.py`, `_verify_search_manifest()`.\nFIX: require all manifest file/path targets to resolve inside the provided `source_paths`, and only count grep/glob steps whose target paths are in scope.\n\n<<<<\ndef _verify_search_manifest(\n    manifest: List[Dict[str, Any]],\n    source_paths: List[str],\n) -> Tuple[int, int, List[str]]:\n    \"\"\"Mechanically verify the CT v2 search manifest.\n\n    Checks that the agent's claimed searches could actually have been\n    performed (files exist, grep patterns are valid).\n\n    Returns:\n        (verified_count, total_count, issues)\n    \"\"\"\n    verified = 0\n    issues: List[str] = []\n    source_set = set(str(p) for p in source_paths)\n    source_basenames = {os.path.basename(str(p)): str(p) for p in source_paths}\n\n    for step in manifest:\n        tool = step.get(\"tool\", \"\")\n        args = step.get(\"args\", \"\")\n\n        if tool in (\"Read\", \"read\", \"cat\"):\n            # Check file exists\n            file_arg = args if isinstance(args, str) else str(args)\n            # Try exact, then basename\n            exists = (\n                os.path.isfile(file_arg)\n                or file_arg in source_set\n                or os.path.basename(file_arg) in source_basenames\n            )\n            if exists:\n                verified += 1\n            else:\n                issues.append(f\"File not found: {file_arg}\")\n\n        elif tool in (\"Grep\", \"grep\", \"rg\"):\n            # Check pattern is valid regex\n            pattern = args if isinstance(args, str) else str(args)\n            try:\n                re.compile(pattern)\n                verified += 1  # Pattern is at least syntactically valid\n            except re.error:\n                issues.append(f\"Invalid grep pattern: {pattern}\")\n\n        elif tool in (\"Glob\", \"glob\"):\n            verified += 1  # Glob patterns are hard to invalidate\n\n        else:\n            issues.append(f\"Unknown tool: {tool}\")\n\n    return verified, len(manifest), issues\n>>>>\n====\ndef _verify_search_manifest(\n    manifest: List[Dict[str, Any]],\n    source_paths: List[str],\n) -> Tuple[int, int, List[str]]:\n    \"\"\"Mechanically verify the CT v2 search manifest.\n\n    Counts only manifest steps whose target files/patterns are scoped to the\n    provided source_paths.\n    \"\"\"\n    verified = 0\n    issues: List[str] = []\n    source_set = {os.path.realpath(str(p)) for p in source_paths}\n    source_basenames = {\n        os.path.basename(str(p)): os.path.realpath(str(p)) for p in source_paths\n    }\n    allowed_dirs = {os.path.realpath(os.path.dirname(str(p))) for p in source_paths}\n\n    def _resolve_in_scope_path(raw: str) -> Optional[str]:\n        if not raw:\n            return None\n        real = os.path.realpath(raw)\n        if real in source_set:\n            return real\n        base = os.path.basename(raw)\n        if base in source_basenames:\n            return source_basenames[base]\n        for sp in source_set:\n            if sp.endswith(raw):\n                return sp\n        return None\n\n    for step in manifest:\n        tool = str(step.get(\"tool\", \"\")).strip()\n        args = step.get(\"args\", \"\")\n\n        if tool in (\"Read\", \"read\", \"cat\"):\n            file_arg = args if isinstance(args, str) else str(args)\n            resolved = _resolve_in_scope_path(file_arg)\n            if resolved and os.path.isfile(resolved):\n                verified += 1\n            else:\n                issues.append(f\"Out-of-scope or missing file: {file_arg}\")\n\n        elif tool in (\"Grep\", \"grep\", \"rg\"):\n            if isinstance(args, dict):\n                pattern = str(args.get(\"pattern\", \"\"))\n                targets = args.get(\"paths\", [])\n                if isinstance(targets, str):\n                    targets = [targets]\n            else:\n                pattern = str(args)\n                targets = []\n            try:\n                re.compile(pattern)\n            except re.error:\n                issues.append(f\"Invalid grep pattern: {pattern}\")\n                continue\n            if not targets:\n                issues.append(\"Grep step missing target paths\")\n                continue\n            resolved_targets = [_resolve_in_scope_path(t) for t in targets]\n            if all(rt is not None for rt in resolved_targets):\n                verified += 1\n            else:\n                issues.append(f\"Out-of-scope grep target(s): {targets}\")\n\n        elif tool in (\"Glob\", \"glob\"):\n            patterns = args if isinstance(args, list) else [args]\n            ok = True\n            for pat in patterns:\n                pat_str = str(pat)\n                if os.path.isabs(pat_str):\n                    real_pat = os.path.realpath(os.path.dirname(pat_str))\n                    if not any(\n                        real_pat == d or real_pat.startswith(d + os.sep)\n                        for d in allowed_dirs\n                    ):\n                        ok = False\n                        break\n            if ok:\n                verified += 1\n            else:\n                issues.append(f\"Out-of-scope glob args: {args}\")\n\n        else:\n            issues.append(f\"Unknown tool: {tool}\")\n\n    return verified, len(manifest), issues\n>>>>",
