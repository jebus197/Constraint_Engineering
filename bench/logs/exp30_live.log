              ))\n            if findings:\n                persisted_round_idx = findings[0].round_idx\n            else:\n                persisted_round_idx = len(findings_by_round)\n            findings_by_round[persisted_round_idx] = findings\n\n        self.state.current_round = data.get(\"completed_round\", 0)\n        self.state.active_models = data.get(\"active_models\", [])\n        self.state.converged = data.get(\"converged\", False)\n        self.state.convergence_reason = data.get(\"convergence_reason\", \"\")\n        self.state.failed = data.get(\"failed\", False)\n        self.state.failure_reason = data.get(\"failure_reason\", \"\")\n\n        # Restore directed messages\n        self.state.directed_messages = []\n        for dm_data in data.get(\"directed_messages\", []):\n            self.state.directed_messages.append(DirectedMessage(\n                sender=dm_data[\"sender\"],\n                recipient=dm_data[\"recipient\"],\n                content=dm_data[\"content\"],\n                round_idx=dm_data[\"round_idx\"],\n                message_type=dm_data.get(\"message_type\", \"question\"),\n            ))\n\n        # Restore round records from checkpoint using persisted round_idx keys.\n        self.state.round_records = []\n        rr_by_idx = {\n            int(r[\"round_idx\"]): r\n            for r in data.get(\"round_records\", [])\n            if isinstance(r, dict) and \"round_idx\" in r\n        }\n        restored_round_indices = sorted(set(rr_by_idx) | set(findings_by_round))\n\n        # Replay findings into a fresh convergence detector with persisted durations.\n        self.conv_detector = ConvergenceDetector(self.config)\n        self.state.all_findings = []\n        for round_idx in restored_round_indices:\n            findings = findings_by_round.get(round_idx, [])\n            rr = rr_by_idx.get(round_idx, {})\n            duration = float(rr.get(\"duration_s\", 0.0))\n            self.state.all_findings.append(findings)\n            self.state.round_records.append(RoundRecord(\n                round_idx=round_idx,\n                timestamp=rr.get(\"timestamp\", \"\"),\n                model_responses={},  # Not stored in checkpoint — available in round_XX.json\n                findings=findings,\n                finding_count=len(findings),\n                metrics=dict(rr.get(\"metrics\", {})),\n                failures=dict(rr.get(\"failures\", {})),\n                duration_s=duration,\n            ))\n            self.conv_detector.add_round_findings(round_idx, findings, duration=duration)\n>>>>\n\nFOLLOW: This fix changes the invariant assumed by `read_context()` and `compute_metrics()`: list position is no longer guaranteed to equal `round_idx`. Any code indexing `self.state.all_findings[round_idx]` or `self.state.round_records[round_idx]` by round number becomes unsafe after correct recovery. In this file, `compute_metrics()` still does exactly that for `findings_this_round` and round metric attachment, so it requires keyed lookup once this fix is applied. `signal_complete()` and relay paths iterate over lists and remain valid."
