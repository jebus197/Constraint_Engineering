      "PROPOSED_FIX": "<<<< def _cli_verify_chain(args: argparse.Namespace) -> int:\n    \"\"\"Handle the 'verify-chain' subcommand.\"\"\"\n    chain = VerificationChain.load_json(args.chain_file)\n    valid, msg = chain.verify_chain()\n    print(msg)\n    return 0 if valid else 1\n====\ndef _load_cli_verifier(public_key_path: Optional[str]) -> Optional[Verifier]:\n    \"\"\"Load an Ed25519 public key for CLI signature verification.\"\"\"\n    if public_key_path is None:\n        return None\n    if not _HAS_CRYPTO:\n        raise RuntimeError(\n            \"Public-key verification requested but 'cryptography' is not available\"\n        )\n    from cryptography.hazmat.primitives.serialization import load_pem_public_key\n\n    with open(public_key_path, \"rb\") as f:\n        key = load_pem_public_key(f.read())\n    if not isinstance(key, Ed25519PublicKey):\n        raise ValueError(\"Public key must be an Ed25519 PEM key\")\n    return Verifier(key)\n\n\ndef _chain_has_authenticated_records(chain: VerificationChain) -> bool:\n    return any(\n        r.get(\"signature\", {}).get(\"attribution\") == \"authenticated\"\n        for r in chain.records\n    )\n\n\ndef _cli_verify_chain(args: argparse.Namespace) -> int:\n    \"\"\"Handle the 'verify-chain' subcommand.\"\"\"\n    chain = VerificationChain.load_json(args.chain_file)\n    verifier = _load_cli_verifier(getattr(args, \"public_key\", None))\n    if verifier is None and _chain_has_authenticated_records(chain):\n        print(\n            \"WARNING: authenticated records present but no --public-key was supplied; \"\n            \"signatures were not verified.\",\n            file=sys.stderr,\n        )\n    valid, msg = chain.verify_chain(verifier=verifier)\n    print(msg)\n    return 0 if valid else 1\n>>>>\n<<<< def _cli_verify_record(args: argparse.Namespace) -> int:\n    \"\"\"Handle the 'verify-record' subcommand.\"\"\"\n    chain = VerificationChain.load_json(args.chain_file)\n    valid, msg = chain.verify_record(args.index)\n    print(f\"Record {args.index}: {msg}\")\n    return 0 if valid else 1\n====\ndef _cli_verify_record(args: argparse.Namespace) -> int:\n    \"\"\"Handle the 'verify-record' subcommand.\"\"\"\n    chain = VerificationChain.load_json(args.chain_file)\n    verifier = _load_cli_verifier(getattr(args, \"public_key\", None))\n    record = chain.records[args.index] if 0 <= args.index < len(chain.records) else None\n    if (\n        verifier is None\n        and record is not None\n        and record.get(\"signature\", {}).get(\"attribution\") == \"authenticated\"\n    ):\n        print(\n            \"WARNING: record is authenticated but no --public-key was supplied; \"\n            \"signature was not verified.\",\n            file=sys.stderr,\n        )\n    valid, msg = chain.verify_record(args.index, verifier=verifier)\n    print(f\"Record {args.index}: {msg}\")\n    return 0 if valid else 1\n>>>>\n<<<<     p_vc = sub.add_parser(\"verify-chain\", help=\"Verify entire chain\")\n    p_vc.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n====\n    p_vc = sub.add_parser(\"verify-chain\", help=\"Verify entire chain\")\n    p_vc.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n    p_vc.add_argument(\n        \"--public-key\",\n        default=None,\n        help=\"Path to Ed25519 PEM public key for signature verification\",\n    )\n>>>>\n<<<<     p_vr = sub.add_parser(\"verify-record\", help=\"Verify a single record\")\n    p_vr.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n    p_vr.add_argument(\"--index\", type=int, required=True)\n====\n    p_vr = sub.add_parser(\"verify-record\", help=\"Verify a single record\")\n    p_vr.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n    p_vr.add_argument(\"--index\", type=int, required=True)\n    p_vr.add_argument(\n        \"--public-key\",\n        default=None,\n        help=\"Path to Ed25519 PEM public key for signature verification\",\n    )\n>>>>",
