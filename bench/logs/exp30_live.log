        locked_rejected = set()
        for tf in triaged:
            fid = tf.finding.finding_id
            v1v = final_verdicts.get(fid)  # from v1 synthesis
            v2v = v2_final.get(fid) if 'v2_final' in locals() else None
            if v1v == "REJECTED" and v2v == "REJECTED":
                locked_rejected.add(fid)
        
