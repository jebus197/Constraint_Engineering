h_index} \"\n                    f\"with record_count={record_count}\"\n                )\n\n        leaves = [_digest_bytes(r[\"chain_hash\"]) for r in self._records[:record_count]]\n        proof_steps = rfc9162_inclusion_proof(leaves, index)\n        root = rfc9162_merkle_root(leaves)\n        return {\n            \"index\": index,\n            \"epoch_index\": root_epoch_index,\n            \"record_count\": record_count,\n            \"chain_hash\": self._records[index][\"chain_hash\"],\n            \"proof\": proof_steps,\n            \"merkle_root\": \"sha256:\" + root.hex(),\n        }\n>>>>",
