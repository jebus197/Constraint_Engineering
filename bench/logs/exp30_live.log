e_flag\": getattr(response, \"autoimmune_flag\", None),\n            \"observation_only\": getattr(response, \"observation_only\", None),\n            \"tool_usage\": dict(getattr(response, \"tool_usage\", {})),\n            \"stage_timings\": dict(getattr(response, \"stage_timings\", {})),\n            \"barrier_results\": [\n                {\n                    \"finding_id\": br.finding_id,\n                    \"passed\": br.passed,\n                    \"reason\": br.reason,\n                    \"cited_file\": br.cited_file,\n                    \"cited_line\": br.cited_line,\n                }\n                for br in getattr(response, \"barrier_results\", [])\n            ],\n        }\n\n    def _save_round_json(self, record: RoundRecord) -> None:\n        \"\"\"Save a single round's data as JSON.\"\"\"\n        filepath = self.logs_dir / f\"round_{record.round_idx:02d}.json\"\n        data = {\n            \"round_idx\": record.round_idx,\n            \"timestamp\": record.timestamp,\n            \"finding_count\": record.finding_count,\n            \"duration_s\": record.duration_s,\n            \"failures\": record.failures,\n            \"metrics\": record.metrics,\n            \"immune_response\": self._summarise_immune_response(record.immune_response),\n            \"findings\": [\n...\n            ],\n            \"model_responses\": {\n                label: text[:10000]  # cap raw text to prevent bloat\n                for label, text in record.model_responses.items()\n            },\n        }\n        filepath.write_text(json.dumps(data, indent=2), encoding=\"utf-8\")\n>>>>\n<<<<     def _save_checkpoint(self) -> None:\n====\n    def _flush_state(self, round_idx: Optional[int] = None) -> None:\n        \"\"\"Synchronise in-memory round state to on-disk JSON artifacts.\"\"\"\n        if round_idx is not None:\n            for rr in self.state.round_records:\n                if rr.round_idx == round_idx:\n                    self._save_round_json(rr)\n                    break\n        self._save_checkpoint()\n\n    def _save_checkpoint(self) -> None:\n>>>>\n<<<<         serialised_round_records = []\n        for rr in self.state.round_records:\n            serialised_round_records.append({\n                \"round_idx\": rr.round_idx,\n                \"timestamp\": rr.timestamp,\n                \"finding_count\": rr.finding_count,\n                \"duration_s\": rr.duration_s,\n                \"failures\": rr.failures,\n                \"metrics\": rr.metrics,\n                # model_responses intentionally omitted — large, already in round_XX.json\n            })\n====\n        serialised_round_records = []\n        for rr in self.state.round_records:\n            serialised_round_records.append({\n                \"round_idx\": rr.round_idx,\n                \"timestamp\": rr.timestamp,\n                \"finding_count\": rr.finding_count,\n                \"duration_s\": rr.duration_s,\n                \"failures\": rr.failures,\n                \"metrics\": rr.metrics,\n                \"immune_response\": self._summarise_immune_response(rr.immune_response),\n                # model_responses intentionally omitted — large, already in round_XX.json\n            })\n>>>>\n<<<<         if round_idx < len(self.state.round_records):\n            self.state.round_records[round_idx].metrics = metrics\n====\n        if round_idx < len(self.state.round_records):\n            self.state.round_records[round_idx].metrics = metrics\n            self._flush_state(round_idx)\n>>>>\n<<<<         if self.state.round_records:\n            self.state.round_records[-1].immune_response = response\n====\n        if self.state.round_records:\n            rr = self.state.round_records[-1]\n            rr.immune_response = response\n            self._flush_state(rr.round_idx)\n>>>>",
