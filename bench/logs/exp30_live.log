      "PROPOSED_FIX": "FIX: anchor the window to the requested `round_idx`, using record.round_idx rather than list tail position.\n<<<<\n    def read_context(\n        self,\n        round_idx: int,\n        window: int = 3,\n    ) -> List[RoundRecord]:\n        \"\"\"Retrieve windowed context from persistence.\n\n        Returns the last `window` rounds of records. Does not return\n        full history — that lives in the persistence layer.\n\n        Args:\n            round_idx: Current round (for reference).\n            window: Number of prior rounds to include.\n\n        Returns:\n            List of RoundRecords within the window.\n        \"\"\"\n        start = max(0, len(self.state.round_records) - window)\n        return self.state.round_records[start:]\n>>>>\n====\n    def read_context(\n        self,\n        round_idx: int,\n        window: int = 3,\n    ) -> List[RoundRecord]:\n        \"\"\"Retrieve windowed context from persistence.\n\n        Returns up to `window` records with `record.round_idx <= round_idx`,\n        ordered as stored. Does not return full history.\n        \"\"\"\n        eligible = [\n            rr for rr in self.state.round_records\n            if rr.round_idx <= round_idx\n        ]\n        if window <= 0:\n            return []\n        return eligible[-window:]\n>>>>",
