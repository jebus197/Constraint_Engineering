        return 1
====
    try:
        with open(args.proof_file, "r") as f:
            proof = json.load(f)
        # Validate proof structure
        if not isinstance(proof, dict):
            raise ValueError("Proof must be a JSON object")
        if "chain_hash" not in proof:
            raise ValueError("Proof missing 'chain_hash'")
        if "proof" not in proof or not isinstance(proof["proof"], list):
            raise ValueError("Proof missing or invalid 'proof' array")
