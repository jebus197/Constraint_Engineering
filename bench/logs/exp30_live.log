(args.index)\n    print(f\"Record {args.index}: {msg}\")\n    return 0 if valid else 1\n====\ndef _cli_verify_record(args: argparse.Namespace) -> int:\n    \"\"\"Handle the 'verify-record' subcommand.\"\"\"\n    chain = VerificationChain.load_json(args.chain_file)\n    verifier = _load_cli_verifier(getattr(args, \"public_key\", None))\n    record = chain.records[args.index] if 0 <= args.index < len(chain.records) else None\n    if (\n        verifier is None\n        and record is not None\n        and record.get(\"signature\", {}).get(\"attribution\") == \"authenticated\"\n    ):\n        print(\n            \"WARNING: record is authenticated but no --public-key was supplied; \"\n            \"signature was not verified.\",\n            file=sys.stderr,\n        )\n    valid, msg = chain.verify_record(args.index, verifier=verifier)\n    print(f\"Record {args.index}: {msg}\")\n    return 0 if valid else 1\n>>>>\n<<<<     p_vc = sub.add_parser(\"verify-chain\", help=\"Verify entire chain\")\n    p_vc.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n====\n    p_vc = sub.add_parser(\"verify-chain\", help=\"Verify entire chain\")\n    p_vc.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n    p_vc.add_argument(\n        \"--public-key\",\n        default=None,\n        help=\"Path to Ed25519 PEM public key for signature verification\",\n    )\n>>>>\n<<<<     p_vr = sub.add_parser(\"verify-record\", help=\"Verify a single record\")\n    p_vr.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n    p_vr.add_argument(\"--index\", type=int, required=True)\n====\n    p_vr = sub.add_parser(\"verify-record\", help=\"Verify a single record\")\n    p_vr.add_argument(\"chain_file\", help=\"Path to chain JSON\")\n    p_vr.add_argument(\"--index\", type=int, required=True)\n    p_vr.add_argument(\n        \"--public-key\",\n        default=None,\n        help=\"Path to Ed25519 PEM public key for signature verification\",\n    )\n>>>>",
