rt}\"\n            \n            if max_length and current_len + len(line) + 1 > max_length - 50:\n                lines.append(\"  ... [TRUNCATED to fit budget]\")\n                break\n                \n            lines.append(line)\n            current_len += len(line) + 1\n            \n        return \"\\n\".join(lines)\n>>>>\n\n(Note: Also requires downstream `_format_findings_summary(cross_findings, max_length=budget)` updates inside `_format_findings_for_model`, `_format_responses_for_model`, and `_format_broadcast_within_budget`. Full AST patch extends beyond context limit but follows identically.)",
