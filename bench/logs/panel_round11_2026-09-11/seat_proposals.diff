--- /dev/null	2026-09-11 01:12:20
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__mb7fh20/repo/bench/tests/test_duplicate_idents_do_not_eat_failures_2026-09-11.py	2026-09-11 01:07:02
@@ -0,0 +1,64 @@
+"""A duplicated task identifier must not make a failing evidence file vanish.
+
+Panel round 11, fable seat, 2026-09-11. The live master task list carried 4
+duplicated identifiers that day: the 2026-09-11 additions reused P1-P4, which
+the standing panel-condition section P1-P7 already owned, and
+`scripts/task_list_markers.py --check` exited 1 naming all 4.
+
+`unsupported_done_entries` wrote `out[e.ident] = sorted(hit)`, so when TWO
+entries share an identifier and BOTH have failing evidence, the second
+assignment overwrote the first and the first entry's failing file disappeared
+from the `DONE ENTRIES WHOSE EVIDENCE FAILED` report. Silent evidence loss
+(section 10, category 4) inside the guard that exists to stop completion
+claims standing on failing tests. Demonstrated by execution before the fix:
+the dict held only `test_beta.py` where two files had failed.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "scripts"))
+from task_list_markers import check, unsupported_done_entries  # noqa: E402
+
+
+def _dup_list(tmp_path: Path) -> Path:
+    f = tmp_path / "list.md"
+    f.write_text(
+        "**P1. First claim, its own evidence.**\n"
+        "<!-- task: P1 | state: DONE | status: ENABLED | "
+        "evidence: bench/tests/test_alpha.py -->\n\n"
+        "**P1. Second claim, different evidence.**\n"
+        "<!-- task: P1 | state: DONE | status: ENABLED | "
+        "evidence: bench/tests/test_beta.py -->\n",
+        encoding="utf-8")
+    return f
+
+
+def test_both_duplicates_failing_evidence_are_both_reported(tmp_path):
+    """The load-bearing case: pre-fix, alpha vanished behind beta."""
+    failed = ["bench/tests/test_alpha.py::t1", "bench/tests/test_beta.py::t2"]
+    hits = unsupported_done_entries(failed, _dup_list(tmp_path))
+    assert hits == {"P1": ["bench/tests/test_alpha.py",
+                           "bench/tests/test_beta.py"]}, (
+        f"a duplicated identifier ate a failing evidence file: {hits}")
+
+
+def test_one_failure_is_attributed_whichever_duplicate_carries_it(tmp_path):
+    hits = unsupported_done_entries(["bench/tests/test_alpha.py::t1"],
+                                    _dup_list(tmp_path))
+    assert hits == {"P1": ["bench/tests/test_alpha.py"]}
+
+
+def test_the_live_list_has_no_duplicate_identifiers():
+    """`--check` refuses duplicates; the live list must stay coherent.
+
+    On 2026-09-11 this was red: P1, P2, P3 and P4 were each used twice. The
+    2026-09-11 additions were renamed P8-P11 to repair it. This pins the
+    repair so the pulse hook's summary line cannot silently carry
+    'MARKER PROBLEM(S)' again.
+    """
+    code, problems = check()
+    dup = [p for p in problems if "already used" in p]
+    assert not dup, "\n".join(dup)

