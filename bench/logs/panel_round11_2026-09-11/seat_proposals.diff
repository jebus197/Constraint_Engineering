@@ -0,0 +1,73 @@
+"""An instrument value typed into prose with nothing declared must be NAMED.
+
+Panel round 11, fable seat, 2026-09-11. The V6 figure mechanism is opt-in by
+recorded design (49 archived briefs), and the cost of that design is exact:
+the round-4 defect itself -- prose saying "gamma is 0.451", nothing declared
+-- passes the validator clean today. Verified by execution before this was
+written: `validate()` + `check_declared_figures()` returned 0 problems for a
+brief carrying that prose undeclared.
+
+The repair is a WARNING channel, not a refusal: refusing would break the
+recorded opt-in design the panel already reviewed. The dispatcher and the
+brief author now hear the undeclared value by name; a brief that declares the
+figure hears nothing.
+"""
+from __future__ import annotations
+
+import importlib.util
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+PBV = ROOT / "scripts" / "panel_brief_validate.py"
+
+_spec = importlib.util.spec_from_file_location("pbv_warn", PBV)
+pbv = importlib.util.module_from_spec(_spec)
+sys.modules["pbv_warn"] = pbv
+_spec.loader.exec_module(pbv)
+
+
+def test_the_round4_defect_shape_is_named():
+    """gamma typed in prose, nothing declared -> exactly 1 warning, naming both."""
+    warns = pbv.check_undeclared_instrument_values(
+        "Section 2 of this brief says `gamma` is 0.451 for the 9-pass series.")
+    assert len(warns) == 1, warns
+    assert "gamma" in warns[0] and "0.451" in warns[0]
+
+
+def test_a_declared_figure_silences_the_warning():
+    text = ("Section 2 says gamma is 0.415413 for the series.\n"
+            "<!-- figure: gamma | scripts/ffafp_cycle_gamma_2026-09-10.py | "
+            "gamma = 0.415413 -->\n")
+    assert pbv.check_undeclared_instrument_values(text) == []
+
+
+def test_a_declarations_own_value_never_warns_about_itself():
+    text = ("<!-- figure: g | scripts/x.py | gamma = 0.415413 -->\n"
+            "Plain prose with no typed instrument value at all.\n")
+    assert pbv.check_undeclared_instrument_values(text) == []
+
+
+def test_prose_integers_do_not_fire():
+    """'nu is 3 of 5' style prose counts are not instrument readings."""
+    assert pbv.check_undeclared_instrument_values(
+        "The severity scale runs 0 to 1 and nu is 3 in the ledger.") == []
+
+
+def test_it_warns_and_does_not_refuse():
+    """The channel is advisory: validate() must not gain a new failure."""
+    text = "A short brief. gamma is 0.451 here."
+    failures = [p for p in pbv.validate(text) if "0.451" in p]
+    assert failures == [], "the warning leaked into the refusal channel"
+
+
+def test_main_prints_the_warning_to_stderr(tmp_path):
+    """The wiring: the CLI names the undeclared value on stderr."""
+    brief = tmp_path / "BRIEF.md"
+    brief.write_text("# Brief\n\ngamma is 0.451 and nothing declares it.\n",
+                     encoding="utf-8")
+    r = subprocess.run([sys.executable, str(PBV), str(brief)],
+                       cwd=ROOT, capture_output=True, text=True, timeout=120)
+    assert "UNDECLARED FIGURE WARNING" in r.stderr
+    assert "0.451" in r.stderr

