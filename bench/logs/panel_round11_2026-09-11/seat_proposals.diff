+#!/usr/bin/env python3
+"""How much of the DONE evidence does the COMMIT HOOK actually run?
+
+TASK V7 CLOSED HALF OF A HOLE AND THE MEASURED HALF IS STILL OPEN. V7's
+`unsupported_done_entries` maps a session's FAILURES back to the DONE entries
+that claim them. It reads outcomes a run already produced; it runs nothing. So
+it can only speak about evidence files that the run in question EXECUTED.
+
+A DONE marker is written at a commit. What executes at a commit is the 8 files
+in `hooks/pre-commit`'s GUARDS list. Everything else is 13 minutes away in the
+full suite -- which is exactly the interval in which task V3 stood DONE on a
+10-of-10 RED file.
+
+This prints the coverage. THE FIGURE IS READ OUT OF THE HOOK AND OUT OF THE
+TASK LIST, never typed, because this project has now had 6 corrections to 1
+typed figure in `hooks/pre-commit`'s own header and the diagnosis was that a
+number nobody is forced to refresh goes stale silently.
+
+    python3 scripts/done_evidence_commit_coverage_2026-09-11.py
+"""
+from __future__ import annotations
+
+import math
+import re
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "scripts"))
+
+import task_list_markers as M  # noqa: E402
+
+LIST = REPO / "experimental_notes" / "CDSFL_MASTER_TASK_LIST.md"
+HOOK = REPO / "hooks" / "pre-commit"
+
+_TEST_PATH = re.compile(r"bench/tests/[\w./-]+\.py")
+
+
+def guard_files(hook: Path = HOOK) -> set[str]:
+    """The test files the commit hook runs, READ from the hook."""
+    if not hook.is_file():
+        return set()
+    return set(_TEST_PATH.findall(hook.read_text(encoding="utf-8", errors="replace")))
+
+
+def done_evidence(path: Path = LIST) -> set[str]:
+    """Every distinct evidence file named by a DONE entry."""
+    return {f for e in M.parse_entries(path) if e.state == "DONE" for f in e.evidence}
+
+
+def wilson(k: int, n: int, z: float = 1.959963985) -> tuple[float, float]:
+    """95% Wilson score interval. Bounds are NOT rounded here.
+
+    `scripts/wilson_interval_consistency.py` caught a seat rounding a lower
+    bound UP, which narrows an interval into a stronger claim than the data
+    supports. Rounding is the caller's decision and must go outward.
+    """
+    if n == 0:
+        return (0.0, 1.0)
+    p = k / n
+    d = 1 + z * z / n
+    centre = (p + z * z / (2 * n)) / d
+    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+    return (max(0.0, centre - half), min(1.0, centre + half))
+
+
+def coverage(list_path: Path = LIST, hook: Path = HOOK):
+    ev = done_evidence(list_path)
+    guards = guard_files(hook)
+    covered = sorted(ev & guards)
+    return sorted(ev), sorted(guards), covered
+
+
+def main() -> int:
+    ev, guards, covered = coverage()
+    n, k = len(ev), len(covered)
+    lo, hi = wilson(k, n)
+    print(f"  DONE evidence files          : {n}")
+    print(f"  hook GUARDS files            : {len(guards)}")
+    print(f"  run at COMMIT time           : {k}")
+    # Lower bound rounded DOWN and upper bound UP, so the printed interval is
+    # never narrower than the computed one.
+    print(f"  commit-time coverage         : {k}/{n} = {k / n * 100:.2f}% "
+          f"Wilson [{math.floor(lo * 10000) / 100:.2f}%, "
+          f"{math.ceil(hi * 10000) / 100:.2f}%]"
+          if n else "  commit-time coverage         : no DONE evidence")
+    print(f"  NOT run at commit time       : {n - k}")
+    for f in covered:
+        print(f"      covered: {f}")
+    print("\n  V7 attributes failures it can SEE. At the moment a DONE marker is")
+    print("  written, it can see the files above and no others. For the rest the")
+    print("  V3 window -- a completion claim standing on a red file -- is open")
+    print("  until the full suite runs.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

