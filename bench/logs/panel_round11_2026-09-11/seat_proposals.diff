### cc2:bench/tests/test_declared_figure_coverage_2026-09-11.py
--- /dev/null	2026-09-11 01:12:10
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_jskuxiav/repo/bench/tests/test_declared_figure_coverage_2026-09-11.py	2026-09-11 01:03:48
@@ -0,0 +1,131 @@
+"""V6's gate can be satisfied without doing the thing it exists to enforce.
+
+WHAT V6 BUILT. `check_declared_figures` re-EXECUTES every `<!-- figure: ... -->`
+declaration and refuses the brief when the script does not print the declared
+value. That closes "a declared number is a claim about evidence, not evidence".
+
+WHAT IT DOES NOT CLOSE, demonstrated by execution 2026-09-11 (panel round 11).
+It never reads the PROSE. A brief may declare `gamma = 0.415413`, have it
+reproduce against a real script, and 2 lines below write "gamma is 0.451" --
+and the validator prints "carries all 7 required sections" and exits 0. That is
+the round-4 defect exactly, untouched, now with a green light on top of it:
+
+    $ python3 scripts/panel_brief_validate.py /tmp/v6/LIAR.md
+    panel-brief: LIAR.md carries all 7 required sections
+    exit=0
+
+Measured on the round-11 brief itself: 2 declared figures, 19 distinct numeric
+literals in the prose.
+
+THE ADDITION IS A REPORT, NOT A REFUSAL, and the precedent is `check_currency`
+in the same module: most numbers in a brief are quoted from a note rather than
+produced by a script, and refusing them would refuse every brief in the archive.
+This module's own words: "a guard that refuses a correct brief is bypassed,
+which costs more than the defect it caught."
+
+MUTATION-CHECKED 2026-09-11: deleting the `undeclared_figures` call from `main`
+takes `test_the_warning_is_wired_to_main_and_prints` RED and leaves the rest
+green; making `undeclared_figures` return `[]` unconditionally takes 3 RED.
+"""
+from __future__ import annotations
+
+import importlib.util
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+VALIDATE = ROOT / "scripts" / "panel_brief_validate.py"
+
+_spec = importlib.util.spec_from_file_location("pbv_cov", VALIDATE)
+pbv = importlib.util.module_from_spec(_spec)
+sys.modules["pbv_cov"] = pbv
+_spec.loader.exec_module(pbv)
+
+#: A brief body carrying all 7 required sections, so the coverage report is the
+#: only thing under test.
+BODY = """# Brief
+
+## Section 2 — what is measured
+The round-4 brief said gamma is 0.451, and it is 0.415413.
+Review `scripts/panel_brief_validate.py`. RUN it and execute the falsifier.
+severity and the two-sided gate apply. Provide a fix and test the fix with a
+runnable falsifier you have executed. Say what would refute you. Stop at
+diminishing returns; terminate then.
+
+## Output
+Return a verdict, your reasoning, a falsifier and any disagreement.
+"""
+
+
+def test_a_wrong_number_in_the_prose_is_named(tmp_path):
+    """THE LOAD-BEARING CASE. 0.451 is backed by nothing and must be said so."""
+    out = pbv.undeclared_figures(BODY)
+    assert "0.451" in out, (
+        f"the number that cost this project a panel round is not reported: {out}")
+    assert "0.415413" in out, out
+
+
+def test_a_declared_figure_is_not_reported(tmp_path):
+    """DISCRIMINATION. A report that names every number says nothing.
+
+    A brief that DOES declare its figure must not be nagged about it."""
+    declared = ("<!-- figure: gamma | scripts/x.py | gamma = 0.415413 -->\n"
+                + BODY.replace("is 0.451, and it", "is, and it"))
+    out = pbv.undeclared_figures(declared)
+    assert "0.415413" not in out, (
+        f"a declared and re-executed figure was reported as unbacked: {out}")
+
+
+def test_the_declaration_comment_itself_is_not_scanned(tmp_path):
+    """The value inside the declaration must not report itself as unbacked."""
+    text = "<!-- figure: r | scripts/x.py | rate = 12.75% -->\n\nNo other numbers here.\n"
+    assert pbv.undeclared_figures(text) == [], pbv.undeclared_figures(text)
+
+
+def test_trivia_is_out_of_scope(tmp_path):
+    """Section numbers, seat counts and small integers are not measurements.
+
+    Reporting them buries the ones that are, which is how a warning becomes
+    ignored -- this module's own stated failure mode."""
+    text = "Section 3 names 5 seats across 2 rounds, and 3 of 5 are paid.\n"
+    assert pbv.undeclared_figures(text) == [], pbv.undeclared_figures(text)
+
+
+def test_a_date_is_not_a_figure(tmp_path):
+    """`2026-09-10` must not be reported as an unbacked measurement."""
+    text = "Observed 2026-09-10 05:45 BST, in round 4.\n"
+    assert pbv.undeclared_figures(text) == [], pbv.undeclared_figures(text)
+
+
+def test_decimals_percentages_ratios_and_long_integers_are_all_seen(tmp_path):
+    text = "It moved 0.287, then 24.8%, over 12/13 cases and 2972 entries.\n"
+    got = pbv.undeclared_figures(text)
+    for want in ("0.287", "24.8%", "12/13", "2972"):
+        assert want in got, f"{want!r} missing from {got}"
+
+
+def test_the_warning_is_wired_to_main_and_prints(tmp_path):
+    """AN ADDITION NOTHING REACHES IS NOT ADDITIVE.
+
+    Run the real script end to end and require the warning on stderr, and
+    require it NOT to change the exit status -- it reports, it does not refuse.
+    """
+    b = tmp_path / "BRIEF.md"
+    b.write_text(BODY, encoding="utf-8")
+    r = subprocess.run([sys.executable, str(VALIDATE), str(b)], cwd=ROOT,
+                       capture_output=True, text=True, timeout=180)
+    assert "FIGURE COVERAGE" in r.stderr, (
+        f"the coverage report never reached a real run:\nSTDERR:\n{r.stderr}")
+    assert "0.451" in r.stderr, r.stderr
+    assert r.returncode == 0, (
+        f"the coverage report changed the exit status to {r.returncode}; it "
+        f"reports, it must not refuse:\n{r.stderr}")
+
+
+def test_quiet_suppresses_it_like_every_other_warning(tmp_path):
+    b = tmp_path / "BRIEF.md"
+    b.write_text(BODY, encoding="utf-8")
+    r = subprocess.run([sys.executable, str(VALIDATE), "--quiet", str(b)],
+                       cwd=ROOT, capture_output=True, text=True, timeout=180)
+    assert "FIGURE COVERAGE" not in r.stderr, r.stderr

### cc2:bench/tests/test_done_evidence_commit_coverage_2026-09-11.py
--- /dev/null	2026-09-11 01:12:10
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_jskuxiav/repo/bench/tests/test_done_evidence_commit_coverage_2026-09-11.py	2026-09-11 01:05:55
@@ -0,0 +1,124 @@
+"""V7's reporter can only speak about tests the run EXECUTED, and at commit
+time almost none of them are executed.
+
+WHAT V7 BUILT. `unsupported_done_entries` maps a session's failures back to the
+DONE entries that claim them, and `bench/tests/conftest.py` prints them in the
+terminal summary. It adds no test runs: it reads outcomes the session produced.
+
+WHY THAT LEAVES THE MEASURED HOLE OPEN. A DONE marker is written at a COMMIT.
+What runs at a commit is `hooks/pre-commit`'s GUARDS list. Measured 2026-09-11
+by `scripts/done_evidence_commit_coverage_2026-09-11.py`: 3 of 52 DONE evidence
+files, 5.77%, Wilson [1.98%, 15.65%]. For the other 49 the V3 window -- a
+completion claim standing on a wholly red file -- stays open until the full
+suite runs, which is the same 13 minutes in which V3 actually stood DONE on a
+10-of-10 RED file.
+
+THIS FILE DOES NOT CLOSE THE HOLE. It makes the figure MEASURED instead of
+typed, and pins the properties that let it go stale: the GUARDS list is read
+out of the hook, the evidence list out of the task list, and the Wilson bounds
+round OUTWARD. `hooks/pre-commit` has had 6 corrections to 1 typed figure, and
+the diagnosis each time was a number nobody was forced to refresh.
+
+MUTATION-CHECKED 2026-09-11: hard-coding `guard_files` to the literal 3-file set
+takes `test_the_guard_list_is_read_from_the_hook` RED; rounding the Wilson
+bounds inward takes `test_the_interval_rounds_outward` RED.
+"""
+from __future__ import annotations
+
+import importlib.util
+import math
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+SCRIPT = ROOT / "scripts" / "done_evidence_commit_coverage_2026-09-11.py"
+
+_spec = importlib.util.spec_from_file_location("dcc", SCRIPT)
+dcc = importlib.util.module_from_spec(_spec)
+sys.modules["dcc"] = dcc
+_spec.loader.exec_module(dcc)
+
+
+def test_the_guard_list_is_read_from_the_hook(tmp_path):
+    """A TYPED LIST IS THE DEFECT THIS SCRIPT EXISTS TO AVOID.
+
+    Point it at a fabricated hook and it must report THAT hook's files."""
+    hook = tmp_path / "pre-commit"
+    hook.write_text("python3 -m pytest bench/tests/test_invented_guard.py\n",
+                    encoding="utf-8")
+    got = dcc.guard_files(hook)
+    assert got == {"bench/tests/test_invented_guard.py"}, got
+    real = dcc.guard_files()
+    assert real and real != got, (
+        "the real hook and a fabricated one produce the same list, so the "
+        "function is not reading the file it is given")
+
+
+def test_a_missing_hook_is_empty_not_an_exception(tmp_path):
+    assert dcc.guard_files(tmp_path / "absent") == set()
+
+
+def test_the_evidence_list_is_read_from_the_task_list():
+    ev = dcc.done_evidence()
+    assert len(ev) >= 10, f"only {len(ev)} DONE evidence files — is the list intact?"
+    assert all(f.startswith("bench/") for f in ev), sorted(ev)
+
+
+def test_the_coverage_is_a_subset_and_the_gap_is_real():
+    """THE PROPERTY. The hook runs a MINORITY of DONE evidence.
+
+    If this ever fails because coverage reached 100%, the hole is closed and
+    this file should be retired with that measurement quoted."""
+    ev, guards, covered = dcc.coverage()
+    assert set(covered) <= set(ev), covered
+    assert set(covered) <= set(guards), covered
+    assert len(covered) < len(ev), (
+        "every DONE evidence file now runs at commit time; the V3 window is "
+        "closed and this measurement should be retired, not deleted silently")
+
+
+def test_the_interval_rounds_outward():
+    """A NARROWED INTERVAL IS A STRONGER CLAIM THAN THE DATA SUPPORTS.
+
+    `wilson_interval_consistency.py` caught a seat rounding a lower bound UP
+    inside this very repository. The printed bounds must contain the computed
+    ones."""
+    lo, hi = dcc.wilson(3, 52)
+    assert 0.0 < lo < 3 / 52 < hi < 1.0, (lo, hi)
+    printed_lo = math.floor(lo * 10000) / 100
+    printed_hi = math.ceil(hi * 10000) / 100
+    assert printed_lo <= lo * 100 and printed_hi >= hi * 100, (printed_lo, printed_hi)
+    out = subprocess.run([sys.executable, str(SCRIPT)], cwd=ROOT,
+                         capture_output=True, text=True, timeout=180).stdout
+    assert f"[{printed_lo:.2f}%, {printed_hi:.2f}%]" in out, out
+
+
+def test_wilson_agrees_with_an_independent_derivation():
+    """A SECOND TOOL, as the brief requires of any proportion.
+
+    The Wilson interval is the set of p for which the score statistic
+    |k/n - p| / sqrt(p(1-p)/n) <= z. Solved here by bisection on that
+    inequality rather than by the closed form the module uses, so the 2 routes
+    share no algebra."""
+    k, n, z = 3, 52, 1.959963985
+
+    def inside(p):
+        if p <= 0 or p >= 1:
+            return False
+        return abs(k / n - p) / math.sqrt(p * (1 - p) / n) <= z
+
+    lo, hi = dcc.wilson(k, n)
+    step = 1e-7
+    assert inside(lo + step) and not inside(lo - step), lo
+    assert inside(hi - step) and not inside(hi + step), hi
+
+
+def test_the_script_runs_and_names_the_open_window():
+    r = subprocess.run([sys.executable, str(SCRIPT)], cwd=ROOT,
+                       capture_output=True, text=True, timeout=180)
+    assert r.returncode == 0, r.stderr
+    assert "commit-time coverage" in r.stdout
+    assert "V3 window" in r.stdout, (
+        "the script reports a percentage without saying what it is the "
+        "percentage OF:\n" + r.stdout)

### cc2:bench/tests/test_verbatim_paragraph_numbering_2026-09-11.py
--- /dev/null	2026-09-11 01:12:10
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_jskuxiav/repo/bench/tests/test_verbatim_paragraph_numbering_2026-09-11.py	2026-09-11 01:01:53
@@ -0,0 +1,199 @@
+"""The verbatim exemption must be SCOPED, and until 2026-09-11 it was not.
+
+WHAT V8 CLAIMS. `scripts/note_vagueness_lint.py` exempts `<!-- verbatim-begin:
+... -->` / `<!-- verbatim-end -->` regions from the BLOCKING note-lint, and its
+own docstring states the scope: "Prose OUTSIDE the markers is linted normally,
+so a note cannot buy amnesty for its own writing by quoting someone."
+
+WHAT WAS TRUE. `sentences()` split paragraphs on the literal "\n\n".
+`verbatim_paragraphs()` split on the regex `\n\s*\n`. `verbatim_paragraphs`'
+docstring asserted the 2 numberings "agree by construction rather than by
+coincidence" -- an unexecuted claim about 2 hand-written expressions of one
+rule, which is the shape this project's `execute-do-not-grep` principle names.
+
+They disagree the moment a blank line carries whitespace. A single space on an
+otherwise blank line BEFORE the region advances the regex numbering by 1 against
+the literal numbering, so the exempt set names paragraph numbers that, in
+`sentences()` numbering, land AFTER `verbatim-end`. The note's own prose is then
+exempted, the counted total is 0, and the per-file commit ratchet passes.
+
+NOT ADVERSARIAL AND NOT HYPOTHETICAL. A whitespace-only line is what a terminal
+paste produces, and a verbatim record is made of terminal pastes. Measured
+2026-09-11: 20 of this tree's 730 `.md` files already split differently under
+the 2 rules.
+
+THE FIX is 1 splitter, `paragraphs()`, called by both. Adopting the regex form
+(a whitespace-only line IS a paragraph break) moves the sentence stream on 3 of
+730 files, 69443 -> 69453 sentences, all 3 archived logs that nothing gates.
+
+MUTATION-CHECKED, both directions, 2026-09-11, and the measurement CORRECTED
+the first draft of this sentence. Restoring `text.split("\n\n")` inside
+`sentences()` gives **3 failed, 4 passed**, not the 2 failures this docstring
+first claimed: `test_the_exemption_does_not_leak_past_verbatim_end`,
+`test_the_two_numberings_agree_on_a_whitespace_blank_line` and the structural
+`test_a_single_splitter_is_the_only_one` all go RED. The 4 that stay green --
+the exemption still working, the unbalanced-marker warning, its discrimination
+case, and the single-read -- are the additive half, and they are green under the
+mutation precisely because the mutation does not touch them.
+"""
+from __future__ import annotations
+
+import importlib.util
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+LINT = ROOT / "scripts" / "note_vagueness_lint.py"
+
+_spec = importlib.util.spec_from_file_location("nvl_pn", LINT)
+nvl = importlib.util.module_from_spec(_spec)
+sys.modules["nvl_pn"] = nvl
+_spec.loader.exec_module(nvl)
+
+#: A sentence the linter reliably flags under Rule 27.
+VIOLATION = "The panel returned twenty-nine findings in total."
+
+#: A blank line carrying ONE SPACE. This is the whole attack.
+DIRTY_BLANK = " \n"
+
+
+def _counted(out: str) -> int:
+    """The number the commit hook's per-file ratchet reads."""
+    m = re.findall(r"^\s*(\d+) finding\(s\)\. Reported", out, re.M)
+    assert m, f"no total line in:\n{out}"
+    return int(m[-1])
+
+
+def _run(path: Path) -> str:
+    r = subprocess.run([sys.executable, str(LINT), str(path)], cwd=ROOT,
+                       capture_output=True, text=True, timeout=180)
+    return r.stdout
+
+
+def _write(tmp_path: Path, body: str) -> Path:
+    f = tmp_path / "note.md"
+    f.write_text(body, encoding="utf-8")
+    return f
+
+
+#: The note's OWN prose, after a CLOSED region, with a dirty blank line before
+#: the region. Under the 2-splitter code this counted 0.
+AMNESTY_FIXTURE = (
+    "# Note\n"
+    "\n"
+    "Intro prose in the note's own voice, perfectly clean.\n"
+    + DIRTY_BLANK +
+    "<!-- verbatim-begin: someone else -->\n"
+    "\n"
+    "quoted prose from the seat.\n"
+    "\n"
+    "<!-- verbatim-end -->\n"
+    "\n"
+    + VIOLATION + "\n"
+)
+
+
+def test_the_exemption_does_not_leak_past_verbatim_end(tmp_path):
+    """THE LOAD-BEARING CASE. A violation in the note's own voice, written
+    AFTER `verbatim-end`, must be counted even when a blank line upstream
+    carries whitespace. Counting 0 here is the amnesty V8 says cannot happen."""
+    out = _run(_write(tmp_path, AMNESTY_FIXTURE))
+    assert _counted(out) >= 1, (
+        "a Rule 27 violation in the note's OWN prose, after the region closed, "
+        "was exempted. The verbatim exemption is not scoped:\n" + out)
+    assert "[verbatim]" not in out, (
+        "the note's own sentence was labelled as someone else's words:\n" + out)
+
+
+def test_the_two_numberings_agree_on_a_whitespace_blank_line(tmp_path):
+    """The property directly, with no subprocess in the way.
+
+    `verbatim_paragraphs()` returns numbers that index the SAME sequence
+    `sentences()` numbers. Asserted against a fixture that carries a dirty blank
+    line, because on a clean file the 2 splitters agree by accident."""
+    text = AMNESTY_FIXTURE
+    exempt = nvl.verbatim_paragraphs(text)
+    by_para = {}
+    for n, s in nvl.sentences(text):
+        by_para.setdefault(n, []).append(s)
+    leaked = [s for n in exempt for s in by_para.get(n, [])
+              if "twenty-nine" in s]
+    assert not leaked, (
+        f"sentences() puts {leaked} in a paragraph verbatim_paragraphs() calls "
+        f"exempt ({sorted(exempt)}); the 2 numberings index different things")
+    # And the quoted sentence IS inside the exempt set, so the fixture is live.
+    quoted = [s for n in exempt for s in by_para.get(n, [])
+              if "quoted prose" in s]
+    assert quoted, (
+        "the fixture no longer exempts anything, so the test above could pass "
+        "on a file where the mechanism is simply switched off")
+
+
+def test_a_single_splitter_is_the_only_one(tmp_path):
+    """2 representations of one truth with no comparator is how this happened.
+
+    Both functions must reach `paragraphs()`; neither may carry its own split."""
+    src = LINT.read_text(encoding="utf-8")
+    body = src.split("def paragraphs(", 1)[1]
+    assert 'text.split("\\n\\n")' not in body, (
+        "a literal paragraph split survives below paragraphs(); that is the "
+        "second representation again")
+    assert body.count('re.split(r"\\n\\s*\\n"') == 0, (
+        "a second regex paragraph split survives below paragraphs()")
+
+
+def test_the_exemption_still_works_with_a_dirty_blank_line_inside_it(tmp_path):
+    """THE ADDITIVE CHECK. The repair must not remove the capability.
+
+    A violation INSIDE a region whose own body carries a whitespace-only blank
+    line must still be exempt, or the fix has taken the feature away rather
+    than scoping it."""
+    body = ("# Note\n\nClean prose with 29 findings.\n\n"
+            "<!-- verbatim-begin: someone else -->\n\n"
+            "first quoted block.\n"
+            + DIRTY_BLANK +
+            f"{VIOLATION}\n\n<!-- verbatim-end -->\n")
+    out = _run(_write(tmp_path, body))
+    assert _counted(out) == 0, out
+    assert "[verbatim]" in out, out
+
+
+def test_an_unbalanced_marker_is_announced(tmp_path):
+    """An unclosed region exempts the rest of the file. It may not be silent.
+
+    The behaviour is UNCHANGED -- the count is still 0, deliberately, because a
+    truncated marker must not make a quoted violation count. What is added is
+    that the reader is told, on every file, rather than by one test pinned to
+    one named record."""
+    body = ("# Note\n\n<!-- verbatim-begin: someone else -->\n\n"
+            f"{VIOLATION}\n\nand more.\n")
+    out = _run(_write(tmp_path, body))
+    assert _counted(out) == 0, out
+    assert "UNBALANCED VERBATIM MARKERS: 1 begin, 0 end" in out, (
+        "an unclosed region exempted the rest of the file and said nothing:\n"
+        + out)
+
+
+def test_a_balanced_file_is_not_warned_about(tmp_path):
+    """DISCRIMINATION. A warning that fires on everything says nothing."""
+    body = ("# Note\n\n<!-- verbatim-begin: someone else -->\n\n"
+            "quoted prose.\n\n<!-- verbatim-end -->\n")
+    out = _run(_write(tmp_path, body))
+    assert "UNBALANCED" not in out, out
+
+
+def test_lint_accepts_the_text_the_exemption_was_computed_from(tmp_path):
+    """One read, not 2 with 2 different encodings.
+
+    `main` decoded the file as utf-8 for `verbatim_paragraphs` and with the
+    platform default for `lint`, so the exempt paragraph numbers came from a
+    possibly different decoding than the findings they suppress."""
+    f = _write(tmp_path, AMNESTY_FIXTURE)
+    assert nvl.lint(f, AMNESTY_FIXTURE) == nvl.lint(f), (
+        "lint(path, text) and lint(path) disagree on the same bytes")
+    src = LINT.read_text(encoding="utf-8")
+    main_body = src.split("def main(", 1)[1]
+    assert 'lint(p, body)' in main_body and 'verbatim_paragraphs(body)' in main_body, (
+        "main no longer lints and exempts the same in-memory text")

