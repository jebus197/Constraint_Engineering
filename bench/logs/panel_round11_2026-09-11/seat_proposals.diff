### fable:bench/tests/test_declared_identity_names_only_itself_2026-09-11.py
--- /dev/null	2026-09-11 01:12:20
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__mb7fh20/repo/bench/tests/test_declared_identity_names_only_itself_2026-09-11.py	2026-09-11 01:08:25
@@ -0,0 +1,55 @@
+"""`.zenodo.json` must name ONLY this project's repository, and nothing guards that.
+
+Panel round 11, fable seat, 2026-09-11. `declared_project_names` reads EVERY
+github-shaped `related_identifiers` entry out of `.zenodo.json` and its result
+becomes this project's identity: `foreign_repo_roots` will recognise an
+absolute path ending in ANY of those names as a checkout of THIS project, and
+the falsifier replay path will rebase it into the current tree.
+
+The module docstring asserts "`.zenodo.json` names its own repository and
+nothing else". True today -- 1 identifier, isSupplementTo, Constraint_Engineering
+-- but it is an INVARIANT WITH NO GUARD: adding a perfectly reasonable citation
+(`"relation": "cites"`, github.com/someone/OtherProject) would make
+/home/x/OtherProject read as this project's tree, silently. Demonstrated below
+with a synthetic file: 2 identifiers in, 2 identities out.
+
+This does NOT forbid editing `.zenodo.json`. It forces the edit to arrive with
+a decision about identity, instead of widening it as a side effect.
+"""
+from __future__ import annotations
+
+import json
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "bench"))
+from repo_paths import declared_project_names, foreign_repo_roots  # noqa: E402
+
+
+def test_the_declared_identity_is_exactly_this_repository():
+    names = declared_project_names(ROOT)
+    assert names == {"Constraint_Engineering"}, (
+        f"declared identity is {names}. Every github related_identifier in "
+        f".zenodo.json becomes a name the falsifier-replay rebase treats as "
+        f"THIS project. If an identifier was added deliberately (a rename, a "
+        f"mirror), update this test in the same commit and say why; if it is "
+        f"a citation, it does not belong in related_identifiers.")
+
+
+def test_a_second_identifier_widens_identity_and_that_is_why_the_pin_exists(tmp_path):
+    """The mechanism, executed: 2 identifiers in, 2 identities out."""
+    (tmp_path / ".zenodo.json").write_text(json.dumps({
+        "related_identifiers": [
+            {"identifier": "https://github.com/jebus197/Constraint_Engineering",
+             "relation": "isSupplementTo", "scheme": "url"},
+            {"identifier": "https://github.com/someone/OtherProject",
+             "relation": "cites", "scheme": "url"},
+        ]}), encoding="utf-8")
+    names = declared_project_names(tmp_path)
+    assert names == {"Constraint_Engineering", "OtherProject"}, names
+    # and the widened identity IS what the rebase consumes:
+    roots = foreign_repo_roots("/home/x/OtherProject/bench/a.py", tmp_path)
+    assert "/home/x/OtherProject" in roots, (
+        "if this stops holding, the widening became harmless and the pin "
+        "above may be relaxed with evidence")

