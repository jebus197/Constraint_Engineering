+        f = tmp_path / "note.md"
+        f.write_text(
+            "# Note\n\n<!-- verbatim-begin: seat -->\n\n"
+            "```\nquoted code the seat wrote\n\n"
+            "<!-- verbatim-end -->\n\n"
+            f"{VIOLATION}\n", encoding="utf-8")
