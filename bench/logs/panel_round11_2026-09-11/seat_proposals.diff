+    def test_the_numbering_functions_are_the_same_split(self):
+        """The structural property: one split function, both consumers."""
+        text = "a\n \nb\n\nc"
+        assert nvl.paragraphs(text) == ["a", "b", "c"]
+        # sentences() must consume the identical split: a sentence in the
+        # third paragraph must report paragraph 3, not 2.
+        long = ("first paragraph has five words here.\n \n"
+                "second paragraph also has five words.\n\n"
+                "third paragraph carries five words too.")
+        nums = [n for n, _ in nvl.sentences(long)]
+        assert nums == [1, 2, 3], nums
