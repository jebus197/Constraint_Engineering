--- /dev/null	2026-09-11 01:12:20
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__mb7fh20/repo/bench/tests/test_verbatim_scoping_cannot_be_bought_2026-09-11.py	2026-09-11 01:05:35
@@ -0,0 +1,128 @@
+"""The verbatim exemption must not be purchasable for a note's OWN prose.
+
+Panel round 11, fable seat, 2026-09-11. Two demonstrated-by-execution routes
+bought amnesty for prose OUTSIDE the markers, and both are closed here:
+
+1. A blank line CARRYING A SPACE. `sentences()` split paragraphs on the
+   literal "\n\n"; `verbatim_paragraphs` split on r"\n\s*\n". The 2 numbering
+   schemes disagreed from the first whitespace-bearing blank line onward, and a
+   Rule 27 violation in the note's own prose after a CLOSED region was
+   numbered into the exempt set: measured before the fix, it counted 0.
+
+2. A MARKER INSIDE A CODE FENCE. A note documenting the syntax -- a ```
+   block containing `<!-- verbatim-begin: example -->` -- opened a real
+   region, and the note's own prose after the fence counted 0. `sentences()`
+   already refuses to lint fenced paragraphs; the marker scan ignored fences.
+
+Both are the exact failure the exemption's own docstring forswears: "a note
+cannot buy amnesty for its own writing by quoting someone".
+"""
+from __future__ import annotations
+
+import importlib.util
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+LINT = ROOT / "scripts" / "note_vagueness_lint.py"
+
+_spec = importlib.util.spec_from_file_location("nvl_scoping", LINT)
+nvl = importlib.util.module_from_spec(_spec)
+sys.modules["nvl_scoping"] = nvl
+_spec.loader.exec_module(nvl)
+
+#: A sentence the linter reliably counts: a compound spelled number, Rule 27.
+VIOLATION = "The panel returned twenty-nine findings in total."
+
+
+def _run(path: Path):
+    return subprocess.run([sys.executable, str(LINT), str(path)],
+                          cwd=ROOT, capture_output=True, text=True, timeout=180)
+
+
+def _counted(out: str) -> int:
+    m = re.findall(r"^\s*(\d+) finding\(s\)\. Reported", out, re.M)
+    assert m, f"no total line in:\n{out}"
+    return int(m[-1])
+
+
+class TestTheWhitespaceBlankLineCannotShiftTheNumbering:
+    def test_own_prose_after_a_space_bearing_blank_line_is_counted(self, tmp_path):
+        """The a1 attack: '\\n \\n' between the end marker and own prose.
+
+        Before the fix this counted 0: the exempt set was numbered by
+        r"\\n\\s*\\n" while findings were numbered by "\\n\\n", and the note's
+        own violation landed on an exempt number.
+        """
+        f = tmp_path / "note.md"
+        f.write_bytes(
+            b"# Note\n\n<!-- verbatim-begin: seat -->\n\nquoted prose here.\n\n"
+            b"<!-- verbatim-end -->\n \n"
+            + VIOLATION.encode() + b"\n")
+        assert _counted(_run(f).stdout) >= 1, (
+            "a whitespace-bearing blank line bought amnesty for the note's "
