+class TestAFencedMarkerIsTextNotAMarker:
+    def test_documenting_the_syntax_does_not_open_a_region(self, tmp_path):
+        """The a3 attack: a ``` block quoting the begin marker."""
+        f = tmp_path / "note.md"
+        f.write_text(
+            "# Note\n\n```\n<!-- verbatim-begin: example -->\n```\n\n"
+            f"{VIOLATION}\n", encoding="utf-8")
+        out = _run(f).stdout
+        assert _counted(out) >= 1, (
+            "a marker inside a code fence opened a real region and exempted "
+            "the note's own prose")
+        assert "[verbatim]" not in out
