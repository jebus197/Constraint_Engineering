    reverse_comps = re.findall(
        r'([-+]?\d*\.?\d+)\s*(>=|<=|>|<|==|!=)\s*(\w+)', claim
    )
    # Swap to normalise: var op value
    comparisons.extend([(c[2], _flip_op(c[1]), c[0]) for c in reverse_comps])

