      "DESCRIPTION": "FIND: bench/verification_chain.py, `_verify_epoch()`. Epoch metadata fields are not validated for internal consistency beyond `record_count <= len(self._records)` and `merkle_root` equality. In particular, `epoch_index` and `sealed_at` are effectively ignored; malformed or reordered epoch objects can still verify if their `record_count`/`merkle_root` pair matches some prefix. Evidence: `_verify_epoch()` never checks that `epoch['epoch_index']` matches position in `self._epochs`, never normalizes `sealed_at`, and `verify_chain()` iterates `for epoch in self._epochs:` without positional validation.",
      "PROPOSED_FIX": "FIX: validate epoch ordering and timestamp format by passing expected position into `_verify_epoch()`.\n\n<<<<\n        # Verify epochs if any exist\n        for epoch in self._epochs:\n            try:\n                ok, msg = self._verify_epoch(epoch)\n            except (KeyError, TypeError, ValueError) as exc:\n                ok, msg = False, f\"malformed epoch: {exc}\"\n            if not ok:\n                errors.append(\n                    f\"Epoch {epoch.get('epoch_index', '?')}: {msg}\"\n                )\n====\n        # Verify epochs if any exist\n        for expected_epoch_index, epoch in enumerate(self._epochs):\n            try:\n                ok, msg = self._verify_epoch(epoch, expected_epoch_index)\n            except (KeyError, TypeError, ValueError) as exc:\n                ok, msg = False, f\"malformed epoch: {exc}\"\n            if not ok:\n                errors.append(\n                    f\"Epoch {epoch.get('epoch_index', '?')}: {msg}\"\n                )\n>>>>\n\n<<<<\n    def _verify_epoch(self, epoch: dict) -> tuple[bool, str]:\n        \"\"\"Verify a stored epoch's Merkle root against the chain records.\"\"\"\n        record_count = epoch.get(\"record_count\", 0)\n        if record_count > len(self._records):\n            return False, (\n                f\"epoch claims {record_count} records but chain has \"\n                f\"{len(self._records)}\"\n            )\n        leaves = [\n            _digest_bytes(r[\"chain_hash\"])\n            for r in self._records[:record_count]\n        ]\n        expected_root = \"sha256:\" + rfc9162_merkle_root(leaves).hex()\n        stored_root = epoch.get(\"merkle_root\", \"\")\n        if stored_root != expected_root:\n            return False, (\n                f\"merkle_root mismatch: stored {stored_root}, \"\n                f\"computed {expected_root}\"\n            )\n        return True, \"OK\"\n====\n    def _verify_epoch(self, epoch: dict, expected_epoch_index: int) -> tuple[bool, str]:\n        \"\"\"Verify a stored epoch's metadata and Merkle root against the chain records.\"\"\"\n        if epoch.get(\"epoch_index\") != expected_epoch_index:\n            return False, (\n                f\"epoch_index mismatch: stored {epoch.get('epoch_index')}, \"\n                f\"expected {expected_epoch_index}\"\n            )\n\n        sealed_at = epoch.get(\"sealed_at\")\n        if not isinstance(sealed_at, str):\n            return False, f\"sealed_at must be a string, got {type(sealed_at).__name__}\"\n        try:\n            _normalize_timestamp(sealed_at)\n        except ValueError as exc:\n            return False, f\"invalid sealed_at timestamp: {exc}\"\n\n        record_count = epoch.get(\"record_count\", 0)\n        if not isinstance(record_count, int) or record_count < 1:\n            return False, f\"invalid record_count: {record_count!r}\"\n        if record_count > len(self._records):\n            return False, (\n                f\"epoch claims {record_count} records but chain has \"\n                f\"{len(self._records)}\"\n            )\n        leaves = [\n            _digest_bytes(r[\"chain_hash\"])\n            for r in self._records[:record_count]\n        ]\n        expected_root = \"sha256:\" + rfc9162_merkle_root(leaves).hex()\n        stored_root = epoch.get(\"merkle_root\", \"\")\n        if stored_root != expected_root:\n            return False, (\n                f\"merkle_root mismatch: stored {stored_root}, \"\n                f\"computed {expected_root}\"\n            )\n        return True, \"OK\"\n>>>>",
