    "PROPOSED_FIX": "FIX: verify epoch ordering and uniqueness in `verify_chain()` before per-epoch root verification. Exact replacement:\n<<<<\n        # Verify epochs if any exist\n        for epoch in self._epochs:\n            try:\n                ok, msg = self._verify_epoch(epoch)\n            except (KeyError, TypeError, ValueError) as exc:\n                ok, msg = False, f\"malformed epoch: {exc}\"\n            if not ok:\n                errors.append(\n                    f\"Epoch {epoch.get('epoch_index', '?')}: {msg}\"\n                )\n====\n        # Verify epoch ledger structure and contents if any exist\n        for expected_idx, epoch in enumerate(self._epochs):\n            actual_idx = epoch.get(\"epoch_index\")\n            if actual_idx != expected_idx:\n                errors.append(\n                    f\"Epoch {actual_idx if actual_idx is not None else '?'}: \"\n                    f\"epoch_index mismatch, expected {expected_idx}\"\n                )\n                continue\n            try:\n                ok, msg = self._verify_epoch(epoch)\n            except (KeyError, TypeError, ValueError) as exc:\n                ok, msg = False, f\"malformed epoch: {exc}\"\n            if not ok:\n                errors.append(f\"Epoch {actual_idx}: {msg}\")\n>>>>",
