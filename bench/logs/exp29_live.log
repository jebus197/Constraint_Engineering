====
        # Line exists — perform basic content sanity check
        line_text = lines[cited_line - 1].lower()
        # Extract alphanumeric tokens from the finding description (ignore common words)
        import re
        words = set(re.findall(r'\b[a-z]{4,}\b', f.description.lower()))
        common = {'this', 'that', 'the', 'and', 'for', 'with', 'from', 'have', 'were', 'which'}
        words = words - common
        matched = any(w in line_text for w in words) if words else True
        if matched:
