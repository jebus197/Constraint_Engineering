    "PROPOSED_FIX": "FIX: add epoch selection and default to the earliest sealed epoch containing the record.\n<<<<\n    def build_inclusion_proof(self, index: int) -> dict:\n        \"\"\"Build an RFC 9162 inclusion proof for the record at `index`.\"\"\"\n        if not (0 <= index < len(self._records)):\n            raise IndexError(\n                f\"Index {index} out of range [0, {len(self._records)})\"\n            )\n        leaves = [_digest_bytes(r[\"chain_hash\"]) for r in self._records]\n        proof_steps = rfc9162_inclusion_proof(leaves, index)\n        root = rfc9162_merkle_root(leaves)\n        return {\n            \"index\": index,\n            \"chain_hash\": self._records[index][\"chain_hash\"],\n            \"proof\": proof_steps,\n            \"merkle_root\": \"sha256:\" + root.hex(),\n        }\n====\n    def build_inclusion_proof(\n        self,\n        index: int,\n        epoch_index: Optional[int] = None,\n    ) -> dict:\n        \"\"\"Build an RFC 9162 inclusion proof for the record at `index`.\n\n        If epoch_index is provided, the proof is built against that sealed\n        epoch. Otherwise, the earliest sealed epoch containing the record is\n        used; if no epoch exists, the proof is built against the current\n        unsealed chain state.\n        \"\"\"\n        if not (0 <= index < len(self._records)):\n            raise IndexError(\n                f\"Index {index} out of range [0, {len(self._records)})\"\n            )\n\n        selected_epoch: Optional[dict] = None\n        if epoch_index is not None:\n            if not (0 <= epoch_index < len(self._epochs)):\n                raise IndexError(\n                    f\"Epoch index {epoch_index} out of range [0, {len(self._epochs)})\"\n                )\n            selected_epoch = self._epochs[epoch_index]\n            if index >= selected_epoch[\"record_count\"]:\n                raise ValueError(\n                    f\"Record {index} is not included in epoch {epoch_index}\"\n                )\n        else:\n            for epoch in self._epochs:\n                if index < epoch[\"record_count\"]:\n                    selected_epoch = epoch\n                    break\n\n        record_count = (\n            selected_epoch[\"record_count\"] if selected_epoch is not None\n            else len(self._records)\n        )\n        leaves = [_digest_bytes(r[\"chain_hash\"]) for r in self._records[:record_count]]\n        proof_steps = rfc9162_inclusion_proof(leaves, index)\n        root = rfc9162_merkle_root(leaves)\n        return {\n            \"index\": index,\n            \"epoch_index\": selected_epoch[\"epoch_index\"] if selected_epoch is not None else None,\n            \"record_count\": record_count,\n            \"chain_hash\": self._records[index][\"chain_hash\"],\n            \"proof\": proof_steps,\n            \"merkle_root\": \"sha256:\" + root.hex(),\n        }\n>>>>",
