      "FIX": "<<<<\n    timings: Dict[str, float] = {}\n    tool_usage: Dict[str, int] = {}\n====\n    timings: Dict[str, float] = {}\n    tool_usage: Dict[str, int] = {}\n\n    # Enforce batch-level finding_id uniqueness: downstream structures key on ID\n    seen_ids: Set[str] = set()\n    dup_ids: Set[str] = set()\n    for f in new_findings:\n        if f.finding_id in seen_ids:\n            dup_ids.add(f.finding_id)\n        seen_ids.add(f.finding_id)\n    if dup_ids:\n        raise ValueError(\n            \"Duplicate finding_id values in run_immune_pipeline input: \"\n            + \", \".join(sorted(dup_ids))\n        )\n>>>>",
