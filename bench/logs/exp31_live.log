    "FIX": "<<<<\ndef _verify_search_manifest(\n    manifest: List[Dict[str, Any]],\n    source_paths: List[str],\n) -> Tuple[int, int, List[str]]:\n    \"\"\"Mechanically verify the CT v2 search manifest.\n\n    Checks that the agent's claimed searches could actually have been\n    performed (files exist, grep patterns are valid).\n\n    Returns:\n        (verified_count, total_count, issues)\n    \"\"\"\n    verified = 0\n    issues: List[str] = []\n    source_set = set(str(p) for p in source_paths)\n    source_basenames = {os.path.basename(str(p)): str(p) for p in source_paths}\n\n    for step in manifest:\n        tool = step.get(\"tool\", \"\")\n        args = step.get(\"args\", \"\")\n\n        if tool in (\"Read\", \"read\", \"cat\"):\n            # Check file exists\n            file_arg = args if isinstance(args, str) else str(args)\n            # Try exact, then basename\n            exists = (\n                os.path.isfile(file_arg)\n                or file_arg in source_set\n                or os.path.basename(file_arg) in source_basenames\n            )\n            if exists:\n                verified += 1\n            else:\n                issues.append(f\"File not found: {file_arg}\")\n\n        elif tool in (\"Grep\", \"grep\", \"rg\"):\n            # Check pattern is valid regex\n            pattern = args if isinstance(args, str) else str(args)\n            try:\n                re.compile(pattern)\n                verified += 1  # Pattern is at least syntactically valid\n            except re.error:\n                issues.append(f\"Invalid grep pattern: {pattern}\")\n\n        elif tool in (\"Glob\", \"glob\"):\n            verified += 1  # Glob patterns are hard to invalidate\n\n        else:\n            issues.append(f\"Unknown tool: {tool}\")\n\n    return verified, len(manifest), issues\n====\ndef _verify_search_manifest(\n    manifest: List[Dict[str, Any]],\n    source_paths: List[str],\n) -> Tuple[int, int, List[str]]:\n    \"\"\"Mechanically verify the CT v2 search manifest.\n\n    Checks that the agent's claimed searches are syntactically valid AND\n    scoped to the reviewed source tree.\n\n    Returns:\n        (verified_count, total_count, issues)\n    \"\"\"\n    verified = 0\n    issues: List[str] = []\n    source_abs = [os.path.realpath(str(p)) for p in source_paths]\n    source_set = set(source_abs)\n    allowed_dirs = {os.path.dirname(p) for p in source_abs}\n    source_basenames = {os.path.basename(p): p for p in source_abs}\n\n    def _resolve_manifest_path(raw: str) -> Optional[str]:\n        if not raw:\n            return None\n        raw = raw.strip().strip(\"\\\"'\")\n        real = os.path.realpath(raw)\n        if real in source_set:\n            return real\n        bn = os.path.basename(raw)\n        if bn in source_basenames:\n            return source_basenames[bn]\n        for sp in source_abs:\n            if sp.endswith(raw):\n                return sp\n        return None\n\n    def _extract_path_tokens(raw_args: Any) -> List[str]:\n        text = raw_args if isinstance(raw_args, str) else json.dumps(raw_args, sort_keys=True)\n        candidates = re.findall(r'(?:[\\w./-]+\\.[\\w]+|[\\w./-]+/)', text)\n        return [c for c in candidates if c not in ('Read', 'Grep', 'Glob', 'rg', 'grep', 'cat')]\n\n    for step in manifest:\n        if not isinstance(step, dict):\n            issues.append(f\"Malformed manifest step: {type(step).__name__}\")\n            continue\n\n        tool = str(step.get(\"tool\", \"\"))\n        args = step.get(\"args\", \"\")\n\n        if tool in (\"Read\", \"read\", \"cat\"):\n            file_arg = args if isinstance(args, str) else str(args)\n            resolved = _resolve_manifest_path(file_arg)\n            if resolved and os.path.isfile(resolved):\n                verified += 1\n            else:\n                issues.append(f\"Read target not in reviewed sources: {file_arg}\")\n\n        elif tool in (\"Grep\", \"grep\", \"rg\"):\n            pattern = args if isinstance(args, str) else json.dumps(args, sort_keys=True)\n            try:\n                re.compile(pattern)\n            except re.error:\n                issues.append(f\"Invalid grep pattern: {pattern}\")\n                continue\n\n            path_tokens = _extract_path_tokens(args)\n            resolved_paths = [_resolve_manifest_path(tok) for tok in path_tokens]\n            if any(rp is not None for rp in resolved_paths):\n                verified += 1\n            else:\n                issues.append(f\"Grep step not scoped to reviewed sources: {pattern}\")\n\n        elif tool in (\"Glob\", \"glob\"):\n            path_tokens = _extract_path_tokens(args)\n            resolved_paths = [_resolve_manifest_path(tok.rstrip(\"/\")) for tok in path_tokens]\n            if any(rp is not None for rp in resolved_paths):\n                verified += 1\n            elif any(os.path.realpath(tok.rstrip(\"/\")) in allowed_dirs for tok in path_tokens):\n                verified += 1\n            else:\n                issues.append(f\"Glob step not scoped to reviewed sources: {args}\")\n\n        else:\n            issues.append(f\"Unknown tool: {tool}\")\n\n    return verified, len(manifest), issues\n>>>>",
