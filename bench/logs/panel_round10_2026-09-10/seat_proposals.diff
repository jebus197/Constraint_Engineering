### bench/tests/test_rebase_no_dotdot_escape_2026-09-10.py
--- /dev/null	2026-09-10 23:58:12
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_mtu3ds_i/repo/bench/tests/test_rebase_no_dotdot_escape_2026-09-10.py	2026-09-10 23:55:37
@@ -0,0 +1,60 @@
+"""The A2 rebase (`_retarget_falsifier`) must not launder a `..`-traversal escape.
+
+FOUND round 10, 2026-09-10. `foreign_repo_roots` recognises an archived
+falsifier's foreign checkout path and `_retarget_falsifier` rebases it onto the
+overlay. A naive string replace turned
+`/Users/x/Constraint_Engineering/../../../etc/passwd` into
+`<overlay>/../../../etc/passwd`, which normpath-resolves OUTSIDE the overlay.
+The pre-rebase form is caught by `scan_falsifier_source` (it begins `/Users/`);
+the rewritten form is not, and the runtime observer is default-allow for /etc,
+so the read of /etc/passwd succeeded end to end.
+
+THE FIX. `_retarget_falsifier` refuses to rewrite an occurrence immediately
+followed by `/..`, leaving the stale `/Users/` prefix so the static guard
+refuses it to a human (fail-closed). Benign occurrences retarget as before.
+"""
+from __future__ import annotations
+
+import os
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+from bench.reference_runner_v3 import _retarget_falsifier  # noqa: E402
+from bench.falsifier_verify import execute_python, scan_falsifier_source  # noqa: E402
+from bench.repo_paths import project_names  # noqa: E402
+
+REPO = ROOT
+OVERLAY = Path(tempfile.mkdtemp(prefix="cdsfl_rebase_test_"))
+NAME = sorted(project_names(REPO)[0], key=len, reverse=True)[0]  # the project name
+
+
+def test_dotdot_escape_is_not_laundered_into_the_overlay():
+    src = f'open("/Users/a/{NAME}/../../../../../../etc/passwd").read()'
+    out, _ = _retarget_falsifier(src, REPO, OVERLAY)
+    # The rewritten string must NOT begin the path with the overlay root, because
+    # that is exactly the laundered escape. The stale /Users/ prefix must remain.
+    assert f"{OVERLAY}/.." not in out, f"escape was laundered: {out}"
+    assert f"/Users/a/{NAME}/.." in out, f"stale prefix was stripped: {out}"
+
+
+def test_the_laundered_form_would_have_read_etc_passwd():
+    """Proves the static guard now refuses the retargeted escape end to end."""
+    src = (f'\ntry:\n'
+           f'    d=open("/Users/a/{NAME}/../../../../../../etc/passwd").read()\n'
+           f'    print("READ", len(d)); print("FALSIFIED")\n'
+           f'except Exception as e:\n'
+           f'    print("BLOCKED", type(e).__name__)\n')
+    out, _ = _retarget_falsifier(src, REPO, OVERLAY)
+    res = execute_python(out, repo_root=str(OVERLAY), cwd=str(OVERLAY))
+    assert "INTEGRITY VIOLATION" in res, f"escape was NOT refused: {res[:200]}"
+    assert "FALSIFIED" not in res, f"escape actually read the file: {res[:200]}"
+
+
+def test_a_benign_project_path_is_still_retargeted():
+    src = f'open("/Users/a/{NAME}/bench/x.md")'
+    out, n = _retarget_falsifier(src, REPO, OVERLAY)
+    assert out == f'open("{OVERLAY}/bench/x.md")', out
+    assert n == 1, n

