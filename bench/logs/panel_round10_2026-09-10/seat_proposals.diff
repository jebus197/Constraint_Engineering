@@ -0,0 +1,82 @@
+"""The financial-safety invariant "no paid seat was dispatched under Section P"
+must be checked at ANY n >= 1, never gated behind the statistical >= 10 population.
+
+WHY THIS TEST EXISTS (task A2, round 10, 2026-09-10). The round-10 panel found
+that `test_zero_paid_replies_in_any_round_under_section_p` gated its paid-seat
+check behind `corpus.shortfall(len, 10)`. That threshold is correct for the
+STATISTICAL claim (">= 10 replies to conclude from") but wrong for a per-record
+SAFETY boolean: a paid seat among 3 replies is a real violation regardless of
+sample size, yet the gate skipped it. A skip that fires when the test COULD have
+run is a deleted test -- here, deleted for every checkout holding 1-9 replies.
+
+This test drives the REAL test method with a fabricated 3-reply corpus, one of
+which is on a paid route, and asserts the method CATCHES it (AssertionError)
+rather than skipping. Against the gated form it raises Skipped and this test
+fails; against the fixed form it raises AssertionError and this test passes.
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+TARGET = ROOT / "bench" / "tests" / "test_panel_conditions_are_met_2026-09-10.py"
+
+
+def _load():
+    sys.path.insert(0, str(ROOT))
+    spec = importlib.util.spec_from_file_location("tpc_under_test", TARGET)
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    return m
+
+
+def _run_paid_check(m, replies):
+    """Return 'CAUGHT', 'SKIPPED', or 'PASSED' for the paid-seat method."""
+    orig = m._replies
+    m._replies = lambda: replies
+    try:
+        m.TestP1NoPaidSeatWasEverDispatchedUnderTheRuling() \
+            .test_zero_paid_replies_in_any_round_under_section_p()
+        return "PASSED"
+    except AssertionError:
+        return "CAUGHT"
+    except BaseException as e:  # noqa: BLE001
+        if type(e).__name__ == "Skipped":
+            return "SKIPPED"
+        raise
+    finally:
+        m._replies = orig
+
+
+PAID = ("panel_2026-09-02_r2", {"route": "anthropic_api", "model": "PAID-b"})
+FREE_A = ("panel_2026-09-01_r1", {"route": "claude_cli", "model": "free-a"})
+FREE_C = ("panel_2026-09-03_r3", {"route": "claude_cli", "model": "free-c"})
+
+
+def test_a_paid_seat_among_few_replies_is_caught_not_skipped():
+    m = _load()
+    # Three replies under the ruling, one paid: below the statistical threshold
+    # of 10, but a paid seat is a violation at any n. It must be CAUGHT.
+    assert _run_paid_check(m, [FREE_A, PAID, FREE_C]) == "CAUGHT"
+
+
+def test_a_single_paid_seat_is_caught():
+    m = _load()
+    assert _run_paid_check(m, [PAID]) == "CAUGHT"
+
+
+def test_empty_corpus_passes_trivially_not_by_skipping():
+    m = _load()
+    # n == 0: no paid seat can exist, so the invariant holds. It must PASS
+    # (vacuously true), and the "too few to conclude" reporting is the separate
+    # sibling test's job -- this one is the safety boolean.
+    assert _run_paid_check(m, []) == "PASSED"
+
+
+def test_all_free_seats_pass():
+    m = _load()
+    assert _run_paid_check(m, [FREE_A, FREE_C]) == "PASSED"

