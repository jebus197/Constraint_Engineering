            # AW-1 fix (Run 5, SymPy-verified): decay direction was inverted.
            # resolved → WIDEN window (less sensitive): use decay^(-resolved)
            decay_factor = self._sensitivity_decay ** (-resolved)
            growth_factor = self._sensitivity_growth ** persistent
            eff = int(round(base_window * decay_factor * growth_factor))
            return max(1, eff)

        # 1. kappa stuck at 0.0 for N consecutive rounds
        kappa_window = effective_window("kappa", self._stuck_window)
        if len(self._kappa_history) >= kappa_window:
            recent_kappa = self._kappa_history[-kappa_window:]
            if all(k == 0.0 for k in recent_kappa):
                new_diagnoses.append(DetectorDiagnosis(
                    detector="kappa",
                    pathology="kappa stuck at 0.0 for {} rounds".format(kappa_window),
