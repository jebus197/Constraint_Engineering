{
    "_comment": "39-E: Statistics Specialist. statsmodels/scipy.stats tool access for convergence analysis.",
    "test_article": "docs/MATHEMATICAL_APPENDIX.md",
    "context_files": [
        "bench/reference_runner.py",
        "bench/runner_core.py",
        "bench/immune_agents.py"
    ],
    "topology": "star",
    "pattern": "four_layer",
    "max_rounds": 12,
    "extension_cap": 15,
    "wall_clock_cap_s": 10800,
    "earliest_stop_round": 4,
    "models": ["CC2", "Codex", "Gemini", "DeepSeek", "ChatGPT"],
    "experiment_name": "exp39_E_statistics",
    "domain": "statistics",
    "rho_threshold": 0.25,
    "rho_rolling_window": 3,
    "consecutive_rounds_required": 2,
    "sk_enabled": true,
    "test_cmd": null,
    "sk_s_floor": 0.0,
    "burst_mode": "auto",

    "_specialist_cell": {
        "type": "statistics",
        "tools": ["statsmodels", "scipy.stats", "numpy", "pandas"],
        "toml_config": "bench/cdsfl_registry/domains/statistics.toml",
        "immune_config": "bench/cdsfl_registry/domains/immune/statistics.toml"
    },

    "_convergence_criteria": {
        "description": "Converges when: statistical method proposals stabilize, verified by tool execution.",
        "primary": "gamma >= 0.40 AND 2 consecutive rounds with 0 novel statistical findings",
        "secondary": "3+ consecutive rounds with no new convergence metric proposed",
        "fail_condition": "Wall clock cap without any statsmodels-verified convergence analysis"
    },

    "_artifact_schema": {
        "output_file": "exp39_E_statistics_report.json",
        "required_fields": [
            "convergence_metric_proposals",
            "statsmodels_verification_count",
            "scipy_test_count",
            "gamma_trajectory",
            "rho_trajectory",
            "specialist_cell_findings_vs_generic"
        ]
    }
}
