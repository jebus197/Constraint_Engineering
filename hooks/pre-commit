#!/bin/sh
# CDSFL pre-commit guard. Refuses a commit when the cheap correctness guards are red.
#
# WHY THIS EXISTS, with the evidence rather than the intention.
# A commit-time guard was discussed on 5 occasions between 2026-08-25 and
# 2026-09-07 and was never built. On 2026-09-09 at 08:16:17 commit 57d5a0e reached
# HEAD with the full suite red at 5 failures, every one of them self-inflicted the
# previous evening: a memory file was written and `sv` -- which DERIVES the file
# ledger -- was never run. The tracker had recorded the remedy the same evening,
# in these words: "No mechanism is missing; the remedy is ordering." Ordering by
# discipline failed within the hour. This is the mechanism.
#
# WHY ONLY A HANDFUL OF FILES. Measured on this machine over 3 runs:
# 178 tests in 6.53 s to 7.10 s, against 669.92 s for the full suite.
# RE-MEASURED 2026-09-10 14:50 BST by scripts/precommit_gate_cost_2026-09-10.py,
# which reads this GUARDS list rather than carrying its own copy. The figure has
# now been wrong 4 times by being typed and carried forward; it is measured.
# (Was 56 tests in 1.00 to 2.02 s with 4 guards; 2 more were added
# 2026-09-10 on cc2's finding F5 and the figure is re-measured, not
# carried forward — a stale cost figure in a guard about stale claims
# would be its own joke.) A per-commit gate costing 11 minutes
# would be bypassed within a day, and a guard that gets bypassed is not a guard.
# The first 4 of these 7 files are precisely the ones that caught the
# 2026-09-09 breakage after the fact, so they are the ones that would have caught
# it before. The header said "these 4 files" until 2026-09-10 while the list held
# 7, which is the same stale-count defect the guard exists to catch.
#
# WHY IT FAILS CLOSED WHEN IT CANNOT RUN. This project's own record names "a guard
# that cannot fail is not a guard" and lists 3 instances in a single night. A hook
# that exits 0 because python was missing is that defect. So an infrastructure
# fault blocks too, loudly, and the escape hatch is explicit and deliberate:
#
#     git commit --no-verify
#
# Using it is a decision, not an accident, and that is the whole point.

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-commit: cannot find the repository root. Refusing." >&2
    exit 1
}
cd "$REPO" || exit 1

# THE 6th AND 7th GUARDS, added 2026-09-10 on cc2's finding F5 — "the cheapest
# fix, largest effect". A commit is the exact moment a DONE marker is written,
# and the guard that checks DONE markers was collected only by the full suite,
# 13 minutes away. The hook's own header records the ruling this repeated:
# "The failure was never the absence of a rule or a checker; it was never
# running the checker."
#
# COST, MEASURED by cc2 under sh over 3 runs each: 4 guards 0.99/0.89/0.87 s,
# 6 guards 1.50/1.39/1.56 s. About +0.5 s against this hook's own stated budget
# of 1.00 to 2.02 s. The marker engine's own test comes too, which closes the
# deleted-marker case at commit time as well.
# THE 8th GUARD, added 2026-09-10 15:20 BST. `wilson_interval_consistency.py`
# caught 2 of this session's own errors within one hour -- a brief stating the
# 8-case interval against the 7-case count, and a panel seat rounding a lower
# bound UP, which narrows an interval into a stronger claim than the data
# supports. Both were caught only by the FULL suite, 14 minutes away, and an
# audit that morning had named exactly this gap: the hook does not run the test
# that is red, so a code-only commit lands a red suite silently. It did, at
# 9dfbc2e. Cost re-measured after adding it, not carried forward.
GUARDS="bench/tests/test_documentation_drift_guards_2026-08-25.py
bench/tests/test_recovery_memory_doc_repairs.py
bench/tests/test_memory_index_limits_match_the_loader_2026-09-01.py
bench/tests/test_line_citations_resolve_2026-09-01.py
bench/tests/test_done_markers_carry_evidence_2026-09-10.py
bench/tests/test_task_list_markers_2026-09-09.py
bench/tests/test_stated_gate_count_matches_measurement_2026-09-07.py"

MISSING=""
for f in $GUARDS; do
    [ -f "$f" ] || MISSING="$MISSING $f"
done
if [ -n "$MISSING" ]; then
    echo "pre-commit: guard file(s) missing:$MISSING" >&2
    echo "pre-commit: refusing rather than passing on an absent check." >&2
    exit 1
fi

command -v python3 >/dev/null 2>&1 || {
    echo "pre-commit: python3 not on PATH, so the guards cannot run. Refusing." >&2
    echo "pre-commit: bypass deliberately with: git commit --no-verify" >&2
    exit 1
}

OUT=$(python3 -m pytest -q -p no:cacheprovider $GUARDS 2>&1)
CODE=$?
if [ "$CODE" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: REFUSED. The cheap guards are red." >&2
    echo "" >&2
    printf '%s\n' "$OUT" | tail -25 >&2
    echo "" >&2
    echo "pre-commit: the usual cause is a memory file written without running sv," >&2
    echo "            which DERIVES the file ledger. Try:" >&2
    echo "              python3 -c \"import sys,pathlib; sys.path.insert(0,'scripts'); import cdsfl_sv as sv; sv._update_memory_exclusions_ledger(pathlib.Path('.').resolve())\"" >&2
    echo "" >&2
    echo "pre-commit: to commit anyway, deliberately: git commit --no-verify" >&2
    exit 1
fi

printf '%s\n' "$OUT" | tail -1

# ── 5th guard: LINT THE NOTES BEING COMMITTED ────────────────────────────────
#
# WHY, and it is the founder's own ruling rather than an idea. On 2026-09-04 he
# wrote, after the spelled-number rule had been stated and re-violated
# repeatedly: "THE RULE ALREADY EXISTED ... and the linter already caught it ...
# The failure was never the absence of a rule or a checker; it was never running
# the checker. Therefore: run `python3 scripts/note_vagueness_lint.py <file>` on
# every note and every TTS file BEFORE delivering it, and treat a spelled-number
# finding as blocking rather than advisory."
#
# WHAT WAS ACTUALLY WIRED BEFORE THIS. The linter's LOGIC is exercised by 3 test
# files, which is not the same thing as running it over the notes. The only test
# that lints real notes selects those declaring a v1.7 foot-line: measured
# 2026-09-09, 29 of 379 files under experimental_notes, 7.65%, Wilson
# [5.4%, 10.8%]. A new note omitting the foot-line was exempt from the check by
# omission -- the checker existed, and the note simply never met it.
#
# WHY THE ADDED LINES ONLY. Linting 379 archival notes on every commit would fire
# on work written under earlier standards, which the standard itself preserves
# deliberately. Linting whole STAGED FILES is barely narrower: correcting 1 number
# in a 400-line note would hold the commit to all 400. What a commit can fairly be
# held to is what that commit ADDS, and that is what is linted below.
#
# WHY IT REFUSES RATHER THAN WARNS. The founder's ruling says blocking, not
# advisory. `git commit --no-verify` remains the deliberate escape.
STAGED_NOTES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^experimental_notes/.*\.md$' || true)

if [ -n "$STAGED_NOTES" ]; then
    if [ ! -f scripts/note_vagueness_lint.py ]; then
        echo "pre-commit: the note linter is missing. Refusing rather than" >&2
        echo "            passing on an absent check." >&2
        exit 1
    fi
    # A RATCHET, NOT A BAR. Refuse only findings the commit INTRODUCES.
    #
    # This took 2 attempts to scope and both failures are worth recording,
    # because they are the same mistake at different widths. Linting whole
    # staged FILES refused its own first real commit with 388 findings, every
    # one pre-existing prose in archival notes that a 1-line number correction
    # had touched. Linting ADDED LINES cut that to 38 and was still wrong: a
    # changed line appears whole in the diff, so correcting 1 numeral in a
    # sentence made the commit answerable for that sentence's decade of prose.
    #
    # The question a guard should ask is not "is this file clean" but "did this
    # commit make it worse", which is the ratchet idiom this project already
    # uses for unreached config fields. Each staged note is linted at HEAD and
    # as staged, and only an INCREASE refuses. A note written under an earlier
    # standard can be corrected without being rewritten; a new violation cannot
    # be added.
    #
    # A guard that fires on the ordinary case teaches people to reach for
    # --no-verify by reflex, and the 2 earlier scopings would have taught that
    # on their first outing.
    # PER FILE, NOT ON TOTALS — and the difference is a demonstrated bypass.
    #
    # The first ratchet summed every staged note and compared totals. A reviewer
    # reproduced the hole on 2026-09-10: one commit that cleaned 3 spelled
    # numbers out of an archival note AND added a brand-new note containing
    # "twenty-nine" nets -2, so the total fell and the commit landed, exit 0.
    # The guard SAW the new violation and printed it by name, then let it
    # through. Both this hook's own comment that "a NEW note is held to the whole
    # standard" and its test's docstring that "the ratchet must not become an
    # amnesty for new work" were false in that path, because the only test for it
    # committed a single file and never reached the mixed case.
    #
    # A ratchet on a SUM is not a ratchet. Each file is now judged on its own,
    # and any single file that gets worse refuses the commit.
    WORSENED=""
    WORSENED_COUNT=0
    BEFORE_TOTAL=0
    AFTER_TOTAL=0
    LINT_BROKE=""
    STAGED_COPY=$(mktemp -d -t cdsfl_note_lint)
    trap 'rm -rf "$STAGED_COPY"' EXIT

    # THE LINTER'S OWN EXIT CODE, CAPTURED WHERE IT RUNS.
    #
    # `LINT_CODE=$?` used to sit after an if/else, so it read the status of the
    # if/else — which always succeeds — and the "linter could not run" refusal
    # was unreachable dead code. Demonstrated:
    #   sh -c 'A=5;B=3; if [ "$A" -gt "$B" ]; then F=$((A-B)); else F=0; fi; \
    #          LINT_CODE=$?; echo $LINT_CODE'  ->  0
    # A linter that errors prints "0 finding(s)" on its way out, so the count
    # read 0 and the commit passed. That is failing OPEN in a guard whose own
    # header says it fails closed.
    _lint_count() {   # $1 = file; echoes the count, returns the linter's status
        _out=$(python3 scripts/note_vagueness_lint.py "$1" 2>&1); _rc=$?
        printf '%s\n' "$_out" | grep -oE '^[[:space:]]*[0-9]+ finding' \
            | tail -1 | grep -oE '[0-9]+'
        return $_rc
    }

    for f in $STAGED_NOTES; do
        base=$(basename "$f")
        git show ":$f" > "$STAGED_COPY/after_$base" 2>/dev/null || continue

        A=$(_lint_count "$STAGED_COPY/after_$base") || LINT_BROKE="$LINT_BROKE $f(staged)"
        if git show "HEAD:$f" > "$STAGED_COPY/before_$base" 2>/dev/null; then
            B=$(_lint_count "$STAGED_COPY/before_$base") || LINT_BROKE="$LINT_BROKE $f(HEAD)"
        else
            B=0   # a NEW note has no baseline and is held to the whole standard
        fi

        AFTER_TOTAL=$((AFTER_TOTAL + ${A:-0}))
        BEFORE_TOTAL=$((BEFORE_TOTAL + ${B:-0}))

        if [ "${A:-0}" -gt "${B:-0}" ]; then
            WORSENED_COUNT=$((WORSENED_COUNT + 1))
            WORSENED="$WORSENED
  $f: ${B:-0} -> ${A:-0} finding(s)"
            echo "" >&2
            echo "pre-commit: $f went from ${B:-0} to ${A:-0} note finding(s)." >&2
            python3 scripts/note_vagueness_lint.py "$STAGED_COPY/after_$base" 2>&1 \
                | tail -20 >&2
        fi
    done

    # FAIL CLOSED WHEN THE CHECKER ITSELF BROKE. Checked before the verdict,
    # because a count read off a failed run is not a count.
    if [ -n "$LINT_BROKE" ]; then
        echo "" >&2
        echo "pre-commit: REFUSED. The note linter exited non-zero on:$LINT_BROKE" >&2
        echo "pre-commit: a count read off a failed run is not a count." >&2
        echo "pre-commit: to commit anyway, deliberately: git commit --no-verify" >&2
        exit 1
    fi

    if [ "$WORSENED_COUNT" -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: REFUSED. $WORSENED_COUNT staged note(s) got WORSE:$WORSENED" >&2
        echo "" >&2
        echo "pre-commit: judged per file, not on the total. A commit that cleans" >&2
        echo "            one note may not smuggle a new violation into another." >&2
        echo "pre-commit: founder ruling 2026-09-04 makes these blocking, not advisory." >&2
        echo "pre-commit: to commit anyway, deliberately: git commit --no-verify" >&2
        exit 1
    fi
    echo "pre-commit: note lint ratchet held ($BEFORE_TOTAL at HEAD, $AFTER_TOTAL as staged)."
fi

# STAGE 6 -- REFRESH THE FOUNDER'S DESKTOP COPIES. NON-BLOCKING BY DESIGN.
#
# He reads 3 files from his Desktop and treats them as current. On 2026-09-10 two
# of the three had silently diverged -- the master task list 29,044 bytes short
# and 3.45 h behind, the outcomes log 5,016 bytes short -- and he asked that
# morning whether the companion file "on my desktop (which I presume you have
# been updating)" was current. It was not. The same class of staleness had
# already cost him a drive home from his hotel on 2026-09-09.
#
# THIS STAGE NEVER REFUSES A COMMIT. A convenience copy on one machine must not
# be able to block work, and a guard that fires on the ordinary case teaches
# people to reach for --no-verify. It refreshes and reports; if the Desktop is
# absent, as it is on any other machine, it says so and exits 0.
if [ -f scripts/sync_desktop_mirrors.py ]; then
    if ! python3 scripts/sync_desktop_mirrors.py 2>&1 | sed 's/^/pre-commit: /'; then
        echo "pre-commit: the Desktop mirror refresh failed; commit continues." >&2
    fi
fi

exit 0
