#!/bin/sh
# CDSFL pre-commit guard. Refuses a commit when the cheap correctness guards are red.
#
# WHY THIS EXISTS, with the evidence rather than the intention.
# A commit-time guard was discussed on 5 occasions between 2026-08-25 and
# 2026-09-07 and was never built. On 2026-09-09 at 08:16:17 commit 57d5a0e reached
# HEAD with the full suite red at 5 failures, every one of them self-inflicted the
# previous evening: a memory file was written and `sv` -- which DERIVES the file
# ledger -- was never run. The tracker had recorded the remedy the same evening,
# in these words: "No mechanism is missing; the remedy is ordering." Ordering by
# discipline failed within the hour. This is the mechanism.
#
# WHY ONLY 4 FILES. Measured on this machine over 3 runs: 56 tests in 1.00 s to
# 2.02 s, against 669.92 s for the full suite. A per-commit gate costing 11 minutes
# would be bypassed within a day, and a guard that gets bypassed is not a guard.
# These 4 files are precisely the ones that caught the 2026-09-09 breakage after
# the fact, so they are the ones that would have caught it before.
#
# WHY IT FAILS CLOSED WHEN IT CANNOT RUN. This project's own record names "a guard
# that cannot fail is not a guard" and lists 3 instances in a single night. A hook
# that exits 0 because python was missing is that defect. So an infrastructure
# fault blocks too, loudly, and the escape hatch is explicit and deliberate:
#
#     git commit --no-verify
#
# Using it is a decision, not an accident, and that is the whole point.

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-commit: cannot find the repository root. Refusing." >&2
    exit 1
}
cd "$REPO" || exit 1

GUARDS="bench/tests/test_documentation_drift_guards_2026-08-25.py
bench/tests/test_recovery_memory_doc_repairs.py
bench/tests/test_memory_index_limits_match_the_loader_2026-09-01.py
bench/tests/test_line_citations_resolve_2026-09-01.py"

MISSING=""
for f in $GUARDS; do
    [ -f "$f" ] || MISSING="$MISSING $f"
done
if [ -n "$MISSING" ]; then
    echo "pre-commit: guard file(s) missing:$MISSING" >&2
    echo "pre-commit: refusing rather than passing on an absent check." >&2
    exit 1
fi

command -v python3 >/dev/null 2>&1 || {
    echo "pre-commit: python3 not on PATH, so the guards cannot run. Refusing." >&2
    echo "pre-commit: bypass deliberately with: git commit --no-verify" >&2
    exit 1
}

OUT=$(python3 -m pytest -q -p no:cacheprovider $GUARDS 2>&1)
CODE=$?
if [ "$CODE" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: REFUSED. The cheap guards are red." >&2
    echo "" >&2
    printf '%s\n' "$OUT" | tail -25 >&2
    echo "" >&2
    echo "pre-commit: the usual cause is a memory file written without running sv," >&2
    echo "            which DERIVES the file ledger. Try:" >&2
    echo "              python3 -c \"import sys,pathlib; sys.path.insert(0,'scripts'); import cdsfl_sv as sv; sv._update_memory_exclusions_ledger(pathlib.Path('.').resolve())\"" >&2
    echo "" >&2
    echo "pre-commit: to commit anyway, deliberately: git commit --no-verify" >&2
    exit 1
fi

printf '%s\n' "$OUT" | tail -1
exit 0
