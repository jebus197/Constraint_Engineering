#!/bin/sh
# CDSFL pre-commit guard. Refuses a commit when the cheap correctness guards are red.
#
# WHY THIS EXISTS, with the evidence rather than the intention.
# A commit-time guard was discussed on 5 occasions between 2026-08-25 and
# 2026-09-07 and was never built. On 2026-09-09 at 08:16:17 commit 57d5a0e reached
# HEAD with the full suite red at 5 failures, every one of them self-inflicted the
# previous evening: a memory file was written and `sv` -- which DERIVES the file
# ledger -- was never run. The tracker had recorded the remedy the same evening,
# in these words: "No mechanism is missing; the remedy is ordering." Ordering by
# discipline failed within the hour. This is the mechanism.
#
# WHY ONLY 4 FILES. Measured on this machine over 3 runs: 56 tests in 1.00 s to
# 2.02 s, against 669.92 s for the full suite. A per-commit gate costing 11 minutes
# would be bypassed within a day, and a guard that gets bypassed is not a guard.
# These 4 files are precisely the ones that caught the 2026-09-09 breakage after
# the fact, so they are the ones that would have caught it before.
#
# WHY IT FAILS CLOSED WHEN IT CANNOT RUN. This project's own record names "a guard
# that cannot fail is not a guard" and lists 3 instances in a single night. A hook
# that exits 0 because python was missing is that defect. So an infrastructure
# fault blocks too, loudly, and the escape hatch is explicit and deliberate:
#
#     git commit --no-verify
#
# Using it is a decision, not an accident, and that is the whole point.

set -u

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "pre-commit: cannot find the repository root. Refusing." >&2
    exit 1
}
cd "$REPO" || exit 1

GUARDS="bench/tests/test_documentation_drift_guards_2026-08-25.py
bench/tests/test_recovery_memory_doc_repairs.py
bench/tests/test_memory_index_limits_match_the_loader_2026-09-01.py
bench/tests/test_line_citations_resolve_2026-09-01.py"

MISSING=""
for f in $GUARDS; do
    [ -f "$f" ] || MISSING="$MISSING $f"
done
if [ -n "$MISSING" ]; then
    echo "pre-commit: guard file(s) missing:$MISSING" >&2
    echo "pre-commit: refusing rather than passing on an absent check." >&2
    exit 1
fi

command -v python3 >/dev/null 2>&1 || {
    echo "pre-commit: python3 not on PATH, so the guards cannot run. Refusing." >&2
    echo "pre-commit: bypass deliberately with: git commit --no-verify" >&2
    exit 1
}

OUT=$(python3 -m pytest -q -p no:cacheprovider $GUARDS 2>&1)
CODE=$?
if [ "$CODE" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: REFUSED. The cheap guards are red." >&2
    echo "" >&2
    printf '%s\n' "$OUT" | tail -25 >&2
    echo "" >&2
    echo "pre-commit: the usual cause is a memory file written without running sv," >&2
    echo "            which DERIVES the file ledger. Try:" >&2
    echo "              python3 -c \"import sys,pathlib; sys.path.insert(0,'scripts'); import cdsfl_sv as sv; sv._update_memory_exclusions_ledger(pathlib.Path('.').resolve())\"" >&2
    echo "" >&2
    echo "pre-commit: to commit anyway, deliberately: git commit --no-verify" >&2
    exit 1
fi

printf '%s\n' "$OUT" | tail -1

# ── 5th guard: LINT THE NOTES BEING COMMITTED ────────────────────────────────
#
# WHY, and it is the founder's own ruling rather than an idea. On 2026-09-04 he
# wrote, after the spelled-number rule had been stated and re-violated
# repeatedly: "THE RULE ALREADY EXISTED ... and the linter already caught it ...
# The failure was never the absence of a rule or a checker; it was never running
# the checker. Therefore: run `python3 scripts/note_vagueness_lint.py <file>` on
# every note and every TTS file BEFORE delivering it, and treat a spelled-number
# finding as blocking rather than advisory."
#
# WHAT WAS ACTUALLY WIRED BEFORE THIS. The linter's LOGIC is exercised by 3 test
# files, which is not the same thing as running it over the notes. The only test
# that lints real notes selects those declaring a v1.7 foot-line: measured
# 2026-09-09, 29 of 379 files under experimental_notes, 7.65%, Wilson
# [5.4%, 10.8%]. A new note omitting the foot-line was exempt from the check by
# omission -- the checker existed, and the note simply never met it.
#
# WHY THE ADDED LINES ONLY. Linting 379 archival notes on every commit would fire
# on work written under earlier standards, which the standard itself preserves
# deliberately. Linting whole STAGED FILES is barely narrower: correcting 1 number
# in a 400-line note would hold the commit to all 400. What a commit can fairly be
# held to is what that commit ADDS, and that is what is linted below.
#
# WHY IT REFUSES RATHER THAN WARNS. The founder's ruling says blocking, not
# advisory. `git commit --no-verify` remains the deliberate escape.
STAGED_NOTES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '^experimental_notes/.*\.md$' || true)

if [ -n "$STAGED_NOTES" ]; then
    if [ ! -f scripts/note_vagueness_lint.py ]; then
        echo "pre-commit: the note linter is missing. Refusing rather than" >&2
        echo "            passing on an absent check." >&2
        exit 1
    fi
    # A RATCHET, NOT A BAR. Refuse only findings the commit INTRODUCES.
    #
    # This took 2 attempts to scope and both failures are worth recording,
    # because they are the same mistake at different widths. Linting whole
    # staged FILES refused its own first real commit with 388 findings, every
    # one pre-existing prose in archival notes that a 1-line number correction
    # had touched. Linting ADDED LINES cut that to 38 and was still wrong: a
    # changed line appears whole in the diff, so correcting 1 numeral in a
    # sentence made the commit answerable for that sentence's decade of prose.
    #
    # The question a guard should ask is not "is this file clean" but "did this
    # commit make it worse", which is the ratchet idiom this project already
    # uses for unreached config fields. Each staged note is linted at HEAD and
    # as staged, and only an INCREASE refuses. A note written under an earlier
    # standard can be corrected without being rewritten; a new violation cannot
    # be added.
    #
    # A guard that fires on the ordinary case teaches people to reach for
    # --no-verify by reflex, and the 2 earlier scopings would have taught that
    # on their first outing.
    BEFORE_TOTAL=0
    AFTER_TOTAL=0
    STAGED_COPY=$(mktemp -d -t cdsfl_note_lint)
    trap 'rm -rf "$STAGED_COPY"' EXIT
    for f in $STAGED_NOTES; do
        base=$(basename "$f")
        git show ":$f" > "$STAGED_COPY/after_$base" 2>/dev/null || continue
        A=$(python3 scripts/note_vagueness_lint.py "$STAGED_COPY/after_$base" 2>&1 \
            | grep -oE '^[[:space:]]*[0-9]+ finding' | tail -1 | grep -oE '[0-9]+')
        if git show "HEAD:$f" > "$STAGED_COPY/before_$base" 2>/dev/null; then
            B=$(python3 scripts/note_vagueness_lint.py "$STAGED_COPY/before_$base" 2>&1 \
                | grep -oE '^[[:space:]]*[0-9]+ finding' | tail -1 | grep -oE '[0-9]+')
        else
            B=0   # a NEW note is held to the whole standard, as it should be
        fi
        AFTER_TOTAL=$((AFTER_TOTAL + ${A:-0}))
        BEFORE_TOTAL=$((BEFORE_TOTAL + ${B:-0}))
        if [ "${A:-0}" -gt "${B:-0}" ]; then
            echo "" >&2
            echo "pre-commit: $f went from ${B:-0} to ${A:-0} note finding(s)." >&2
            python3 scripts/note_vagueness_lint.py "$STAGED_COPY/after_$base" 2>&1 \
                | tail -20 >&2
        fi
    done
    LINT_OUT="  ratchet: ${BEFORE_TOTAL} finding(s) at HEAD, ${AFTER_TOTAL} as staged."
    LINT_CODE=0
    if [ "$AFTER_TOTAL" -gt "$BEFORE_TOTAL" ]; then
        FINDINGS=$((AFTER_TOTAL - BEFORE_TOTAL))
    else
        FINDINGS=0
    fi
    LINT_CODE=$?
    if [ "$LINT_CODE" -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: the note linter could not run (exit $LINT_CODE). Refusing." >&2
        printf '%s\n' "$LINT_OUT" | tail -15 >&2
        exit 1
    fi
    if [ "${FINDINGS:-0}" -ne 0 ]; then
        echo "" >&2
        echo "pre-commit: REFUSED. The staged notes ADD $FINDINGS note finding(s)." >&2
        echo "" >&2
        printf '%s\n' "$LINT_OUT" | tail -30 >&2
        echo "" >&2
        echo "pre-commit: founder ruling 2026-09-04 makes these blocking, not advisory." >&2
        echo "pre-commit: to commit anyway, deliberately: git commit --no-verify" >&2
        exit 1
    fi
    echo "pre-commit: note lint ratchet held ($BEFORE_TOTAL at HEAD, $AFTER_TOTAL as staged)."
fi

exit 0
