### fable:attempt-1:bench/severity_instrument.py
--- /dev/null	2026-10-18 03:28:16
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_uwqxemje/repo/bench/severity_instrument.py	2026-10-18 03:25:28
@@ -0,0 +1,152 @@
+"""The severity ruler's instrument-noise channel: expected critical counts.
+
+Joint round 2026-10-18. This module is the reconstruction of cc2's blind-round
+fix, rebuilt after sandbox teardown and adopted by the fable seat on a
+MEASUREMENT, not by deference: over 62 archived catalogues
+(`scripts/do_the_two_rulers_compose_2026-10-18.py`),
+
+  * this smoothing alone moves the production tail quiescence verdict on 7
+    runs, every one in the STRICT direction (refusing a convergence the hard
+    indicator permits; one-way property proved below and violated 0 times);
+  * the star-median pooling ruler (fable's blind fix) moves it on 0 of 62;
+  * the COMPOSITION Phi((star_median - thr) / (sigma * c_k)) moves it on 0 of
+    62 beyond this fix alone, AND loses the one-way guarantee: at the decision
+    line it disagrees with this ruler on exactly 14 archived entries, all 14
+    falsifier-CONFIRMED criticals pulled BELOW 0.5 by co-discoverers' lower
+    asserted numbers (leg3 C0006: CONFIRMED at 0.9, star [0.9, 0.45, 0.45],
+    composed weight 0.0043). That is votes overriding a tool.
+
+Under the founder's composability ruling (2026-10-02) the composition is
+therefore REFUSED: no measurement shows it dominating this fix alone, and the
+measurement that exists shows it strictly worse on a named property (one-way
+conservatism). The pooled ruler is not promoted either (0/62 reach on the
+quiescence channel).
+
+THE RULER ITSELF. `_settled_novelty_series` decides criticality with the hard
+indicator 1[severity >= 0.7] on a quantity whose per-assignment noise is
+measured at sigma = 0.1419, bootstrap 95% CI [0.1241, 0.1575], from 273
+duplicate pairs (docs/MATHEMATICAL_APPENDIX.md, "the instrument's noise
+floor"). This module reports the indicator's EXPECTATION under that noise:
+
+    w(f) = Phi((severity - threshold) / sigma),   REFUTED -> exactly 0.0.
+
+Properties, each executed by the test file
+`bench/tests/test_the_two_rulers_compose_2026-10-18.py`:
+
+  * Phi(threshold) = 1/2 exactly: a finding on the line is worth a coin toss.
+  * sigma -> 0 recovers the production ruler VALUE-FOR-VALUE on every
+    archived catalogue (the hard indicator is the sigma=0 member of this
+    family), which is what discharges the additive standard.
+  * ONE-WAY: a countable entry with severity >= threshold and no REFUTED
+    verdict has w >= 1/2, so a quiescent soft tail implies a quiescent hard
+    tail. The smoothing can refuse a convergence the hard rule permits and
+    can never permit one it refuses.
+
+DIAGNOSTIC ONLY. The live gate keeps deciding on the hard indicator; this is
+written into the report by `gamma_threshold_profile` so the reach measurement
+(the 7 strict flips) can be taken on live runs before any promotion, which is
+a founder decision. Promotion of ANY rule that reads these weights must
+re-derive the one-way direction for its own predicate: the proof covers the
+`< 0.5` quiescence test and nothing else (cc2's refutation condition 3,
+blind round 2026-10-18).
+"""
+from __future__ import annotations
+
+import math
+from typing import Any, Dict, List, Tuple
+
+#: Per-assignment severity noise, measured from 273 duplicate pairs in which 2
+#: different models independently scored the same defect. Producer:
+#: docs/MATHEMATICAL_APPENDIX.md ("the instrument's noise floor"), bootstrap
+#: 95% CI [0.1241, 0.1575].
+SEVERITY_INSTRUMENT_SIGMA = 0.1419
+
+#: Mirrors of the production constants. DELIBERATE mirror, not an import: a
+#: module-level import of reference_runner_v3 from one of its own siblings
+#: would be circular once the runner imports this module. The test file
+#: asserts both mirrors equal the production values, and asserts the sigma->0
+#: series equals `_settled_novelty_series` value-for-value on every archived
+#: catalogue, so a drift in either constant fails loudly.
+CRITICAL_SEVERITY_THRESHOLD_MIRROR = 0.7
+NON_NOVEL_TERMINAL_STATUSES_MIRROR = frozenset(
+    {"MERGED", "DUPLICATE", "UNCONFIRMED", "REFUTED"})
+
+
+def _phi(x: float) -> float:
+    return 0.5 * (1.0 + math.erf(x / math.sqrt(2.0)))
+
+
+def critical_weight(entry: dict,
+                    sigma: float = SEVERITY_INSTRUMENT_SIGMA,
+                    threshold: float = CRITICAL_SEVERITY_THRESHOLD_MIRROR,
+                    ) -> float:
+    """Expected value of the critical indicator under instrument noise.
+
+    REFUTED short-circuits to exactly 0.0 -- the annihilation term of
+    `spec_verification_factor`, held exactly rather than approximated: a
+    disproved finding is worth nothing, not Phi's 4.1e-7 tail.
+    """
+    if str(entry.get("falsifier_verdict") or "").strip().upper() == "REFUTED":
+        return 0.0
+    sev = float(entry.get("severity") or 0.0)
+    if sigma <= 0.0:  # the sigma->0 member IS the production indicator
+        return 1.0 if sev >= threshold else 0.0
+    return _phi((sev - threshold) / sigma)
+
+
+def expected_critical_series(registry, max_round: int,
+                             sigma: float = SEVERITY_INSTRUMENT_SIGMA,
+                             ) -> List[float]:
+    """Per-round EXPECTED novel-critical counts from the settled registry.
+
+    The population filter deliberately mirrors `_settled_novelty_series`
+    admission (open_since_round window, non-novel terminal statuses), so the
+    ONLY difference between the two series is indicator-versus-Phi. A second,
+    independently-written filter would make any difference unattributable.
+    """
+    entries = registry.entries if hasattr(registry, "entries") else {}
+    vals = entries.values() if isinstance(entries, dict) else entries
+    s = [0.0] * (max_round + 1)
+    for e in vals:
+        r = e.get("open_since_round")
+        if r is None or r < 0 or r > max_round:
+            continue
+        if e.get("status") in NON_NOVEL_TERMINAL_STATUSES_MIRROR:
+            continue
+        s[r] += critical_weight(e, sigma=sigma)
+    return s
+
+
+def tail_is_quiescent_soft(series: List[float]) -> bool:
+    """all(w < 0.5) over the last-3 tail, the same window the production
+    `tail_is_quiescent` reads. 0.5 = Phi(0): the most likely critical count
+    in a quiet round is zero. ONE-WAY with respect to the hard tail, by the
+    module docstring's derivation."""
+    tail = series[-3:] if len(series) >= 3 else list(series)
+    return bool(tail) and all(w < 0.5 for w in tail)
+
+
+def instrument_noise_profile(registry, max_round: int) -> Dict[str, Any]:
+    """The report block: both rulers' series, tails, gammas, and whether the
+    quiescence verdict differs. Diagnostic; changes no verdict."""
+    import reference_runner_v3 as rr  # call-time import, no circularity
+    _, hard = rr._settled_novelty_series(registry, max_round)
+    soft = expected_critical_series(registry, max_round)
+    hard_tail = hard[-3:] if len(hard) >= 3 else list(hard)
+    soft_tail = soft[-3:] if len(soft) >= 3 else list(soft)
+    q_hard = bool(hard_tail) and all(c == 0 for c in hard_tail)
+    q_soft = tail_is_quiescent_soft(soft)
+    return {
+        "sigma": SEVERITY_INSTRUMENT_SIGMA,
+        "sigma_ci95": [0.1241, 0.1575],
+        "sigma_producer": "docs/MATHEMATICAL_APPENDIX.md, 273 duplicate pairs",
+        "expected_critical_series": [round(w, 4) for w in soft],
+        "soft_tail": [round(w, 4) for w in soft_tail],
+        "tail_is_quiescent_soft": q_soft,
+        "tail_is_quiescent_hard": q_hard,
+        "quiescence_verdict_differs": q_soft != q_hard,
+        "gamma_soft": round(rr._estimate_gamma(soft), 4),
+        "gamma_hard": round(rr._estimate_gamma(hard), 4),
+        "one_way": "soft-quiescent implies hard-quiescent; see module docstring",
+        "deciding": False,
+    }

### fable:attempt-1:bench/tests/test_the_two_rulers_compose_2026-10-18.py
--- /dev/null	2026-10-18 03:28:17
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_uwqxemje/repo/bench/tests/test_the_two_rulers_compose_2026-10-18.py	2026-10-18 03:25:11
@@ -0,0 +1,260 @@
+"""Do the 2 severity de-coarsening fixes compose? NO -- measured, 0/62 and a
+lost guarantee. Joint round 2026-10-18, fable seat.
+
+The two blind fixes: cc2's smoothing (Phi((sev-0.7)/sigma) in place of the
+hard indicator) and fable's pooling (star-median severity into the same
+indicator). The natural composition is Phi((star_median-0.7)/(sigma*c_k)).
+Executed over every archived catalogue with a settled registry (62):
+
+  * the composition changes NO quiescence verdict relative to the smoothing
+    alone (0/62), tail predicate and all-rounds predicate alike;
+  * the pooled indicator changes NO quiescence verdict relative to the hard
+    ruler (0/62);
+  * at the 0.5 decision line the composition disagrees with the smoothing on
+    exactly 14 archived entries -- ALL 14 falsifier-CONFIRMED criticals pulled
+    BELOW 0.5, none pulled above. The composition loses the smoothing's
+    one-way (conservative) guarantee and loses it in the anti-tool direction.
+
+Under the founder's composability ruling (2026-10-02): no measured advantage,
+one measured regression -> build the smoothing alone. These tests pin both
+halves of that measurement so the refusal stays evidenced.
+"""
+from __future__ import annotations
+
+import json
+import math
+import pathlib
+import statistics
+import sys
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "bench"))
+
+import reference_runner_v3 as rr  # noqa: E402
+import severity_instrument as si  # noqa: E402
+
+LEG3 = "leg3_final_shakedown_20261015T220118Z"
+FREE1 = "free_run1_directive_whole_20261015T061123Z_20261015T061124Z"
+
+#: SD of the median of k independent normal assessments, as a multiple of the
+#: per-assessment sigma. k=1 exact; k=2 exact (median of 2 IS the mean of 2);
+#: k=3,5 by quadrature on the order-statistic density (SciPy), confirmed to 10
+#: digits by Wolfram Language (local Wolfram Engine): 0.6698291607404084,
+#: 0.5355685405302014. k=4,6,8 by seeded Monte Carlo (4e6 draws).
+MEDIAN_SD = {1: 1.0, 2: 1 / math.sqrt(2), 3: 0.66983, 4: 0.54605,
+             5: 0.53557, 6: 0.46325, 7: 0.45880, 8: 0.41005}
+
+
+class _Reg:
+    def __init__(self, entries):
+        self.entries = entries
+
+
+def _catalogues():
+    out = []
+    for p in sorted((ROOT / "bench" / "logs").glob("*/runner_state.json")):
+        try:
+            d = json.loads(p.read_text())
+        except Exception:
+            continue
+        entries = (d.get("registry") or {}).get("entries")
+        if not entries:
+            continue
+        nc = d.get("novelty_counts") or []
+        mr = max(len(nc) - 1,
+                 max((e.get("open_since_round") or 0) for e in entries.values()))
+        out.append((p.parent.name, entries, mr))
+    return out
+
+
+CATS = _catalogues()
+
+
+def _entries(run):
+    return json.loads((ROOT / "bench" / "logs" / run /
+                       "runner_state.json").read_text())["registry"]["entries"]
+
+
+def _star(cid, entries):
+    members = [cid]
+    for occ in entries[cid].get("occasions") or []:
+        fc = occ.get("from_canonical")
+        if (occ.get("via") == "codiscovery" and fc and fc != cid
+                and fc in entries and fc not in members):
+            members.append(fc)
+    return members
+
+
+def _pooled(cid, entries):
+    ms = _star(cid, entries)
+    return statistics.median(
+        float(entries[m].get("severity") or 0.0) for m in ms), len(ms)
+
+
+def _composed_weight(cid, entries):
+    e = entries[cid]
+    if str(e.get("falsifier_verdict") or "").strip().upper() == "REFUTED":
+        return 0.0
+    med, k = _pooled(cid, entries)
+    sd = si.SEVERITY_INSTRUMENT_SIGMA * MEDIAN_SD[min(k, 8)]
+    return si._phi((med - si.CRITICAL_SEVERITY_THRESHOLD_MIRROR) / sd)
+
+
+def _soft_series(entries, mr, weight_of):
+    s = [0.0] * (mr + 1)
+    for cid, e in entries.items():
+        r = e.get("open_since_round")
+        if r is None or r < 0 or r > mr:
+            continue
+        if e.get("status") in si.NON_NOVEL_TERMINAL_STATUSES_MIRROR:
+            continue
+        s[r] += weight_of(cid, e)
+    return s
+
+
+def test_the_mirrored_constants_match_production():
+    assert si.CRITICAL_SEVERITY_THRESHOLD_MIRROR == rr.CRITICAL_SEVERITY_THRESHOLD
+    assert si.NON_NOVEL_TERMINAL_STATUSES_MIRROR == frozenset(
+        rr._NON_NOVEL_TERMINAL_STATUSES)
+
+
+def test_the_sigma_zero_member_is_the_production_ruler():
+    """Additive-standard discharge: nothing is removed -- the hard indicator
+    is the sigma=0 member of the Phi family, value-for-value, every catalogue.
+
+    REFUTED-verdict entries are the one deliberate divergence (annihilation);
+    they are excluded from this comparison and pinned by their own test."""
+    assert CATS, "no archived catalogues discovered"
+    for name, entries, mr in CATS:
+        live = {cid: e for cid, e in entries.items()
+                if str(e.get("falsifier_verdict") or "").strip().upper()
+                != "REFUTED"}
+        _, hard = rr._settled_novelty_series(_Reg(live), mr)
+        limit = si.expected_critical_series(_Reg(live), mr, sigma=0.0)
+        assert [int(w) for w in limit] == hard, (
+            f"sigma->0 series diverges from production on {name}: "
+            f"{limit} != {hard}")
+
+
+def test_phi_at_the_threshold_is_exactly_half():
+    w = si.critical_weight({"severity": rr.CRITICAL_SEVERITY_THRESHOLD})
+    assert w == pytest.approx(0.5, abs=1e-15)
+
+
+def test_refuted_is_annihilated_exactly():
+    e = _entries(LEG3)["C0018"]
+    assert str(e.get("falsifier_verdict")).upper() == "REFUTED"
+    assert si.critical_weight(e) == 0.0, (
+        "a disproved finding must be ANNIHILATED, not merely reduced")
+
+
+def test_the_one_way_property_holds_on_the_whole_archive():
+    """Theorem: countable, sev >= thr, not REFUTED => w >= 1/2. Hence a
+    quiescent soft tail implies a quiescent hard tail. Checked per-entry and
+    per-run over all 62 catalogues."""
+    violations = []
+    for name, entries, mr in CATS:
+        for cid, e in entries.items():
+            if e.get("status") in si.NON_NOVEL_TERMINAL_STATUSES_MIRROR:
+                continue
+            if str(e.get("falsifier_verdict") or "").strip().upper() == "REFUTED":
+                continue
+            if float(e.get("severity") or 0.0) >= rr.CRITICAL_SEVERITY_THRESHOLD:
+                if si.critical_weight(e) < 0.5:
+                    violations.append((name, cid))
+        _, hard = rr._settled_novelty_series(_Reg(entries), mr)
+        soft = si.expected_critical_series(_Reg(entries), mr)
+        hard_tail = hard[-3:] if len(hard) >= 3 else hard
+        if si.tail_is_quiescent_soft(soft) and not all(c == 0 for c in hard_tail):
+            violations.append((name, "RUN-LEVEL"))
+    assert not violations, (
+        f"ONE-WAY PROPERTY VIOLATED -- the soft rule permitted where the hard "
+        f"rule refused: {violations}")
+
+
+def test_the_smoothing_reaches_7_runs_all_in_the_strict_direction():
+    stricter, looser = [], []
+    for name, entries, mr in CATS:
+        prof = si.instrument_noise_profile(_Reg(entries), mr)
+        if prof["quiescence_verdict_differs"]:
+            (stricter if prof["tail_is_quiescent_hard"] else looser).append(name)
+    assert looser == []
+    assert sorted(stricter) == [
+        "commissioning_arm1_panel_20260929T194414Z",
+        "commissioning_arm3_contrast_20260930T051219Z",
+        "exp35_pe_20260406T152126Z",
+        "exp40_slice_collision_20260518T130744Z",
+        FREE1,
+        "sim45_memory_20260830T235237Z",
+        "sim45_postfix_20260901T231824Z_20260901T231827Z",
+    ], f"reach changed: {sorted(stricter)}"
+
+
+def test_leg3_through_the_production_caller():
+    prof = rr.gamma_threshold_profile(_Reg(_entries(LEG3)), 4)
