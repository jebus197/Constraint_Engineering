#!/usr/bin/env python3
"""Round-2 harness: compare arm-4b review-guard variants across
(1) rehearsal r0 replies, (2) exp43 C0040 reply, (3) the full archive."""
import json, re, sys, types, glob, os
from pathlib import Path

ROOT = Path(__file__).parent
SRC = (ROOT / "bench" / "runner_core.py").read_text()

ARM4B_GUARD = (
    "        if re.search(r'^\\s*(?:#+\\s*)?(?:Round\\s+\\d+\\s+)?Review(?:\\s+Summary)?\\b',\n"
    "                     response.strip()[:80], re.IGNORECASE):\n"
    "            _hits = []\n"
)
assert ARM4B_GUARD in SRC, "arm4b guard text not found"

# Variant B: explicit round reference OR the word Summary; also cover ** prefix.
TIGHT = (
    "        if re.search(r'^\\s*(?:[#*]+\\s*)?(?:Round\\s+\\d+\\s+Review|Review\\s+Summary|Summary\\s+of\\s+Round\\s+\\d+)\\b',\n"
    "                     response.strip()[:80], re.IGNORECASE):\n"
    "            _hits = []\n"
)

VARIANTS = {
    "A_as_written": SRC,
    "B_tightened": SRC.replace(ARM4B_GUARD, TIGHT),
    "C_no_guard":  SRC.replace(ARM4B_GUARD, ""),
}
for k, v in VARIANTS.items():
    if k != "A_as_written":
        assert v != SRC, k

def load_variant(name, src):
    mod = types.ModuleType(f"rc_{name}")
    mod.__file__ = str(ROOT / "bench" / "runner_core.py")
    sys.modules[f"rc_{name}"] = mod
    old = os.getcwd(); os.chdir(ROOT / "bench")
    try:
        exec(compile(src, f"runner_core[{name}]", "exec"), mod.__dict__)
    finally:
        os.chdir(old)
    return mod

mods = {k: load_variant(k, v) for k, v in VARIANTS.items()}

# ---------- corpus ----------
corpus = []  # (tag, model_id, round_idx, response)

# 1. rehearsal individual reply files (all rounds)
for f in sorted(glob.glob(str(ROOT / "bench/logs/sim45_memory_20260901T003907Z/r[0-9]_*.json"))):
    d = json.load(open(f))
    rnd = int(Path(f).name[1])
    corpus.append((f"rehearsal:{Path(f).name}", d["model_label"], rnd, d["response"]))

# 2. exp43 archived rounds (the run the guard was written for)
for f in sorted(glob.glob(str(ROOT / "bench/logs/exp43_*/round_*.json"))):
    d = json.load(open(f))
    mr = d.get("model_responses") or {}
    for m, resp in mr.items():
        if isinstance(resp, str) and resp.strip():
            corpus.append((f"exp43:{Path(f).parent.name[-16:]}/{Path(f).name}", m, d.get("round_idx", 0), resp))

# 3. broader archive: every round_*.json under bench/logs + quarantine
for f in sorted(glob.glob(str(ROOT / "bench/logs*/**/round_*.json"), recursive=True)):
    if "exp43" in f or "sim45_memory_20260901T003907Z" in f:
        continue
    try:
        d = json.load(open(f))
    except Exception:
        continue
    mr = d.get("model_responses") or {}
    if isinstance(mr, dict):
        for m, resp in mr.items():
            if isinstance(resp, str) and resp.strip():
                corpus.append((f"arch:{Path(f).parent.name}/{Path(f).name}", m, d.get("round_idx", 0), resp))

print(f"corpus size: {len(corpus)} replies")

# ---------- run ----------
def sig(findings):
    return tuple(sorted((f.finding_id, round(f.severity, 3)) for f in findings))

diffs = {}
totals = {k: 0 for k in mods}
for tag, m, r, resp in corpus:
    res = {}
    for k, mod in mods.items():
        try:
            fs = mod.parse_findings(m, r, resp)
        except Exception as e:
            res[k] = ("ERR", str(e)); continue
        res[k] = sig(fs)
        totals[k] += len(fs)
    if len(set(map(str, res.values()))) > 1:
        diffs[(tag, m)] = res

print("total findings per variant:", totals)
print(f"\nreplies where variants differ: {len(diffs)}")
for (tag, m), res in diffs.items():
    print(f"\n--- {tag} [{m}] ---")
    for k, v in res.items():
        print(f"  {k}: {len(v)} findings :: {[fid for fid,_ in v][:8]}")

