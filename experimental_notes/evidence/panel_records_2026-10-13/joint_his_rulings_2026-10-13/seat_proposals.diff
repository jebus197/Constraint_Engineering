+                   and not r[arm]["pruned_soft"]), n)
+        print()
+
+    on_unlogged = sum(1 for r in rows
+                      if (r["on"]["cap_fired"] or not r["on"]["payload_intact"])
+                      and not r["on"]["pruned_soft"])
+    off_unlogged = sum(1 for r in rows
