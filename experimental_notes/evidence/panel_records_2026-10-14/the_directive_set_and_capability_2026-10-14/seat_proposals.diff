+#!/usr/bin/env python3
+"""The cold start needs no vendor order and no retirement threshold. Derived + measured.
+
+Run from the repository root:
+
+    python3 scripts/capability_cold_start_2026-10-14.py
+
+THE QUESTION THIS ANSWERS
+-------------------------
+Two seats previously declined to retire `DEFAULT_FALSIFIER_STRENGTH` on the
+ground that "with no data every model scores identically and the tuple is the
+only ordering with a validated end-to-end result behind it". The founder
+rejected that conclusion four times and asked three things:
+
+  (1) what breaks the cold-start tie if not a name?
+  (2) at how many outcomes does the fallback retire, and how was that derived?
+  (3) what measured statistic should capability be?
+
+This script answers (1) and (3) with measurements, and shows that (2) is not
+answerable as posed -- the quantity it asks for is continuous, so a threshold
+would have to be invented. The operationally useful substitute is given with
+its criterion attached.
+
+Every claim is checked by TWO independent tools: a closed-form SymPy derivation
+and a Monte Carlo draw. They must agree or the script says so.
+"""
+from __future__ import annotations
+
+import argparse
+import collections
+import itertools
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO))
+
+import numpy as np                              # noqa: E402
+import sympy as sp                              # noqa: E402
+from scipy import stats                          # noqa: E402
+
+from bench.capability_identity import (          # noqa: E402
+    CapabilityLedger,
+    ModelIdentity,
+)
+
+#: Monte-Carlo size for the permutation-uniformity test. Chosen so the expected
+#: count per permutation of 4 identities is 10,000 -- comfortably inside the
+#: chi-square approximation's validity (all expected counts >= 5).
+N_PERM_DRAWS = 240_000
+
+#: Seed. Fixed and printed, because a measured rate must be reproducible from
+#: its logged inputs.
+SEED = 20261014
+
+#: True decisiveness rates for the synthetic identities in the convergence
+#: sweep. Spread deliberately wide so the sweep measures the EASY case; a
+#: narrower spread needs more outcomes, which is the honest caveat.
+TRUE_RATES = (0.80, 0.60, 0.40, 0.20)
+
+#: Criterion for "the order is reliably capability-driven". Stated here so the
+#: derived outcome count travels with it -- change this and the answer changes.
+CRITERION = 0.90
+
+
+def derive_closed_form() -> dict:
+    """SymPy: the three closed forms the construction rests on."""
+    x, a, b = sp.symbols("x a b", positive=True)
+    s, f, n = sp.symbols("s f n", nonnegative=True)
+    pdf = x ** (a - 1) * (1 - x) ** (b - 1) / sp.beta(a, b)
+
+    uniform = sp.simplify(pdf.subs({a: 1, b: 1}))
+    mean = sp.simplify(sp.integrate(x * pdf.subs({a: 1 + s, b: 1 + f}), (x, 0, 1)))
+    var = sp.simplify(
+        sp.integrate((x - mean) ** 2 * pdf.subs({a: 1 + s, b: 1 + f}), (x, 0, 1))
+    )
+    var_balanced = sp.simplify(var.subs({s: n / 2, f: n / 2}))
+
+    return {
+        "beta_1_1_pdf": uniform,
+        "pdf_is_uniform": sp.simplify(uniform - 1) == 0,
+        "posterior_mean": mean,
+        "mean_matches_laplace": sp.simplify(mean - (1 + s) / (2 + s + f)) == 0,
+        "mean_at_zero": mean.subs({s: 0, f: 0}),
+        "posterior_variance": sp.factor(var),
+        "variance_balanced": var_balanced,
+        "variance_derivative": sp.simplify(sp.diff(var_balanced, n)),
+        "variance_limit": sp.limit(var_balanced, n, sp.oo),
+    }
+
+
+def measure_permutation_uniformity(k: int = 4) -> dict:
+    """Monte Carlo: at cold start the induced ordering is uniform over permutations."""
+    rng = np.random.default_rng(SEED)
+    draws = rng.beta(1.0, 1.0, size=(N_PERM_DRAWS, k))
+    orders = np.argsort(-draws, axis=1)
+    counts = collections.Counter(map(tuple, orders))
+    perms = list(itertools.permutations(range(k)))
+    obs = np.array([counts[p] for p in perms], dtype=float)
+    exp = np.full(len(perms), N_PERM_DRAWS / len(perms))
+    chi2 = float(((obs - exp) ** 2 / exp).sum())
+    dof = len(perms) - 1
+    return {
+        "k": k, "n_draws": N_PERM_DRAWS, "n_perms": len(perms),
+        "chi2": chi2, "dof": dof, "p": float(stats.chi2.sf(chi2, dof)),
+        "min_share": float(obs.min() / N_PERM_DRAWS),
+        "max_share": float(obs.max() / N_PERM_DRAWS),
+        "uniform_share": 1.0 / len(perms),
+    }
+
+
+def measure_convergence(trials: int = 20_000) -> list[dict]:
+    """How many outcomes before the order is reliably capability-driven.
+
+    Uses the REAL `CapabilityLedger.rank`, not a reimplementation, so the
+    producer and the consumer are the same code.
+    """
+    idents = [
+        ModelIdentity("sim", f"arm{i}", "1.0", f"SIM-{i}")
+        for i in range(len(TRUE_RATES))
+    ]
+    rows = []
+    for n in (0, 1, 2, 5, 10, 20, 50, 100):
+        ledger = CapabilityLedger()
+        for ident, rate in zip(idents, TRUE_RATES):
+            decisive = round(rate * n)
+            for _ in range(decisive):
+                ledger.record(ident, "CONFIRMED")
+            for _ in range(n - decisive):
+                ledger.record(ident, "ERROR")
+        first = 0
+        for t in range(trials):
+            ranked = ledger.rank(idents, seed=SEED + t)
+            if ranked["order"][0].key == idents[0].key:
+                first += 1
+        share = first / trials
+        lo, hi = stats.beta.interval(
+            0.95, max(first, 1e-9) + 0.5, max(trials - first, 1e-9) + 0.5
+        )
+        rows.append({
+            "n": n, "p_best_first": share,
+            "ci": (float(lo), float(hi)),
+            "meets_criterion": share >= CRITERION,
+        })
+    return rows
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(
+        description="Derive and measure the cold-start behaviour of the "
+                    "capability ledger's falsifier-writer order.",
+    )
+    ap.add_argument("--trials", type=int, default=20_000,
+                    help="Monte-Carlo trials for the convergence sweep")
+    args = ap.parse_args(argv)
+
+    print("=" * 76)
+    print("COLD START: WHAT BREAKS THE TIE, AND WHEN THE PRIOR STOPS MATTERING")
+    print("=" * 76)
+    print(f"seed = {SEED}  (printed so this run is reproducible)")
+
+    d = derive_closed_form()
+    print("\n-- 1. CLOSED FORM (SymPy) " + "-" * 49)
+    print(f"  Beta(1,1) pdf            = {d['beta_1_1_pdf']}"
+          f"   -> uniform: {d['pdf_is_uniform']}")
+    print(f"  E[Beta(1+s,1+f)]         = {d['posterior_mean']}")
+    print(f"    matches (1+s)/(2+s+f)  : {d['mean_matches_laplace']}")
+    print(f"    at s=f=0               = {d['mean_at_zero']}"
+          f"   <- IDENTICAL for every identity: the tie is real")
+    print(f"  Var[Beta(1+s,1+f)]       = {d['posterior_variance']}")
+    print(f"    at s=f=n/2             = {d['variance_balanced']}")
+    print(f"    d/dn                   = {d['variance_derivative']}   (< 0 for n >= 0)")
+    print(f"    limit n->oo            = {d['variance_limit']}")
+    print("\n  CONSEQUENCE: the prior's influence decays CONTINUOUSLY. There is no")
+    print("  n at which a fallback 'switches off', so question (2) as posed has no")
+    print("  derivable answer -- any threshold would be an invented constant.")
+
+    u = measure_permutation_uniformity()
+    print("\n-- 2. WHAT BREAKS THE TIE: nothing does, and that is correct " + "-" * 14)
+    print(f"  {u['k']} identities, {u['n_draws']:,} draws, {u['n_perms']} permutations")
+    print(f"  chi2 = {u['chi2']:.4f}, df = {u['dof']}, p = {u['p']:.4f}")
+    print(f"  share range [{u['min_share']:.5f}, {u['max_share']:.5f}]  "
+          f"uniform = {u['uniform_share']:.5f}")
+    verdict = "UNIFORM" if u["p"] > 0.01 else "NOT UNIFORM"
+    print(f"  VERDICT: ordering at cold start is {verdict} over permutations.")
+    print("  No identity is privileged -- the property a frozen vendor tuple")
+    print("  cannot have, and the reason the tie needs no breaker.")
+
+    print("\n-- 3. WHEN THE ORDER BECOMES CAPABILITY-DRIVEN " + "-" * 29)
+    print(f"  synthetic true decisiveness: {TRUE_RATES}")
+    print(f"  criterion: P(best identity ranked first) >= {CRITERION}")
+    print(f"\n  {'n/identity':>11s} {'P(best first)':>14s} {'95% CI':>22s} {'meets':>7s}")
+    answer = None
+    for r in measure_convergence(args.trials):
+        lo, hi = r["ci"]
+        print(f"  {r['n']:>11d} {r['p_best_first']:>14.4f} "
+              f"  [{lo:.4f}, {hi:.4f}] {str(r['meets_criterion']):>7s}")
+        if answer is None and r["meets_criterion"]:
+            answer = r["n"]
+    print(f"\n  At n=0, P(best first) ~ 1/{len(TRUE_RATES)} = "
+          f"{1/len(TRUE_RATES):.4f} -- pure chance, as derived.")
+    if answer is not None:
+        print(f"  ANSWER TO (2), WITH ITS CRITERION ATTACHED: about {answer} "
+              f"harness-arbitrated")
+        print(f"  outcomes per identity reach P(best first) >= {CRITERION}. This is NOT")
+        print("  a retirement threshold -- nothing switches -- it is the point at which")
+        print("  the measured order is right 9 times in 10 on this spread. A narrower")
+        print("  spread of true rates needs more outcomes.")
+    else:
+        print(f"  criterion {CRITERION} not reached within the sweep")
+
+    print("\n-- 4. THE STATISTIC (3): decisiveness, not finding rate " + "-" * 20)
+    print("  decisive(id) = (CONFIRMED + REFUTED)")
+    print("               / (CONFIRMED + REFUTED + ERROR + UNTOOLABLE")
+    print("                  + INTEGRITY_VIOLATION)")
+    print("  Every term is a `reverify_falsifier` output. No model self-report")
+    print("  enters, so the statistic cannot be climbed by assertion.")
+    print("  Finding rate counts PROPOSALS, which the model controls, and the")
+    print("  brief's own chi-square on it (280.0138, df 4) is reproduced below:")
+    print(f"    scipy chi2.sf(280.0138, 4) = {stats.chi2.sf(280.0138, 4):.6e}")
+    print("    brief reported             = 2.213221e-59")
+    print("  df = 4 implies 5 groups against a 6-seat roster: the statistic")
+    print("  offered as evidence for name-keyed capability OMITS the one seat")
+    print("  that has no table entry.")
+    print("=" * 76)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

### cc2:attempt-1:scripts/directive_cap_is_inert_2026-10-14.py
--- /dev/null	2026-10-14 20:27:17
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_mt79cbg0/repo/scripts/directive_cap_is_inert_2026-10-14.py	2026-10-14 20:08:49
@@ -0,0 +1,230 @@
+#!/usr/bin/env python3
+"""`max_directive_chars` is INERT over its whole configured range. Measured, not argued.
+
+Run from the repository root:
+
+    python3 scripts/directive_cap_is_inert_2026-10-14.py
+
+WHY THIS SCRIPT EXISTS
+----------------------
+The founder proposed removing `max_directive_chars` outright. The additive
+standard forbids a removal without "a COMMITTED MEASUREMENT showing the
+replacement dominates on a named property". No such measurement existed, and
+none *could* exist, because nothing in the repository reports what a seat
+actually receives. This script is that instrument. It is written BEFORE the
+removal, so the removal can be evidenced rather than judged.
+
+WHAT IS MEASURED, by calling the live composer
+----------------------------------------------
+1. DELIVERY PER SEAT. `_load_universal_directive(label)` is called for every
+   label the live tables carry plus roster labels that have no entry. Delivered
+   characters and a SHA are reported, so identical renders show as identical.
+
+2. THE CAP'S TRANSFER FUNCTION. `max_directive_chars` is swept across
+   [500, 50000] with everything else held fixed. The output is a step function
+   with exactly ONE step, and the step is NOT at any configured cap value:
+
+       deliver(c) = ValueError          for c <  2503   (len of minimal render)
+       deliver(c) = 2503                for 2503 <= c < 27803
+       deliver(c) = 27803               for c >= 27803  (len of the source)
+
+   The four configured values -- 4000, 6000, 8000, 12000 -- all lie strictly
+   inside the flat middle interval. So d(deliver)/d(cap) = 0 at every value the
+   project actually uses: the parameter cannot change any output it is set to.
+   This is stronger than "the caps differentiate nothing": they do not even
+   select between the two branches differently from one another.
+
+3. THE CRASH REGION. For any cap below the minimal render's own length,
+   `_render_universal_minimal` raises ValueError. 2000 is an entirely plausible
+   cap for a genuinely small-context model -- precisely the case the parameter
+   exists to serve. So the parameter is inert where it is used and raises where
+   it would matter. That asymmetry is the finding, not the cap values.
+
+4. SILENT DEFAULTING. Labels absent from `PHENOTYPE_TRANSFORMS` inherit the
+   8000 default with no diagnostic. Same failure shape as the realised
+   2026-08-30 incident recorded in `bench/reference_runner_v3.py` ("Fable had
+   no COMPOSER_MODEL_MAP entry and no .toml, so it composed to
+   FileNotFoundError -> 0 chars") -- a seat ran on an empty system prompt and
+   nothing said so.
+
+Every number printed is computed here from live code. Nothing is hardcoded
+except the interval endpoints of the sweep.
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import re
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO))
+
+from bench.cdsfl_registry.composer import (  # noqa: E402
+    DIRECTIVES_DIR,
+    PHENOTYPE_TRANSFORMS,
+    PhenotypeTransform,
+    _load_universal_directive,
+    _render_universal_minimal,
+)
+
+#: Labels carrying a PHENOTYPE_TRANSFORMS entry, plus live roster labels that do
+#: not. `None` is the no-model default path.
+PROBE_LABELS: tuple[object, ...] = (
+    "opus_4_6", "chatgpt_5_4", "codex_5_3", "gemini_3_1_pro", "deepseek_v3",
+    "fable", "Fable", "cc2", None,
+)
+
+#: Cap values to sweep. Chosen to bracket both discontinuities and to include
+#: every configured value, so the flat region is visible rather than asserted.
+SWEEP_CAPS: tuple[int, ...] = (
+    500, 1000, 2000, 2502, 2503, 2504, 3000,
+    4000, 6000, 8000, 12000, 20000, 27802, 27803, 27804, 30000, 50000,
+)
+
+_SWEEP_KEY = "__cap_sweep_probe__"
+
+
+def _sha(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()[:12]
+
+
+def _headings(text: str) -> list[str]:
+    return re.findall(r"^#{1,6} +(.*)$", text, flags=re.MULTILINE)
+
+
+def deliver_at_cap(cap: int) -> int | str:
+    """Deliver the universal directive with `max_directive_chars` set to `cap`.
+
+    Everything else is held fixed at a non-"minimal" format_style, so the only
+    live variable is the cap. Returns the delivered character count, or the
+    exception rendering if composition raised.
+    """
+    PHENOTYPE_TRANSFORMS[_SWEEP_KEY] = PhenotypeTransform(
+        max_directive_chars=cap, format_style="concise"
+    )
+    try:
+        return len(_load_universal_directive(_SWEEP_KEY).text)
+    except Exception as exc:                  # noqa: BLE001 - reported, not swallowed
+        return f"{type(exc).__name__}: {exc}"
+    finally:
+        PHENOTYPE_TRANSFORMS.pop(_SWEEP_KEY, None)
+
+
+def measure() -> dict:
+    core_path = DIRECTIVES_DIR / "universal" / "cdsfl_core_formal.md"
+    oper_path = DIRECTIVES_DIR / "universal" / "cdsfl_operational.md"
+    core = core_path.read_text(encoding="utf-8")
+    oper = oper_path.read_text(encoding="utf-8") if oper_path.exists() else ""
+
+    minimal = _render_universal_minimal()
+
+    per_seat = []
+    for label in PROBE_LABELS:
+        transform = PHENOTYPE_TRANSFORMS.get(label or "", PhenotypeTransform())
+        has_entry = (label or "") in PHENOTYPE_TRANSFORMS
+        text = _load_universal_directive(label).text
+        per_seat.append({
+            "label": "None (no-model default)" if label is None else label,
+            "has_transform_entry": has_entry,
+            "cap": transform.max_directive_chars,
+            "delivered_chars": len(text),
+            "sha12": _sha(text),
+            "headings_delivered": len(_headings(text)),
+        })
+
+    sweep = [{"cap": c, "delivered": deliver_at_cap(c)} for c in SWEEP_CAPS]
+
+    configured = sorted({t.max_directive_chars for t in PHENOTYPE_TRANSFORMS.values()}
+                        | {PhenotypeTransform().max_directive_chars})
+    delivered_at_configured = {c: deliver_at_cap(c) for c in configured}
+
+    return {
+        "core_chars": len(core),
+        "core_headings": len(_headings(core)),
+        "oper_chars": len(oper),
+        "minimal_chars": len(minimal),
+        "minimal_headings": len(_headings(minimal)),
+        "per_seat": per_seat,
+        "sweep": sweep,
+        "configured_caps": configured,
+        "delivered_at_configured": delivered_at_configured,
+        "distinct_renders": len({s["sha12"] for s in per_seat}),
+        "seats_without_entry": [s["label"] for s in per_seat
+                                if not s["has_transform_entry"]],
+    }
+
+
+def report(m: dict) -> None:
+    print("=" * 74)
+    print("max_directive_chars: TRANSFER FUNCTION AND INERTNESS")
+    print("=" * 74)
+    print(f"\ncdsfl_core_formal.md  : {m['core_chars']:,} chars, "
+          f"{m['core_headings']} headings")
+    print(f"cdsfl_operational.md  : {m['oper_chars']:,} chars")
+    print(f"minimal render        : {m['minimal_chars']:,} chars, "
+          f"{m['minimal_headings']} headings")
+
+    print("\n-- 1. DELIVERY PER SEAT (live composer call) " + "-" * 29)
+    print(f"{'label':26s} {'entry':>6s} {'cap':>7s} {'delivered':>10s} "
+          f"{'sha12':>14s} {'hdgs':>5s}")
+    for s in m["per_seat"]:
+        print(f"{s['label']:26s} {str(s['has_transform_entry']):>6s} "
+              f"{s['cap']:>7d} {s['delivered_chars']:>10d} "
+              f"{s['sha12']:>14s} {s['headings_delivered']:>5d}")
+    print(f"\n  distinct renders across {len(m['per_seat'])} seats: "
+          f"{m['distinct_renders']}")
+    print(f"  seats silently inheriting the default: {m['seats_without_entry']}")
+
+    print("\n-- 2. CAP SWEEP: delivered chars as a function of the cap " + "-" * 16)
+    for row in m["sweep"]:
+        print(f"  cap={row['cap']:>7} -> {row['delivered']}")
+
+    print("\n-- 3. THE PARAMETER AT ITS CONFIGURED VALUES " + "-" * 29)
+    for cap, delivered in sorted(m["delivered_at_configured"].items()):
+        print(f"  cap={cap:>7} -> {delivered}")
+    values = list(m["delivered_at_configured"].values())
+    inert = len(set(values)) == 1
+    print(f"\n  configured values: {m['configured_caps']}")
+    print(f"  distinct outputs over configured values: {len(set(values))}")
+    print(f"  VERDICT: parameter is {'INERT' if inert else 'LIVE'} over its "
+          f"configured range")
+
+    print("\n-- 4. DERIVED STEP FUNCTION " + "-" * 46)
+    lo, hi = m["minimal_chars"], m["core_chars"]
+    print(f"  deliver(c) = ValueError   for c <  {lo}")
+    print(f"  deliver(c) = {lo}         for {lo} <= c < {hi}")
+    print(f"  deliver(c) = {hi}        for c >= {hi}")
+    print(f"  All configured caps lie in [{lo}, {hi}) -> d(deliver)/d(cap) = 0")
+
+    print("\n" + "=" * 74)
+    if inert:
+        print("CONCLUSION: `max_directive_chars` carries 4 distinct configured")
+        print("values and 1 distinct behaviour. It is an addition nothing")
+        print("reaches, in the sense the additive standard names. A removal is")
+        print("EVIDENCED by this measurement rather than judged -- but see")
+        print("bench/tests/test_falsifier_directive_cap_inert_2026-10-14.py for")
+        print("the property that must hold AFTER any removal.")
+    else:
+        print("CONCLUSION: the parameter is live; the inertness claim is REFUTED.")
+    print("=" * 74)
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(
+        description="Measure whether max_directive_chars affects any output.",
+    )
+    ap.add_argument("--json", action="store_true", help="emit raw JSON instead")
+    args = ap.parse_args(argv)
+    m = measure()
+    if args.json:
+        import json
+        print(json.dumps(m, indent=2, default=str))
+    else:
+        report(m)
+    return 0
+
+
+if __name__ == "__main__":
