+#: COMPOSER_MODEL_MAP's consumers rather than inside it, because this list is
+#: the AUDIT domain (what must be accounted for) and that map is the RESOLUTION
+#: table (what each label becomes). Conflating them is what let `Fable` through.
+KNOWN_SEAT_LABELS: tuple[str, ...] = (
+    "CC2", "Codex", "CX", "ChatGPT", "Gemini", "DeepSeek", "Fable",
+)
 
 
+def directive_delivery_record(model: str | None = None) -> dict:
+    """Report what Layer 1 directive text a seat ACTUALLY receives, and why.
+
+    Pure observation: calls the same loader the dispatch path calls and
+    measures its output. Changes no delivery behaviour, so it cannot alter a
+    run it is added to.
+
+    This exists because the reduction was unobservable. On 2026-10-13 a guard
+    test established that every seat receives 2,503 of the core directive's
+    27,803 characters with 0 of its 16 headings surviving, and nothing in the
+    repository reported that. The realised cost of the same blind spot is on
+    record at `bench/reference_runner_v3.py` for 2026-08-30: a seat composed to
+    0 characters and the run completed without saying so.
+
+    Fields, each a measurement rather than a setting:
+
+      source_chars        length of the directive source on disk
+      delivered_chars     length of what this seat receives
+      source_headings     markdown headings in the source
+      delivered_headings  markdown headings surviving in the delivery
+      reduced             True iff delivered text != source text
+      cap                 this seat's max_directive_chars
+      cap_was_decisive    True iff the cap (not format_style) selected the
+                          reduced render. False when format_style=="minimal"
+                          would have selected it anyway -- which distinguishes
+                          a cap that did something from one that merely agreed.
+      cap_is_inert        True iff delivery is unchanged across the whole
+                          interval [len(minimal), len(source)). When True the
+                          cap's VALUE cannot have affected this delivery.
+      has_transform_entry False iff this label silently inherited the default.
+      error               set instead of the above if composition RAISED. A
+                          cap below the minimal render's own length raises
+                          ValueError; recording it here keeps that failure
+                          loud instead of surfacing as a short prompt.
+    """
+    formal_path = DIRECTIVES_DIR / "universal" / "cdsfl_core_formal.md"
+    prose_path = DIRECTIVES_DIR / "universal" / "cdsfl_core.txt"
+    path = formal_path if formal_path.exists() else prose_path
+    source = path.read_text(encoding="utf-8") if path.exists() else ""
+
+    key = model or ""
+    has_entry = key in PHENOTYPE_TRANSFORMS
+    transform = PHENOTYPE_TRANSFORMS.get(key, PhenotypeTransform())
+
+    record = {
+        "model": model,
+        "source_path": str(path),
+        "source_chars": len(source),
+        "source_headings": len(_MD_HEADING_RE.findall(source)),
+        "cap": transform.max_directive_chars,
+        "format_style": transform.format_style,
+        "has_transform_entry": has_entry,
+    }
+
+    try:
+        delivered = _load_universal_directive(model).text
+    except Exception as exc:                  # noqa: BLE001 - recorded, not swallowed
+        record["error"] = f"{type(exc).__name__}: {exc}"
+        return record
+
+    try:
+        minimal_len = len(_render_universal_minimal())
+    except Exception:                         # noqa: BLE001
+        minimal_len = None
+
+    record.update({
+        "delivered_chars": len(delivered),
+        "delivered_headings": len(_MD_HEADING_RE.findall(delivered)),
+        "reduced": delivered != source,
+        "cap_was_decisive": (
+            transform.format_style != "minimal"
+            and len(source) > transform.max_directive_chars
+        ),
+        "cap_is_inert": (
+            minimal_len is not None
+            and minimal_len <= transform.max_directive_chars < len(source)
+        ),
+        "error": None,
+    })
+    return record
+
+
+def directive_delivery_audit(
+    labels: Sequence[str] | None = None,
+) -> dict:
+    """Audit Layer 1 delivery across every seat label, resolving each one first.
+
+    `labels` defaults to KNOWN_SEAT_LABELS. Each label is resolved through
+    COMPOSER_MODEL_MAP exactly as `compose_for_dispatch` resolves it, so the
+    audit measures the dispatch path rather than a parallel reimplementation of
+    it -- the producer/consumer agreement this project requires.
+
+    Returns the per-label records plus three roll-ups a run should refuse on:
+      unmapped          labels COMPOSER_MODEL_MAP does not resolve
+      silently_defaulted labels with no PHENOTYPE_TRANSFORMS entry
+      errored           labels whose composition raised
+    """
+    seats = tuple(labels) if labels is not None else KNOWN_SEAT_LABELS
+    records = {}
+    for label in seats:
+        resolved = COMPOSER_MODEL_MAP.get(label, label)
+        rec = directive_delivery_record(resolved)
+        rec["seat_label"] = label
+        rec["resolved_to"] = resolved
+        rec["unmapped"] = label not in COMPOSER_MODEL_MAP
+        records[label] = rec
+
+    return {
+        "records": records,
+        "unmapped": [l for l, r in records.items() if r["unmapped"]],
+        "silently_defaulted": [l for l, r in records.items()
+                               if not r["has_transform_entry"]],
+        "errored": [l for l, r in records.items() if r.get("error")],
+        "distinct_delivered_chars": sorted(
+            {r["delivered_chars"] for r in records.values()
+             if r.get("delivered_chars") is not None}
+        ),
+    }
+
+
 def _load_domain_directive(
     domain: str, variant: str | None = None
 ) -> DirectivePacket | None:

