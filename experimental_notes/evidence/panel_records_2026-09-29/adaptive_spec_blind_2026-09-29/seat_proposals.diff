+    if ok:
+        FAILED.append(2)
+        print("  FALSIFIED")
+
+
+# ---------------------------------------------------------------- CHECK 3
+def check3_branch_quantity_rank_inversion():
+    banner(3, "spec ranks candidates on the wrong branch quantity")
