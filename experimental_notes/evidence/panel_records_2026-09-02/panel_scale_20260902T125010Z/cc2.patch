             "Seat3": "bare_system", "Seat4": "bare_system",
             "Seat5": "tool_loop_forced", "Seat6": "tool_loop_forced"}
IDENTITY = {s: "Codex" for s in SEATS}
P_CONFIRM = 0.90            # routing.py's own Exp-42 figure for Codex
TRIALS = 20000


def rank_by_condition(labels, condition_of, exclude=()):
    """Design (b): order seats so consecutive rungs never share a condition.

    Same contract as rank_falsifier_writers -- an ordering of labels. It decides
    only WHO IS ASKED NEXT. It is not a vote, sets no verdict, and the decider
    is still reverify_fn.
    """
    buckets = collections.OrderedDict()
    for m in labels:
        if m in exclude:
            continue
        buckets.setdefault(condition_of.get(m, "?"), []).append(m)
    out, queues = [], list(buckets.values())
    while any(queues):
        for q in queues:
            if q:
                out.append(q.pop(0))
    return out


def trial(rungs, rho, rng, max_rungs=2):
    """One finding through the real ladder. Draws are correlated by rho.

    rho is the probability that rung 2's draw is FORCED EQUAL to rung 1's --
    the standard correlated-Bernoulli construction. rho=1 => rung 2 is a carbon
    copy and adds nothing; rho=0 => independent.
    """
    first = {}

    def resolve_fn(model, finding):
        return f"def t_{model}(): pass"

    def reverify_fn(code):
        model = code.split("_", 1)[1].split("(")[0]
        draw = rng.random() < P_CONFIRM
        if not first:
            first["v"] = draw
            return "CONFIRMED" if draw else "REFUTED"
        if rng.random() < rho:
            draw = first["v"]          # correlated with the first attempt
        return "CONFIRMED" if draw else "REFUTED"

    r = resolve_via_routing({"finding_id": "F"}, rungs, resolve_fn, reverify_fn,
                            max_rungs=max_rungs)
    return r.resolved, r.rungs_tried


