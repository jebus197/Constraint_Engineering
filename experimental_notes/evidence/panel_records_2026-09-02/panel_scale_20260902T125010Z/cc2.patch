        assert "mp.Process(" in src, "dispatch no longer uses mp.Process"
        assert mp.get_start_method() == "spawn", (
            f"start method is {mp.get_start_method()!r}, not 'spawn'. The "
            f"parent-arming failure below is platform-conditional; re-measure.")

