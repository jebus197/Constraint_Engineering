"""The meter must survive the boundary the runner actually dispatches across.

`bench/dispatch_meter.arm()` patches two SDK primitives IN THE CALLING PROCESS.
`runner_core.dispatch()` makes the model call in an `mp.Process`
(runner_core.py:1408) and this platform's start method is SPAWN, so the child is
a fresh interpreter that re-imports the SDK UNPATCHED.

A meter armed only in the parent therefore records ZERO for every ordinary
dispatch while passing every unit test it has -- a confident, well-tested, empty
meter. That is the failure mode this file exists to make impossible, and it is
the same shape as the `cost_ledger` wiring gap the meter's own docstring
criticises, one layer further in.

These tests pin BEHAVIOUR across a real process boundary, not the presence of a
string in a source file.
"""
from __future__ import annotations

import multiprocessing as mp
import pathlib
import sys

import pytest

REPO = pathlib.Path(__file__).resolve().parents[2]
sys.path.insert(0, str(REPO))
sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "_meterfix"))

from bench import dispatch_meter as M  # noqa: E402


def _child_unarmed(q):
    """What the child does today: parent-side patch does not exist here."""
    sys.path.insert(0, str(REPO))
    sys.path.insert(0, str(REPO / "bench" / "tests" / "_meterfix"))
    import fake_sdk
    from bench import dispatch_meter as CM
    fake_sdk.Completions().create()
    q.put(("ok", "text", CM.drain()))


def _child_armed(q):
    """The contract: arm INSIDE the child, carry rows home on the queue."""
    sys.path.insert(0, str(REPO))
    sys.path.insert(0, str(REPO / "bench" / "tests" / "_meterfix"))
    import fake_sdk
    from bench import dispatch_meter as CM
    CM._ARMED = True
    _orig = fake_sdk.Completions.create

    def _patched(self, *a, **kw):
        r = _orig(self, *a, **kw)
        CM.note(r, primitive="fake.create")
        return r

    fake_sdk.Completions.create = _patched
    fake_sdk.Completions().create()
    q.put(("ok", "text", CM.drain()))


def _run(target):
    ctx = mp.get_context("spawn")          # pin SPAWN; do not inherit fork by luck
    q = ctx.Queue()
    p = ctx.Process(target=target, args=(q,))
    p.start()
    out = q.get(timeout=60)
    p.join(timeout=60)
    return out


