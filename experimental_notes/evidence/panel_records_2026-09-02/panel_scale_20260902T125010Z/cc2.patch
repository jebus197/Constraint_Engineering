from __future__ import annotations

import threading
import time
from typing import Any, Dict, List, Optional

#: Per-process accumulator. `dispatch()` runs one call per child process on the
#: primary path, but `decomposed_dispatch` makes several calls IN PROCESS, so
#: this accumulates and is drained rather than overwritten.
_ROWS: List[Dict[str, Any]] = []
_LOCK = threading.Lock()
_ARMED = False
_PATCHED: List[tuple] = []


def _usage_of(response: Any) -> Optional[Dict[str, int]]:
    """Provider-reported token counts, or None. Never raises, never guesses."""
    try:
        u = getattr(response, "usage", None)
        if u is not None:
            got = {
                "input_tokens": getattr(u, "prompt_tokens", None),
                "output_tokens": getattr(u, "completion_tokens", None),
                "total_tokens": getattr(u, "total_tokens", None),
            }
            # OpenRouter returns the real charged cost when the request asked
            # for it (`extra_body={"usage": {"include": True}}`). That is an
            # INVOICE figure, not an estimate, so it is kept under its own key
            # and never mixed with anything derived.
            cost = getattr(u, "cost", None)
            if cost is not None:
                got["provider_cost_usd"] = float(cost)
            if any(v is not None for v in got.values()):
                return {k: v for k, v in got.items() if v is not None}
        m = getattr(response, "usage_metadata", None)
        if m is not None:
            got = {
                "input_tokens": getattr(m, "prompt_token_count", None),
                "output_tokens": getattr(m, "candidates_token_count", None),
                "total_tokens": getattr(m, "total_token_count", None),
            }
            if any(v is not None for v in got.values()):
                return {k: v for k, v in got.items() if v is not None}
    except Exception:                                    # noqa: BLE001
        return None
    return None


def note(response: Any, *, primitive: str) -> None:
    """Record one provider response. Never raises; a meter must not fell a run."""
    try:
        if not _ARMED:
            return
        usage = _usage_of(response)
        with _LOCK:
            _ROWS.append({
                "primitive": primitive,
                "model": str(getattr(response, "model", "") or ""),
                "provider_usage": usage,
                "unmetered_reason": (
                    None if usage else
                    "the provider returned no usage on this response"),
                "ts": int(time.time()),
            })
    except Exception:                                    # noqa: BLE001
        pass


def drain() -> List[Dict[str, Any]]:
    """Take the rows recorded so far and clear the accumulator."""
    with _LOCK:
        rows, _ROWS[:] = list(_ROWS), []
    return rows


def note_rows(rows: Any) -> int:
    """Replay rows drained in a CHILD process into this process's accumulator.

    The counterpart to the `arm()`-in-the-child contract described above. It
    takes already-formed rows -- plain dicts of provider-reported integers --
    because a response object cannot cross a process boundary and must not be
    asked to.

    Deliberately NOT gated on `_ARMED`. The parent may never arm (it makes no
    SDK calls itself), and dropping the child's real measurements because the
    parent had nothing to patch is exactly the silent-zero failure this module
    exists to avoid. Returns the number of rows accepted, so a caller can assert
    on it rather than trust it.
    """
    if not rows:
        return 0
    accepted = [r for r in rows if isinstance(r, dict)]
    if not accepted:
        return 0
    with _LOCK:
        _ROWS.extend(accepted)
    return len(accepted)


def coverage() -> Dict[str, str]:
    """Which live routes this meter can and cannot see. Stated, not implied."""
    return {
        "openrouter": "COVERED (openai SDK usage)",
        "deepseek": "COVERED (openai SDK usage)",
        "google": "COVERED (google-genai usage_metadata)",
        "claude_cli": "NOT METERED BY DESIGN (Max subscription, no per-use charge)",
        "codex_exec": ("NOT COVERED — subprocess stdout carries no usage; "
                       "needs a structured-output flag on call_codex"),
    }


def arm(*, simulated: bool) -> Dict[str, Any]:
    """Install the meter. Returns what it did, so the report can say so.

    SILENT IN SIMULATED MODE means NOTHING IS INSTALLED. Determine `simulated`
    with `reference_runner_v3.run_is_simulated(cfg)`, which keys on the
    mandatory `-SIM` seat suffix (founder ruling 2026-08-08) and is the only
    authoritative signal at run scope.

    NOTE the landmine this avoids: `cost_ledger.UNMETERED_ROUTES` is
    `{"claude_cli"}` and treats every unknown route as METERED on purpose, so a
    naive wiring would have counted every simulated dispatch as paid — the exact
    opposite of the ruling. Gating at arm time, not at record time, makes that
    impossible rather than merely unlikely.
    """
    global _ARMED
    if simulated:
        return {"armed": False, "reason": "simulated run — nothing installed",
                "patched": []}
    if _ARMED:
        return {"armed": True, "reason": "already armed", "patched":
                [p[3] for p in _PATCHED]}
    patched = []
    try:
        from openai.resources.chat import completions as _oc
        _orig = _oc.Completions.create

        def _create(self, *a, **kw):
            r = _orig(self, *a, **kw)
            note(r, primitive="openai.chat.completions.create")
            return r

        _oc.Completions.create = _create
        _PATCHED.append((_oc.Completions, "create", _orig,
                         "openai.chat.completions.create"))
        patched.append("openai.chat.completions.create")
    except Exception as exc:                             # noqa: BLE001
        patched.append(f"openai UNAVAILABLE: {type(exc).__name__}")
    try:
        from google.genai import models as _gm
        _orig_g = _gm.Models.generate_content

        def _gen(self, *a, **kw):
            r = _orig_g(self, *a, **kw)
            note(r, primitive="google.genai.models.generate_content")
            return r

        _gm.Models.generate_content = _gen
        _PATCHED.append((_gm.Models, "generate_content", _orig_g,
                         "google.genai.models.generate_content"))
        patched.append("google.genai.models.generate_content")
    except Exception as exc:                             # noqa: BLE001
        patched.append(f"google-genai UNAVAILABLE: {type(exc).__name__}")
    _ARMED = True
    return {"armed": True, "patched": patched, "coverage": coverage()}


def disarm() -> None:
    """Restore every patched primitive. Used by tests and by a clean shutdown."""
    global _ARMED
    # RESTORE the original, never `delattr`. The wrapper REPLACED a method
    # defined on that same class, so deleting the attribute would delete the
    # real method with it and leave the SDK broken for the rest of the process.
    for owner, name, original, _label in reversed(_PATCHED):
        try:
            setattr(owner, name, original)
        except Exception:                                # noqa: BLE001
            pass
    _PATCHED.clear()
    _ARMED = False
    drain()

