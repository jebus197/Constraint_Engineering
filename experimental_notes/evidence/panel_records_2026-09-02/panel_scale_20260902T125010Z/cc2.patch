from bench.routing import rank_falsifier_writers, resolve_via_routing  # noqa: E402

MULTI = ["CC2", "ChatGPT", "Codex", "DeepSeek", "Gemini"]
SEATS = ["Seat1", "Seat2", "Seat3", "Seat4", "Seat5", "Seat6"]
