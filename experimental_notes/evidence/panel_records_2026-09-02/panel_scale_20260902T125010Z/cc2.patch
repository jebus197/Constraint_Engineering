#!/usr/bin/env python3
"""The saturation curve the founder withdrew, rebuilt on co-discovery edges.

WHY IT WAS WITHDRAWN, AND WHY IT IS NOW COMPUTABLE
--------------------------------------------------
Partitioning archived findings by `source_model` gives DISJOINT sets: every
canonical finding has exactly one source model, so "defects found by k models"
is a sum of k disjoint counts and the curve is linear BY CONSTRUCTION. The
founder measured the schema, correctly withdrew the result, and named the cause.

Once cross-model co-discovery edges exist (scripts/codiscovery_link.py), two
findings by two models can be ONE defect, the sets overlap, and the curve can
bend. That bend is the entire quantity of interest.

WHAT THIS MEASURED, 2026-09-02 -- READ THIS BEFORE QUOTING THE TOOL
-------------------------------------------------------------------
The curve BARELY BENDS on code targets and bends SHARPLY on prose targets:

    all 23 five-model real runs, outcome tier   k=1 21.7%  (linear would be 20.0%)
    exp48_chemistry (a .md exam)                k=1 39.0%  33 findings ->  16 defects
    exp49_engineering (a .md exam)              k=1 33.0%  33 findings ->  20 defects
    every .py target                            k=1 20-22% 1.00-1.09 findings/defect

So on a Python module the five models are still very nearly disjoint, and the
honest reading is that the aggregate curve remains close to linear. The two
targets where a second seat measurably re-finds what the first found are the two
PROSE STEM DOCUMENTS -- which is the artefact class CDSFL exists to review.

WHY THE OUTCOME TIER ONLY
-------------------------
`same_computed_outcome` measured 13/13 = 100% [77.2%, 100%] precision against a
blind adjudication, and an INDEPENDENT three-reader replication on 2026-09-02
returned 13/13 again. `signature_merge` measured 47.1% (fable) and 52.4% (this
replication) against a 21.4% base rate. Folding the loose tier in merges
distinct defects and OVERSTATES saturation -- i.e. it argues against buying
another seat, which is the expensive direction to be wrong in. Run
`--tiers same_computed_outcome,signature_merge` to see that sensitivity: it
moves k=1 from 21.7% to 24.1%, and does not change the conclusion.

NOT A VOTE
----------
Components change no finding's status, severity, verdict or falsifier result,
and nothing here feeds convergence. This answers one question -- how much of the
defect space a k-th seat RE-FINDS rather than ADDS -- and nothing else. Truth
still comes only from a falsifier that fires on the artefact and stays quiet on
the corrected copy.

THE CEILING IS THE PANEL, NOT THE ARTEFACT
------------------------------------------
The curve saturates toward the defects THIS panel found, not toward all defects
in the artefact. k=5 is 100% by definition. It bounds marginal return WITHIN an
observed panel; it cannot see what all five models missed, and no rearrangement
of this archive can.

USAGE
-----
    python3 scripts/codiscovery_link.py --population critical --json /tmp/edges.json
    python3 scripts/saturation_curve.py --edges /tmp/edges.json
"""
from __future__ import annotations

import argparse
import collections
import importlib.util
import itertools
import json
import pathlib
import sys

REPO = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO))

HIGH_PRECISION_TIERS = ("same_computed_outcome",)


class DSU:
    """Union-find. Components of the co-discovery graph are distinct defects."""

    def __init__(self) -> None:
        self.p: dict = {}

    def find(self, x):
        self.p.setdefault(x, x)
        while self.p[x] != x:
            self.p[x] = self.p[self.p[x]]
            x = self.p[x]
        return x

    def union(self, a, b) -> None:
        ra, rb = self.find(a), self.find(b)
        if ra != rb:
            self.p[ra] = rb


def _archive_runs():
    """(dir name, registry entries) for de-duplicated REAL runs."""
    spec = importlib.util.spec_from_file_location(
        "lca", str(REPO / "scripts" / "latent_control_audit.py"))
    lca = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(lca)
    seen, out = set(), []
    for fp in sorted((REPO / "bench" / "logs").glob("**/*_report.json")):
        try:
            d = json.loads(fp.read_text(encoding="utf-8", errors="ignore"))
        except Exception:                                    # noqa: BLE001
            continue
        if not isinstance(d, dict):
            continue
        reg = d.get("registry")
        if not (isinstance(reg, dict) and reg.get("entries")):
            continue
        if lca._is_simulated(d, fp):
            continue
        ent = reg["entries"]
        # A run directory can appear twice; key on registry CONTENT, not path.
        key = json.dumps(sorted(ent)) + json.dumps(
            [ent[x].get("description", "")[:80] for x in sorted(ent)])
        if key in seen:
            continue
        seen.add(key)
        out.append((fp.parent.name, d, ent))
    return out


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--edges", default="/tmp/edges.json",
                    help="output of `codiscovery_link.py --json`")
    ap.add_argument("--tiers", default=",".join(HIGH_PRECISION_TIERS),
                    help="comma-separated tiers to treat as co-discovery")
    ap.add_argument("--min-models", type=int, default=5)
    args = ap.parse_args()

    tiers = tuple(t for t in args.tiers.split(",") if t)
    edges_by_run = json.loads(pathlib.Path(args.edges).read_text())["edges"]

    from bench.convergence_location import _gate_population        # noqa: E402

    agg, per_run = collections.defaultdict(list), []
    for name, _d, ent in _archive_runs():
        pop = _gate_population(list(ent.values()))
        nodes = {e.get("canonical_id"): e.get("source_model", "") for e in pop
                 if e.get("canonical_id") and e.get("source_model")}
        models = set(nodes.values())
        if len(models) < args.min_models or len(nodes) < 2:
            continue
        dsu = DSU()
        for n in nodes:
            dsu.find(n)
        for e in edges_by_run.get(name, []):
            if e.get("tier") in tiers and e["a"] in nodes and e["b"] in nodes:
                dsu.union(e["a"], e["b"])
        comp = collections.defaultdict(set)
        for n, m in nodes.items():
            comp[dsu.find(n)].add(m)
        nc = len(comp)
        curve = {}
        for k in range(1, len(models) + 1):
            subs = list(itertools.combinations(sorted(models), k))
            curve[k] = sum(sum(1 for ms in comp.values() if ms & set(s))
                           for s in subs) / len(subs)
        per_run.append((name, len(nodes), nc, curve))
        for k, v in curve.items():
            agg[k].append(v / nc)

    print(f"tiers={tiers}  runs={len(per_run)}  (real, >=5 models, critical)")
    print()
    print(f"{'run':50} {'find':>5} {'defects':>8}   " +
          "   ".join(f"k={k}" for k in range(1, 6)))
    for name, nf, nc, c in per_run:
        print(f"{name[:50]:50} {nf:5} {nc:8}  " +
              "  ".join(f"{c[k] / nc:.2f}" for k in range(1, 6) if k in c))

    print()
    print("MEAN FRACTION OF THIS PANEL'S DISTINCT DEFECTS COVERED BY k MODELS")
    print(f"  {'k':>3} {'coverage':>9} {'marginal':>9} {'linear k/5':>11} {'bend':>8}")
    prev = 0.0
    for k in sorted(agg):
        mean = sum(agg[k]) / len(agg[k])
        print(f"  {k:3d} {mean * 100:8.1f}% {(mean - prev) * 100:8.1f}% "
              f"{k / 5 * 100:10.1f}% {(mean - k / 5) * 100:7.1f}pp")
        prev = mean
    print()
    print("  BEND is the whole result. Under the pre-edge disjoint schema it is")
    print("  0.0pp at every k by construction. A bend that stays near zero means")
    print("  the seats really are near-disjoint on that target -- a finding, not")
    print("  a failure of the linker.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

