                    "Seat3": "bare_system", "Seat4": "bare_system",
                    "Seat5": "tool_loop_forced", "Seat6": "tool_loop_forced"}

def rank_by_condition(labels, condition_of, exclude=()):
    """Round-robin the seats so consecutive rungs never share a condition.

    This is rank_falsifier_writers' contract -- an ordering of labels -- over a
    different axis. It is NOT a vote and touches no verdict: it only decides who
    is ASKED next. The decider is still reverify_fn.
    """
    buckets = collections.OrderedDict()
    for m in labels:
        if m in exclude:
            continue
        buckets.setdefault(condition_of.get(m, "?"), []).append(m)
    out, queues = [], list(buckets.values())
    while any(queues):
        for q in queues:
            if q:
                out.append(q.pop(0))
    return out

