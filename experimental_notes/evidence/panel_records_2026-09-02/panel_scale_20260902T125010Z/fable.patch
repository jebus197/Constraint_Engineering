#!/usr/bin/env python3
"""Usage metering for paid dispatches (founder ruling 2026-09-02).

THE RULING, verbatim in effect: relevant only on paid runs; DEFAULT ON,
because a meter that is off by default is one nobody remembers to switch on;
it must emit NOTHING in simulated mode; the user-facing toggle waits for the
CDSFL UX and does not exist yet, so there is deliberately no config flag here.

WHAT THIS IS. One JSONL line per paid dispatch, appended at the single
chokepoint every paid call passes through (runner_core.dispatch_to_model).
It records enough for a FUTURE ALLOCATOR to compute cost per confirmed
defect per seat per condition -- the join keys are the point:

    ts            wall-clock ISO timestamp
    experiment    run name when the runner has told the meter (set_context)
    round         round index when known
    purpose       "round" | "routing" | "sweep" | ... (caller-declared)
    seat          panel label as dispatched
    identity      model_id@api -- the same identity key the registry uses,
                  so metering rows join to seat_model_map and panel_mode
    finding_id    set for routing rungs, so cost joins to the finding and
                  from there to co_discovery groups and falsifier verdicts
    condition     instruction condition when routing supplies one (0C.48)
    prompt_chars / system_chars / response_chars
    est_tokens    chars / 3.5 -- the runner's own conservative estimate; a
                  provider-reported usage field should REPLACE this when the
                  dispatch layer exposes one (record actuals, not estimates)
    elapsed_s

WHAT THIS IS NOT. Not a cost gate, not an allocator, not a toggle. It never
raises: a meter must not fell a run.

Token estimates are labelled estimates. Turning them into money needs a price
table, which changes monthly and belongs to the UX layer, not here.
"""
from __future__ import annotations

import json
import os
import pathlib
import threading
from datetime import datetime, timezone
from typing import Any, Dict, Optional

_REPO = pathlib.Path(__file__).resolve().parent.parent
_LOCK = threading.Lock()
_CONTEXT: Dict[str, Any] = {}


def set_context(**kw) -> None:
    """Runner-supplied join keys (experiment name, round, purpose...).

    Optional by design: metering works with no context at all, so the default
    really is ON rather than on-when-someone-remembered."""
    with _LOCK:
        _CONTEXT.update({k: v for k, v in kw.items() if v is not None})


def _sink() -> pathlib.Path:
    p = os.environ.get("CDSFL_METER_PATH")
    if p:
        return pathlib.Path(p)
    return (_REPO / "logs" / "metering"
            / f"usage_{datetime.now(timezone.utc):%Y%m}.jsonl")


def is_simulated_dispatch(model_config) -> bool:
    """True when this dispatch is a rehearsal, which must not be metered.

    Keyed on the authoritative signals, not on text: the ``sim`` api and the
    mandatory ``-SIM`` label suffix (founder ruling 2026-08-08)."""
    api = str(getattr(model_config, "api", "") or "").strip().lower()
    label = str(getattr(model_config, "label", "") or "").strip()
    return api == "sim" or label.upper().endswith("-SIM")


def record_dispatch(model_config, prompt: str, cdsfl_text: str,
                    response: Optional[str], elapsed_s: float,
                    purpose: Optional[str] = None,
                    finding_id: Optional[str] = None,
                    condition: Optional[str] = None) -> None:
    """Append one usage line. Silent in simulated mode; never raises."""
    try:
        if is_simulated_dispatch(model_config):
            return
        chars = len(prompt or "") + len(cdsfl_text or "")
        row = {
            "ts": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            **{k: _CONTEXT.get(k) for k in ("experiment", "round", "purpose")},
            "seat": getattr(model_config, "label", None),
            "identity": (f"{getattr(model_config, 'model_id', '?')}@"
                         f"{getattr(model_config, 'api', '') or '?'}"),
            "prompt_chars": len(prompt or ""),
            "system_chars": len(cdsfl_text or ""),
            "response_chars": len(response or ""),
            "est_tokens": round(chars / 3.5),
            # INPUT-side estimate only (prompt+system). Output tokens price
            # differently at every vendor, so they are estimated separately
            # rather than folded into one number that maps to no price line.
            "est_output_tokens": round(len(response or "") / 3.5),
