#!/usr/bin/env python3
"""Co-discovery over the real archive: recorded vs detectable (0C.49).

BEFORE (the schema as minted): a finding is "raised by more than one model"
only if its source_aliases carry another model's alias. Measured over all 29
real runs / 2,050 findings: ZERO. (The two entries the runway note counted are
`Model:Model_Fnnn` same-model aliases in a colon format, not co-discovery.)

AFTER: link_co_discovery() over the same registries. Rules and operating
points are documented on the function; links are candidates, never truth.
"""
import json, math, pathlib, sys
REPO = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO)); sys.path.insert(0, str(REPO / "bench"))
from scripts.latent_control_audit import _is_simulated  # noqa: E402
import reference_runner_v3 as R  # noqa: E402


def wilson(k, n, z=1.959964):
    if not n: return (0.0, 0.0)
    p = k / n; den = 1 + z * z / n
    c = (p + z * z / (2 * n)) / den
    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    return 100 * (c - h), 100 * (c + h)


def real_reports():
    for fp in sorted((REPO / "bench" / "logs").rglob("*report*.json")):
        try:
            d = json.loads(fp.read_text(errors="ignore"))
        except Exception:
            continue
        if not isinstance(d, dict) or _is_simulated(d, fp):
            continue
        reg = d.get("registry")
        if isinstance(reg, dict) and reg.get("entries"):
            yield fp, d, reg


def main():
    total = marked = 0; groups = 0; before = 0
    by_rule = {}
    rows = []
    for fp, d, reg_dict in real_reports():
        models = [m if isinstance(m, str) else m.get("name", "")
                  for m in (d.get("models") or [])]
        reg = R.FindingRegistry.from_dict(reg_dict)
        n = len(reg.entries)
        # BEFORE: cross-model aliases as recorded.
        for e in reg.entries.values():
            ms = {e.get("source_model")} | {
                next((m for m in models if a == m or a.startswith(m + "_")), None)
                for a in (e.get("source_aliases") or [])}
            ms.discard(None)
            if len(ms) > 1:
                before += 1
        out = R.link_co_discovery(reg)
        total += n; marked += out["marked"]; groups += len(out["groups"])
        for e in out["edges"]:
            by_rule[e["rule"]] = by_rule.get(e["rule"], 0) + 1
        if out["marked"]:
            rows.append((fp.parent.name, n, out["marked"], len(out["groups"])))
    lo, hi = wilson(before, total)
    print(f"BEFORE  recorded co-discovery: {before}/{total} "
          f"= {100*before/total:.2f}%  Wilson [{lo:.2f}%, {hi:.2f}%]")
    lo, hi = wilson(marked, total)
    print(f"AFTER   linked co-discovery:   {marked}/{total} "
          f"= {100*marked/total:.2f}%  Wilson [{lo:.2f}%, {hi:.2f}%] "
          f"in {groups} groups")
    print(f"edges by rule: {by_rule}")
    print("caveat: fix_overlap precision 85.7% [70.6%, 93.7%], recall 71.4% "
          "(run --calibrate to regenerate) -- links are candidates, not truth")
    for r in sorted(rows, key=lambda x: -x[2]):
        print(f"  {r[0]}: {r[2]}/{r[1]} findings in {r[3]} group(s)")


def calibrate():
    """Re-derive the fix_overlap operating point from committed artefacts.

    Truth = the final `label` field of similarity_pairs_adjudicated_2026-08-31
    (True/False; None = unlabelled, excluded). Cross-model membership and
    proposed-fix text come from each run's archived registry. Every number in
    the CO_DISCOVERY_FIX_OVERLAP_THRESHOLD docstring regenerates from here --
    if this output and that docstring ever disagree, the docstring is stale.
    """
    import re
    pairs_doc = json.loads((REPO / "experimental_notes" / "data" /
                            "similarity_pairs_adjudicated_2026-08-31.json").read_text())
    ent = {}
    for fp, d, reg in real_reports():
        run = fp.parent.name.split("_")[0]
        for cid, e in reg["entries"].items():
            ent.setdefault((run, cid), e)
    _IDENT = re.compile(r"[A-Za-z_][A-Za-z0-9_]{2,}")
    _STOP = frozenset(
        "def return import from self None True False assert print for while "
        "if else elif not and or in is try except raise with as class "
        "lambda".split())
    def toks(t):
        return frozenset(x for x in _IDENT.findall(t or "") if x not in _STOP)
    thr = R.CO_DISCOVERY_FIX_OVERLAP_THRESHOLD
    n = same = links = tp = fn = 0
    for r in pairs_doc["pairs"]:
        a, b = ent.get((r["run"], r["a"])), ent.get((r["run"], r["b"]))
        if not a or not b or r["label"] is None: continue
        if a.get("source_model") == b.get("source_model"): continue
        n += 1; same += bool(r["label"])
        ta, tb = toks(a.get("proposed_fix")), toks(b.get("proposed_fix"))
        fires = len(ta) >= 10 and len(tb) >= 10 and len(ta & tb) / len(ta | tb) >= thr
        if fires:
            links += 1; tp += bool(r["label"])
        elif r["label"]:
            fn += 1
    lo, hi = wilson(tp, links)
    print(f"calibration (truth = final `label`): {n} labelled cross-model "
          f"pairs, {same} SAME")
    print(f"fix_overlap >= {thr} with >=10-token guard: links {links}, "
          f"TP {tp}, precision {100*tp/links:.1f}% [{lo:.1f}%, {hi:.1f}%], "
          f"recall {100*tp/(tp+fn):.1f}%")


if __name__ == "__main__":
    calibrate() if "--calibrate" in sys.argv else main()

