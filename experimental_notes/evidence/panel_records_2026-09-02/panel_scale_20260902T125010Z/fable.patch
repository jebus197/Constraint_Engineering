     )
     return resolve_via_routing(finding, rungs, resolve_fn, reverify_fn, max_rungs=max_rungs)
+
+
+# ---------------------------------------------------------------------------
+# SINGLE-MODEL PANELS (0C.48, fable panel review 2026-09-02).
+#
+# 9 of 28 archived runs were effectively single-model -- six seats, one
+# underlying model -- and converged with full reports. `rank_falsifier_writers`
+# ranks by VENDOR, so with one vendor every rung is the same model in a
+# different hat and "escalation" re-asks the same distribution.
+#
+# The diversity axis that DOES exist with one model is the INSTRUCTION
+# CONDITION. Measured on the real archive, same weights under two conditions
+# (Codex = codex_exec, ChatGPT = bare OpenRouter, both openai/gpt-5.5 seats,
+# 29 runs): 76/293 findings carried falsifiers under the exec condition vs
+# 57/330 under bare, and 30 of 64 co-discovery groups containing either seat
+# contain only ONE of them -- the two conditions find materially different
+# defects with identical weights. That is the contrast that lapsed on
+# 2026-04-02, and it is the axis this ladder climbs when there is no other.
+# ---------------------------------------------------------------------------
+
+#: Instruction conditions, strongest-contrast first. "exec" mirrors the
+#: codex_exec framing (tool-forward, run-the-code); "adversarial" asks for the
+#: refutation posture the falsifier prompts use. The names are consumed by the
+#: caller's resolve_fn, which owns the actual prompt text.
+INSTRUCTION_CONDITIONS = ("default", "exec", "adversarial")
+
+
+def distinct_underlying(labels: Sequence[str],
+                        identity: Optional[dict] = None) -> int:
+    """How many DIFFERENT underlying models a seat list resolves to.
+
+    ``identity`` maps seat label -> underlying model id (the runner's
+    seat_model_map / model_identity). Unknown labels resolve to themselves
+    (their vendor base), which cannot invent distinctness that is not there.
+    """
+    def _base(m: str) -> str:
+        m = str(m or "")
+        return m[:-4] if m.endswith("-SIM") else m
+    ident = {str(k).strip().lower(): str(v).strip().lower()
+             for k, v in (identity or {}).items()}
+    return len({ident.get(_base(l).lower(), _base(l).lower()) for l in labels})
+
+
+def rungs_with_conditions(
+    labels: Sequence[str],
+    identity: Optional[dict] = None,
+    strength_order: Sequence[str] = DEFAULT_FALSIFIER_STRENGTH,
+    exclude: Sequence[str] = (),
+    conditions: Sequence[str] = INSTRUCTION_CONDITIONS,
+) -> list[tuple[str, str]]:
+    """Build routing rungs as (seat_label, instruction_condition) pairs.
+
+    Multi-model panel: the existing ladder, each seat under the default
+    condition -- behaviour is unchanged where vendor diversity exists.
+
+    Single-model panel: the ladder climbs the CONDITION axis instead, cycling
+    seats through the conditions, so rung 2 is a genuinely different ask
+    rather than the same distribution in a different hat.
+
+    RECORDING-COMPATIBLE: resolve_via_routing treats rungs opaquely, so these
+    pairs flow through it unchanged and land in routing_history as
+    (seat, condition) -- the artefact says which condition was tried.
+    """
+    ranked = rank_falsifier_writers(labels, strength_order=strength_order,
+                                    exclude=exclude)
+    if distinct_underlying(labels, identity) > 1:
+        return [(m, conditions[0]) for m in ranked]
+    out = []
+    for i, cond in enumerate(conditions):
+        seat = ranked[i % len(ranked)] if ranked else None
+        if seat is not None:
+            out.append((seat, cond))
+    return out
