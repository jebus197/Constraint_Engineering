+                                  "rule": "fix_overlap", "score": round(xj, 4)})
+    # Union-find over edges -> groups.
+    parent: Dict[str, str] = {}
+    def _find(x):
+        while parent.get(x, x) != x:
+            parent[x] = parent.get(parent[x], parent[x])
+            x = parent[x]
+        return x
+    for e in edges:
