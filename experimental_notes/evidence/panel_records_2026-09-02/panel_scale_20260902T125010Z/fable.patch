SIMULATED, and says so. The panel is scripted, not a model. What is taken
from measurement: same weights under two instruction conditions produce
falsifiers at different rates on different findings (archive, 29 runs:
codex_exec 76/293 = 25.9% vs bare 57/330 = 17.3%; 30 of 64 co-discovery
groups containing either seat contain only one). What is assumed,
conservatively: a deterministic model re-asked under the SAME condition gives
the SAME answer (real models have temperature, so design (a) is somewhat less
bleak than this floor).

Both designs run on identical findings with identical per-condition
behaviour; only the rung construction differs -- which is exactly the design
question. Tools decide: a rung resolves only when the scripted falsifier is
CONFIRMED by the (scripted) verifier, never because seats agree.
"""
import sys, pathlib
REPO = pathlib.Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO))
from bench.routing import (rank_falsifier_writers, resolve_via_routing,
                           rungs_with_conditions)

SEATS = ["Seat1", "Seat2", "Seat3", "Seat4", "Seat5", "Seat6"]
IDENTITY = {s: "one-model@one-api" for s in SEATS}
N = 40

# Per-condition success sets, disjoint-ish, rates matched to the archive
# measurement (bare ~17%, exec ~26%; adversarial given bare's rate on a
# shifted set because it is unmeasured).
def falsifier_works(idx, condition):
    if condition == "default":      # bare: 7/40 = 17.5%
        return idx % 6 == 0
    if condition == "exec":         # 10/40 = 25%
        return idx % 4 == 0
    if condition == "adversarial":  # 6/40 = 15%
        return idx % 6 == 3
    return False

def run(design):
    dispatches = 0; resolved = 0; conditions_tried = set()
    for i in range(N):
        finding = {"finding_id": f"F{i:03d}", "source_model": "Seat1"}
        if design == "a":
            rungs = [(m, "default") for m in rank_falsifier_writers(
                SEATS, exclude=("Seat1",))]
        else:
            rungs = rungs_with_conditions(SEATS, IDENTITY, exclude=("Seat1",))
        def resolve_fn(rung, f):
            nonlocal dispatches
            dispatches += 1
            seat, cond = rung
            conditions_tried.add(cond)
            return f"falsifier::{i}::{cond}" if falsifier_works(i, cond) else ""
        def reverify_fn(code):
            _, idx, cond = code.split("::")
            return "CONFIRMED" if falsifier_works(int(idx), cond) else "REFUTED"
        r = resolve_via_routing(finding, rungs, resolve_fn, reverify_fn, max_rungs=2)
        resolved += bool(r.resolved)
    return dict(design=design, resolved=resolved, hil=N - resolved,
                dispatches=dispatches, conditions=sorted(conditions_tried))

for d in ("a", "b"):
    r = run(d)
    print(f"design ({r['design']}): resolved {r['resolved']}/{N}, "
          f"to-HIL {r['hil']}, dispatches {r['dispatches']}, "
          f"conditions tried {r['conditions']}")

# Control: multi-model panel -- (b) must be byte-identical to (a).
ID2 = {s: f"model-{k}@api" for k, s in enumerate(SEATS)}
ra = [(m, "default") for m in rank_falsifier_writers(SEATS, exclude=("Seat1",))]
rb = rungs_with_conditions(SEATS, ID2, exclude=("Seat1",))
print("multi-model control, (b) rungs == (a) rungs:", ra == rb)
