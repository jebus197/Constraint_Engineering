### fable:attempt-1:.scratch/shell_classifier.sh
--- /dev/null	2026-09-20 04:00:19
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_sjdqir97/repo/.scratch/shell_classifier.sh	2026-09-20 03:49:13
@@ -0,0 +1,17 @@
+#!/bin/sh
+# Independent classifier: test -f / test -d / ls only. Args: REV MANIFEST
+REV="$1"
+git ls-tree -r --name-only "$REV" > .scratch/tracked_at_rev.txt
+while IFS= read -r p; do
+  if grep -qxF "$p" .scratch/tracked_at_rev.txt; then s=tracked
+  elif test -f "$p"; then s=local_only
+  elif test -d "$p"; then s=directory
+  elif printf '%s' "$p" | grep -qE 'XX|\.\.\.|\*|<|\{'; then s=template
+  else
+    stem=$(printf '%s' "$p" | sed 's:/*$::' | awk -F/ '{print $NF}')
+    parent=$(dirname "$(printf '%s' "$p" | sed 's:/*$::')")
+    if test -d "$parent" && ls "$parent" | grep -q "^$(printf '%s' "$stem" | sed 's/[^A-Za-z0-9_]/\\&/g')"; then s=prefix
+    else s=missing; fi
+  fi
+  printf '%s\t%s\n' "$p" "$s"
+done

