+def wilson(k, n):
+    z = mpf("1.959963984540054")
+    p = mpf(k) / n
+    d = 1 + z ** 2 / n
+    c = (p + z ** 2 / (2 * n)) / d
+    h = z * mpsqrt(p * (1 - p) / n + z ** 2 / (4 * n * n)) / d
+    return float(max(0, c - h)), float(min(1, c + h))
+
+
+def sr(fixture, patches, path):
+    return "".join(
+        f"<<<< SEARCH {path}\n{p.old}\n==== REPLACE\n{p.new}\n>>>>\n"
+        for p in patches)
+
+
