+def resolved_model_from_stream_json(text: str):
+    """The model id the TRANSPORT resolved, read from the reply's own envelope.
+
+    D6, TOCTOU, settled by using the reply instead of a probe. A BOOT-TIME
+    identity probe certifies identity at PROBE time, not at DISPATCH time: an
+    alias repointing upstream, or a CLI auto-update, between the probe and the
+    reply escapes it entirely. The id here is read from the SAME reply whose
+    text is being recorded, so there is no window between the measurement and
+    the thing measured. It costs no extra call: `--output-format stream-json`
+    is ALREADY in force whenever a tool-log sink is set, and its terminal
+    `result` record ALREADY carries `modelUsage`. Measured on 2026-11-13: the
+    envelope names `claude-opus-5` with `canonicalModel` and `provider`, while
+    `bench/logs/standards_currency_2026-11-13/cc2.tools.attempt1.json.txt`
+    recorded `"model": "opus"` -- the alias ASKED FOR, not the id SERVED.
 
+    This is transport metadata written by the client. It is NOT the model's
+    self-report, so it is not a model vote on its own identity.
 
+    Returns the resolved id, or None when the envelope does not name one --
+    which is a real and reportable answer, never a guess. Never raises.
+    """
+    best = None
+    for line in (text or "").splitlines():
+        line = line.strip()
+        if not line or '"modelUsage"' not in line:
+            continue
+        try:
+            rec = json.loads(line)
+        except ValueError:
+            continue
+        usage = rec.get("modelUsage")
+        if not isinstance(usage, dict) or not usage:
+            continue
+        for key, val in usage.items():
+            canon = val.get("canonicalModel") if isinstance(val, dict) else None
+            best = canon or key
+    return best
+
+
