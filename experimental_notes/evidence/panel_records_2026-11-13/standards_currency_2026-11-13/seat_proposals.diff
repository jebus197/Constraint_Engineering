+                 ("fable", LIVE_ENVELOPE, INSTALLED_CLI, None),
+                 ("claude-fable-5-2", None, INSTALLED_CLI, FABLE_52_REFUSAL),
+                 (None, None, None, None)):
+        assert MI.identity_verdict(*args)["how"] in MI.IDENTITY_STATES
