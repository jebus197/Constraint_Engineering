+                  "falsifier_code": "assert 'x' in open('bench/routing.py').read()",
+                  "falsifier_verdict": "REFUTED"},
+        "C0004": {"canonical_id": "C0004", "source_model": "DeepSeek",
+                  "falsifier_code": "assert 'x' in open('bench/routing.py').read()",
