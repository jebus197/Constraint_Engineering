### cc2:attempt-1:bench/tests/test_the_board_detector_fails_toward_writing_2026-11-22.py
--- /dev/null	2026-11-22 01:33:37
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_t25_xvp1/repo/bench/tests/test_the_board_detector_fails_toward_writing_2026-11-22.py	2026-11-22 01:24:44
@@ -0,0 +1,138 @@
+"""The triage's board detector must fail toward WRITING, as it documents.
+
+ENTRY B205(c) / B180, PANEL FINDING 2026-11-22. `a_commit_board_is_running`
+promises "any failure of this predicate returns ''". It leans on 2 exclusions
+that both fail the OTHER way by design, because both were written for
+`hooks/cy_monitor_gate.py`:
+
+    _own_process_chain  "FAIL-SAFE TOWARD DETECTING A RUN"
+    cy._is_shell        "unreadable -> KEEP, fail toward refusing"
+
+Where `ps` is absent or refused by sandbox policy, those go inert and a planted
+shell is reported as a running commit board. `hooks/work_not_narrate.py` stands
+its entire Stop gate down on this value, so the consequence is a DISABLED gate,
+not a noisy one.
+
+These tests pin the direction, not the implementation.
+"""
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+import subprocess
+import sys
+import time
+
+import pytest
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+
+
+def _load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture()
+def bt():
+    return _load("bt_polarity", REPO / "scripts" / "blocker_triage.py")
+
+
+class _R:
+    def __init__(self, out):
+        self.stdout, self.stderr, self.returncode = out, "", 0
+
+
+def _run_with(bt, shell_pid, deny_ps):
+    """The predicate with pgrep stubbed to ONE shell pid, ps optionally denied."""
+    real = bt.subprocess.run
+
+    def fake(cmd, *a, **k):
+        if cmd and str(cmd[0]) == "pgrep":
+            return _R(shell_pid + "\n")
+        if cmd and str(cmd[0]) == "ps" and deny_ps:
+            raise PermissionError(1, "Operation not permitted: 'ps'")
+        return real(cmd, *a, **k)
+
+    bt.subprocess.run = fake
+    try:
+        return bt.a_commit_board_is_running()
+    finally:
+        bt.subprocess.run = real
+
+
+@pytest.fixture()
+def planted_shell():
+    proc = subprocess.Popen(["/bin/zsh", "-c", "sleep 20"])
+    time.sleep(0.3)
+    try:
+        yield str(proc.pid)
+    finally:
+        proc.kill()
+
+
+def test_a_shell_is_not_a_board_even_when_ps_is_denied(bt, planted_shell):
+    """THE DEFECT ITSELF. No pytest runs in this test; the only match is a
+    shell. The documented answer is '' and it must not depend on `ps`."""
+    assert _run_with(bt, planted_shell, deny_ps=True) == "", (
+        "a shell was reported as a running commit board while `ps` was denied; "
+        "work_not_narrate stands its whole Stop gate down on this value")
+
+
+def test_the_same_holds_with_ps_available(bt, planted_shell):
+    """ANTI-VACUITY in the other direction: the answer is '' either way, so the
+    test above is not merely restating the sandbox's `ps` policy."""
+    assert _run_with(bt, planted_shell, deny_ps=False) == ""
+
+
+def test_ps_unavailability_is_distinguishable_from_no_board(bt):
+    """The probe that makes the repair possible must actually probe. Without a
+    way to tell "cannot tell" from "nothing there", the polarity cannot be
+    chosen at all."""
+    assert hasattr(bt, "_ps_can_answer"), (
+        "the predicate can no longer distinguish an unreadable `ps` from an "
+        "absent board; the fail-safe direction is then unchooseable")
+    real = bt.subprocess.run
+
+    def deny(cmd, *a, **k):
+        if cmd and str(cmd[0]) == "ps":
+            raise PermissionError(1, "denied")
+        return real(cmd, *a, **k)
+
+    bt.subprocess.run = deny
+    try:
+        assert bt._ps_can_answer() is False
+    finally:
+        bt.subprocess.run = real
+
+
+def test_a_real_board_is_still_detected(bt, monkeypatch):
+    """THE WIDENING IS NOT WEAKENED. The repair must not buy its polarity by
+    giving up detection -- that would be the removal half of the additive
+    standard."""
+    monkeypatch.setenv("CDSFL_BT_BOARD", "1")
+    assert bt.a_commit_board_is_running() == "forced-by-seam"
+
+
+def test_the_monitor_gate_keeps_the_opposite_polarity():
+    """cy_monitor_gate must NOT be 'fixed' to match. Its cost of over-firing is
+    a prod; its cost of under-firing is an unobserved 3-hour run, so failing
+    toward detecting is correct THERE and only there."""
+    cy = _load("cy_polarity", REPO / "hooks" / "cy_monitor_gate.py")
+    real = cy.subprocess.run
+
+    def deny(cmd, *a, **k):
+        if cmd and str(cmd[0]) == "ps":
+            raise PermissionError(1, "denied")
+        return real(cmd, *a, **k)
+
+    cy.subprocess.run = deny
+    try:
+        assert cy._is_shell("1") is False, (
+            "cy_monitor_gate stopped failing toward refusing; that direction is "
+            "deliberate and the triage repair must not have propagated here")
+    finally:
+        cy.subprocess.run = real

### cc2:attempt-1:bench/tests/test_the_budget_gate_sees_the_projects_own_idiom_2026-11-22.py
--- /dev/null	2026-11-22 01:33:37
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_t25_xvp1/repo/bench/tests/test_the_budget_gate_sees_the_projects_own_idiom_2026-11-22.py	2026-11-22 01:29:28
@@ -0,0 +1,80 @@
+"""The heavy-work detector must see the sentences this project actually writes.
+
+ENTRY B182, PANEL FINDING 2026-11-22. The B182 repair closed its 150-cell grid
+to 0 blind. The grid is not the vocabulary: its 10 nouns were chosen by the
+same hand that wrote the pattern, so the measurement could only report that the
+listed phrasings are caught.
+
+Counted over this repository's own .md/.py/.txt at the time of the finding:
+bare "the board" 1816, "bench/tests" with no trailing slash 1048, "the guards"
+525, unhyphenated "rerun" 398. All passed through. Two of them are sentences
+the project writes AT ITSELF -- the hook's own refusal text says "run the board
+ONCE yourself", and the 2026-11-21 panel brief says "Run the guards."
+
+THE NEGATION ARM IS PINNED TOO. Widening an accepting predicate is exactly how
+a gate starts refusing the briefs that FORBID the tooling, which is the failure
+B182 was raised for in the first place.
+"""
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+import sys
+
+import pytest
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+HOOK = REPO / "hooks" / "local_resource_budget.py"
+
+
+@pytest.fixture(scope="module")
+def instructs():
+    spec = importlib.util.spec_from_file_location("lrb_vocab", HOOK)
+    m = importlib.util.module_from_spec(spec)
+    sys.modules["lrb_vocab"] = m
+    try:
+        spec.loader.exec_module(m)
+    except SystemExit:
+        pass
+    return m._instructs_heavy_verification
+
+
+#: Each is a genuine instruction to run the project's heavy verification.
+@pytest.mark.parametrize("text", [
+    "run the board ONCE yourself, save the result",   # the hook's OWN remedy
+    "Run the guards.",                                # the panel brief's own words
+    "run the guards and report the result",
+    "run the board's own 317 guards",
+    "run the board",
+    "run the whole board",
+    "run the entire board",
+    "rerun the full test suite",
+    "rerunning the suite and tell me what fails",
+    "run bench/tests and tell me what fails",
+])
+def test_a_real_instruction_is_refused(instructs, text):
+    assert instructs(text.lower()), (
+        f"{text!r} passed through the gate that exists to refuse it; this is a "
+        "phrasing counted in the project's own corpus, not an invented one")
+
+
+#: THE HALF THAT MUST NOT MOVE. A brief forbidding the tooling has to be
+#: writable without tripping the guard that forbids it.
+@pytest.mark.parametrize("text", [
+    "do not run the full test suite",
+    "do not run the board",
+    "never rerun the suite",
+    "you must not run the guards",
+    "without running bench/tests",
+    "rather than running the board, consult the cached result",
+])
+def test_a_prohibition_still_passes_through(instructs, text):
+    assert not instructs(text.lower()), (
+        f"{text!r} was refused; widening the noun and verb sides must not turn "
+        "prohibitions into refusals -- that is the 2026-10-17 failure")
+
+
+def test_ambiguity_is_still_allowed(instructs):
+    """A bare noun with no verb and no negation stays AMBIGUOUS. Refusing on
+    ambiguity produced both false positives of 2026-10-17."""
+    assert not instructs("the board reported 18 failed and 5,131 passed")

