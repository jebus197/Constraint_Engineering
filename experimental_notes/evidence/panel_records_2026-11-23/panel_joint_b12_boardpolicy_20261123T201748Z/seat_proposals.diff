### fable:attempt-1:hooks/board_durations_persist.sh
--- /dev/null	2026-11-23 20:44:58
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_5jd0moq6/repo/hooks/board_durations_persist.sh	2026-11-23 20:28:17
@@ -0,0 +1,49 @@
+# CDSFL board-durations persistence helper.  POSIX sh.  Sourced by hooks/pre-commit.
+#
+# WHY THIS FILE EXISTS, with the measurement rather than the intention.
+#
+# B207 wired `--durations=25` into the board so pytest attributes real time per
+# guard. But the table lands in `$_CDSFL_BOARD_LOG`, which the hook deletes
+# with `rm -f` immediately after capturing `$OUT` -- and no grep over `$OUT`
+# ever touches the durations section. Measured 2026-11-23 over every artefact
+# staged in `.cdsfl_tmp/`: 0 of 6 retained board logs contain a durations table
+# (all 6 predate B207), and no other file in the repository persists one. So
+# the instrument that decides WHY the board grows -- measured on 2026-11-23 at
+# 5.4980 min/day inside a window where the guard count was CONSTANT at 331,
+# producer `scripts/the_growth_is_per_guard_not_more_guards_2026-11-23.py` --
+# emits its evidence once to a follower's stderr and destroys it.
+#
+# WHY A SOURCED HELPER AND NOT 3 INLINE LINES. The hook cannot be executed
+# without a `.git`, so inline logic is testable only by retyping it -- the
+# exact retyped-target antipattern the falsifier-integrity standard forbids.
+# A sourced file IS executable by a test in a plain /bin/sh, byte for byte,
+# and `hooks/stage0_restage.sh` is the standing precedent for the shape.
+#
+# WHY IT NEVER BLOCKS. This is telemetry, not a gate: a missing or failing
+# persistence step must not refuse a commit, so every path returns 0 and the
+# caller guards the source with `[ -f ... ]`. The failure mode that leaves --
+# data silently stopping -- is made visible, not fatal: the producer above
+# reports attribution coverage (boards with a persisted table / boards run),
+# so a silent stop surfaces as a coverage figure, not as a lost commit.
+#
+# THE CAP IS 120 LINES PER BOARD AND IT IS NOT SILENT. The persisted block is
+# the log from the `slowest N durations` header to end-of-file, which includes
+# pytest's short test summary and final count line -- a bounded table plus a
+# summary that stamps the run. A pathological log is capped at 120 lines and
+# the stamp line below records the cap so a truncated block names itself.
+
+_cdsfl_persist_durations() {
+    # $1 = path to the board log (still on disk), $2 = the board's exit code.
+    # Appends a stamped block to .cdsfl_tmp/board_durations.log, relative to
+    # the caller's cwd, which for the hook is the repository root.
+    [ -n "$1" ] && [ -f "$1" ] || return 0
+    _cdsfl_dp_table=$(sed -n '/slowest [0-9]* durations/,$p' "$1" | head -120)
+    [ -n "$_cdsfl_dp_table" ] || return 0
+    mkdir -p .cdsfl_tmp 2>/dev/null
+    {
+        printf '== board %s exit=%s cap=120 ==\n' \
+            "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" "${2:-?}"
+        printf '%s\n' "$_cdsfl_dp_table"
+    } >> .cdsfl_tmp/board_durations.log 2>/dev/null
+    return 0
+}

