+
+
+def _run_hook(tmp_path, transcript, state, env_extra=None):
+    sdir = tmp_path / "state"
+    sdir.mkdir(exist_ok=True)
+    (sdir / "sess").write_text(json.dumps(state))
+    env = {"FFAFP_AUDIT_STATE_DIR": str(sdir), "PATH": "/usr/bin:/bin",
