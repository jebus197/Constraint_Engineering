+            fixture.document, str(fixture.doc_path),
+            baseline=_real_baseline(fixture),
+            score_prose_listings=flag)
+        assert result.tristate != SK_ADMISSIBLE, (
+            f"{fixture.key}: harmful fix admitted with flag={flag}")
+        assert result.sk == 0.0
