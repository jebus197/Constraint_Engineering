### cc2:attempt-1:bench/tests/test_the_chat_prefilter_is_not_a_superset_2026-10-28.py
--- /dev/null	2026-10-28 23:07:26
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_gc2ppryq/repo/bench/tests/test_the_chat_prefilter_is_not_a_superset_2026-10-28.py	2026-10-28 22:55:49
@@ -0,0 +1,100 @@
+"""FALSIFIER + REGRESSION for CHANGE 4: `\\b(fr|pf|qs|wr)\\b` was NOT a superset
+of the decision, and the form it dropped is the commonest one.
+
+THE ARGUMENT UNDER TEST, from `from_chat`'s own note: "MARKER can only fire if a
+kind token appears literally in the decoded text, JSON never escapes ASCII
+letters, and MARKER's own left and right contexts each imply a word boundary."
+
+THE LAST CLAUSE IS FALSE ON THE RAW LINE. `MARKER` is compiled with
+`re.MULTILINE` and its left context is `(?<=^)|(?<=[\\s(\\[])`, so a NEWLINE is
+an accepted left neighbour. In the raw JSON line that newline is the 2
+characters `\\` and `n`; the character immediately left of the token is then the
+WORD character `n`, and `\\b` fails. The decision accepts, the prefilter rejects,
+and the dropped shape is a marker at the start of a line inside a multi-line
+message -- which is how a marker on its own line is written.
+
+CONSEQUENCE FOR THE BRIEF'S HEADLINE. CHANGE 4 reports that, with all filters,
+"the number of messages whose text actually RAISES a marker is 0". That 0 was
+produced by a reader that provably cannot see a newline-prefixed marker, so it
+is not yet evidence that the chat half harvests nothing.
+
+Run: python3 -m pytest bench/tests/test_the_chat_prefilter_is_not_a_superset_2026-10-28.py -q
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import pathlib
+import re
+
+HARVESTER = (pathlib.Path(__file__).resolve().parents[2]
+             / "scripts" / "harvest_tickets_2026-10-17.py")
+
+
+def _harvester():
+    spec = importlib.util.spec_from_file_location("_harvest", HARVESTER)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def _raw(text: str) -> str:
+    """The transcript line shape: one JSON object per line."""
+    return json.dumps({"role": "user",
+                       "content": [{"type": "text", "text": text}]})
+
+
+#: Decoded texts the DECISION accepts. Each puts the marker after a whitespace
+#: character that JSON encodes as a 2-character escape.
+ESCAPED_LEFT_NEIGHBOURS = [
+    ("newline", "I have been thinking about the gate.\nqs: should K be adaptive?"),
+    ("tab",     "see below:\n\tfr: add a completion barrier reader"),
+    ("return",  "first\rwr: finish the harvester"),
+]
+PLAIN = ("space", "and so qs: does the gate hold?")
+
+
+def test_the_old_boundary_prefilter_rejects_what_the_decision_accepts():
+    """The defect itself, demonstrated against the OLD pattern verbatim."""
+    h = _harvester()
+    old = re.compile(r"\b(?:fr|pf|qs|wr)\b", re.IGNORECASE)
+    violations = []
+    for name, text in ESCAPED_LEFT_NEIGHBOURS:
+        assert h.MARKER.search(text), f"{name}: the decision must accept this"
+        if not old.search(_raw(text)):
+            violations.append(name)
+    print(f"old prefilter rejects {len(violations)} of "
+          f"{len(ESCAPED_LEFT_NEIGHBOURS)} decided cases: {violations}")
+    assert violations == ["newline", "tab", "return"], (
+        "the superset claim holds after all -- this falsifier is refuted")
+    # control: the plain-space form was never the problem
+    assert old.search(_raw(PLAIN[1])), "control case should pass the old filter"
+
+
+def test_the_live_prefilter_is_now_a_superset_on_the_same_cases():
+    """The repair: a bare substring, which encoding cannot move."""
+    h = _harvester()
+    for name, text in ESCAPED_LEFT_NEIGHBOURS + [PLAIN]:
+        assert h.MARKER.search(text), name
+        assert h.CANDIDATE_LINE.search(_raw(text)), (
+            f"{name}: the live prefilter still drops a decided marker")
+
+
+def test_the_superset_property_holds_over_a_generated_sweep():
+    """Every whitespace left-neighbour, every kind, every marker punctuation."""
+    h = _harvester()
+    lefts = ["\n", "\t", "\r", " ", "\f", "\v", "(", "["]
+    rights = [":", "]", ")", " - "]
+    checked = failures = 0
+    for kind in ("fr", "pf", "qs", "wr"):
+        for L in lefts:
+            for R in rights:
+                text = f"preamble{L}{kind}{R}the body of the proposal"
+                if not h.MARKER.search(text):
+                    continue
+                checked += 1
+                if not h.CANDIDATE_LINE.search(_raw(text)):
+                    failures += 1
+    print(f"decided cases {checked}; prefilter misses {failures}")
+    assert checked > 0, "the sweep decided nothing -- the test proves nothing"
+    assert failures == 0, f"{failures} decided cases still rejected by the prefilter"

### cc2:attempt-1:bench/tests/test_the_kind_filter_reopens_the_cross_kind_rediscovery_2026-10-28.py
--- /dev/null	2026-10-28 23:07:26
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_gc2ppryq/repo/bench/tests/test_the_kind_filter_reopens_the_cross_kind_rediscovery_2026-10-28.py	2026-10-28 22:59:08
@@ -0,0 +1,93 @@
+"""FALSIFIER for CHANGE 3: the kind filter on the subject tier.
+
+THE CASE THE SUITE DOES NOT COVER, which is what the brief asked for by name.
+Every one of the 4 known-rediscovery cases in
+`bench/tests/test_ticket_store_2026-10-17.py` seeds with kind `pf` and proposes
+with kind `pf` (see `_seeded` and `CASES`). The suite is therefore blind to the
+cross-kind axis BY CONSTRUCTION and cannot detect a weakening along it.
+
+The founder's ruling of 2026-10-19 distinguishes a QUESTION from a PROPOSED FIX
+-- "he answers mine, I answer his". The committed change generalises that to all
+6 unordered kind pairs, including `fr` against `pf` and `wr` against `pf`, where
+the resolutions do NOT travel in opposite directions: a feature request he
+raised, a proposed fix against the same mechanism, and the work-remaining entry
+for it are the SAME work item seen from 3 sides.
+
+The motivating rediscovery of 2026-10-17 is exactly of that shape: HIS wording
+about the routing ladder settled, and the assistant later re-proposed the same
+change. `from_chat` types a ticket from the MARKER the author wrote, not from
+the content, so his `fr` and the assistant's `pf` land on different kinds while
+naming the same subject.
+
+Run: python3 -m pytest bench/tests/test_the_kind_filter_reopens_the_cross_kind_rediscovery_2026-10-28.py -q -s
+"""
+from __future__ import annotations
+
+import pathlib
+import sys
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
+
+from ticket_store import TicketStore  # noqa: E402
+
+HIS_LADDER = (
+    "Routing should be blind to what a models name is anyway, it should just "
+    "look at the available resources and if it can't climb, then it should "
+    "climb sideways, to the next highest rated available model, even if that "
+    "is another version of Opus 4.8.")
+MY_LADDER_PARAPHRASE = (
+    "Models can use up and down, as well as sideways, according to their "
+    "measured capability and a sane distribution of the available resources, "
+    "so that no model sits idle when it is still capable of doing useful work.")
+SUBJECT = "routing.rank_falsifier_writers"
+
+
+def _settled_store(path, kind: str) -> TicketStore:
+    s = TicketStore(path)
+    t, _ = s.propose(kind, "side-steps over available resources", HIS_LADDER,
+                     "chat", subjects=[SUBJECT])
+    s.close(t.tid, "already implemented",
+            "executed rank_falsifier_writers: 3 of 3 exclusions dropped")
+    return s
+
+
+def test_the_same_kind_rediscovery_is_still_blocked(tmp_path):
+    """Control: the case the suite DOES cover is unaffected."""
+    s = _settled_store(tmp_path / "same.jsonl", "pf")
+    _, outcome = s.propose("pf", "candidate", MY_LADDER_PARAPHRASE, "chat",
+                           subjects=[SUBJECT])
+    print(f"settled pf -> proposed pf : {outcome}")
+    assert outcome == "subject-settled"
+
+
+def test_a_settled_fr_no_longer_blocks_the_same_work_raised_as_pf(tmp_path):
+    """THE UNCOVERED CASE. The rediscovery the tier was built for returns."""
+    s = _settled_store(tmp_path / "cross.jsonl", "fr")
+    _, outcome = s.propose("pf", "candidate", MY_LADDER_PARAPHRASE, "chat",
+                           subjects=[SUBJECT])
+    print(f"settled fr -> proposed pf : {outcome}")
+    assert outcome == "created", (
+        "if this is 'subject-settled' the kind filter did not reach this path "
+        "and the falsifier is refuted")
+
+
+def test_a_settled_pf_no_longer_blocks_the_same_work_raised_as_wr(tmp_path):
+    """`wr` is work REMAINING on a fix -- the same item, not an opposite one."""
+    s = _settled_store(tmp_path / "wr.jsonl", "pf")
+    _, outcome = s.propose("wr", "candidate", MY_LADDER_PARAPHRASE, "chat",
+                           subjects=[SUBJECT])
+    print(f"settled pf -> proposed wr : {outcome}")
+    assert outcome == "created"
+
+
+def test_the_known_case_suite_is_single_kind_and_cannot_see_this(tmp_path):
+    """Why the suite passing is not evidence that nothing broke."""
+    src = (pathlib.Path(__file__).resolve().parents[0]
+           / "test_ticket_store_2026-10-17.py").read_text()
+    seeded = src[src.index("def _seeded"):src.index("def _word_overlap_blocks")]
+    kinds = {k for k in ("fr", "pf", "qs", "wr")
+             if f'propose("{k}"' in seeded or f"propose('{k}'" in seeded}
+    print(f"kinds used by the known-rediscovery seeding: {sorted(kinds)}")
+    assert kinds == {"pf"}, (
+        "the known-case suite now exercises more than one kind; re-read this "
+        "falsifier's premise")

### cc2:attempt-1:bench/tests/test_the_severity_spec_annihilates_the_a4_severity_door_2026-10-28.py
--- /dev/null	2026-10-28 23:07:26
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_gc2ppryq/repo/bench/tests/test_the_severity_spec_annihilates_the_a4_severity_door_2026-10-28.py	2026-10-28 23:01:46
@@ -0,0 +1,177 @@
+"""FALSIFIER for CHANGE 5: with section 7.7 promoted, the A4 fail-safe's
+severity condition is a TAUTOLOGY, and the obvious repair is UNREACHABLE.
+
+Both halves are asserted here because the second is what stopped me shipping a
+patch, and a panel that reports only the half that suits its proposal is not
+reporting.
+
+── THE DEFECT, DERIVED ──────────────────────────────────────────────────────
+`effective_severity` is read at exactly ONE decision site,
+`FindingRegistry.blocking_entry_ids`, whose release rule is
+
+    if effective_severity(e) < CRITICAL_SEVERITY_THRESHOLD and severity_is_proven(e):
+        continue                       # released; stops blocking convergence
+
+With the specification deciding it returns `asserted * V`. Every entry whose
+blocking decision is still IN PLAY there carries V <= 0.5: V = 1.0 requires
+`falsifier_verdict == "CONFIRMED"`, and `_FALSIFIER_RESOLVED_VERDICTS ==
+{"CONFIRMED"}`, so such an entry is released by the falsifier test 4 lines
+later whatever the severity door decides. Severity is a [0, 1] score, so
+
+    asserted * V  <=  0.5  <  0.7  =  CRITICAL_SEVERITY_THRESHOLD
+
+UNCONDITIONALLY. The severity half of the conjunction is constant-true and the
+door collapses to `severity_is_proven(e)` alone. A PROVEN, asserted-1.0,
+unresolved critical is released from the A4 fail-safe.
+
+── WHY NO PATCH IS DELIVERED, measured rather than argued ───────────────────
+The obvious repair -- leave the `V(None) = 0.5` stand-in at identity and keep
+only the measured factors V = 0 and V = 1 -- was written, executed, and
+WITHDRAWN. Over 75 archived `runner_state.json` files and 3,617 registry
+entries, the population it would still release is 1 entry UNCONFIRMED+REFUTED,
+of which 0 are also proven. It is an addition nothing reaches, which the
+project's additive standard forbids as squarely as it forbids a vacuous gate.
+The committed form releases 30 of 3,617 -- every proven UNCONFIRMED entry,
+at any asserted severity.
+
+So the two available forms are "release everything proven" and "release
+nothing", and neither is section 7.7. With V the only collected factor the
+specification has NO discriminating power at a cut of 0.7, because its range on
+the in-play domain is [0, 0.5]. Promotion needs the cut re-derived on the
+specification's own scale -- which is precisely the full-range adjudication
+CHANGE 8 costs. Changes 5 and 8 are one problem.
+
+Run: python3 -m pytest bench/tests/test_the_severity_spec_annihilates_the_a4_severity_door_2026-10-28.py -q -s
+"""
+from __future__ import annotations
+
+import glob
+import json
+import pathlib
+import sys
+
+sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
+
+import reference_runner_v3 as rr  # noqa: E402
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+IN_PLAY_VERDICTS = ("", "REFUTED", "PENDING", "UNRESOLVED", None)
+
+
+def _entry(severity: float, verdict="", proven: bool = True) -> dict:
+    return {"status": "UNCONFIRMED", "severity": severity,
+            "falsifier_code": "", "falsifier_verdict": verdict,
+            "severity_proof": ({"status": "PASS"} if proven else None),
+            "open_since_round": 1}
+
+
+def _registry(entries: dict):
+    reg = object.__new__(rr.FindingRegistry)
+    reg.entries = entries
+    return reg
+
+
+def _spec(flag: bool):
+    rr.wire_module_mirrors(rr.RunnerConfig(severity_spec_enabled=flag))
+
+
+def test_a_proven_asserted_one_point_zero_critical_is_released():
+    """The defect, on the real reader."""
+    reg = _registry({"C1": _entry(1.0)})
+    try:
+        _spec(False)
+        off = reg.blocking_entry_ids()
+        _spec(True)
+        on = reg.blocking_entry_ids()
+    finally:
+        _spec(False)
+    print(f"asserted 1.0, PROVEN, unresolved falsifier: "
+          f"spec OFF blocks={off}  spec ON blocks={on}")
+    assert off == ["C1"], "the asserted path must block a 1.0 critical"
+    assert on == [], (
+        "FALSIFIER REFUTED: the flag did not release it after all")
+
+
+def test_the_severity_condition_is_constant_true_over_the_in_play_domain():
+    _spec(True)
+    try:
+        worst = max(rr.effective_severity(_entry(s, v))
+                    for s in (0.0, 0.5, 0.7, 0.9, 1.0)
+                    for v in IN_PLAY_VERDICTS)
+    finally:
+        _spec(False)
+    print(f"max effective_severity over the in-play domain = {worst}; "
+          f"CRITICAL_SEVERITY_THRESHOLD = {rr.CRITICAL_SEVERITY_THRESHOLD}")
+    assert worst < rr.CRITICAL_SEVERITY_THRESHOLD, (
+        "not a tautology -- some in-play entry can still reach the cut")
+
+
+def test_z3_agrees_no_in_play_entry_can_reach_the_cut():
+    """Second tool, on the real constants."""
+    try:
+        import z3
+    except ImportError:                                      # pragma: no cover
+        print("z3 unavailable -- cross-check skipped")
+        return
+    sev, V = z3.Real("asserted"), z3.Real("V")
+    s = z3.Solver()
+    s.add(sev >= 0, sev <= 1)
+    s.add(z3.Or(V == z3.RealVal("1/2"), V == 0))        # the in-play factors
+    s.add(sev * V >= z3.RealVal("7/10"))
+    res = s.check()
+    print(f"z3: exists an in-play entry with asserted*V >= 0.7 ?  {res}")
+    assert res == z3.unsat
+
+
+def test_the_withdrawn_repair_would_have_been_unreachable():
+    """The measurement that stopped a patch being shipped."""
+    files = glob.glob(str(REPO / "bench" / "**" / "runner_state.json"),
+                      recursive=True)
+    if not files:
+        import pytest
+        pytest.skip("no archived runner_state.json in this checkout")
+    total = unconf = proven = refuted = refuted_proven = 0
+    for f in files:
+        try:
+            d = json.load(open(f))
+        except Exception:                                    # noqa: BLE001
+            continue
+        for e in ((d.get("registry") or {}).get("entries") or {}).values():
+            total += 1
+            if e.get("status") != "UNCONFIRMED":
+                continue
+            unconf += 1
+            pr = rr.severity_is_proven(e)
+            proven += pr
+            if str(e.get("falsifier_verdict") or "").upper() == "REFUTED":
+                refuted += 1
+                refuted_proven += pr
+    print(f"archive: {len(files)} states, {total} entries, {unconf} UNCONFIRMED; "
+          f"proven {proven}; UNCONFIRMED+REFUTED {refuted}, also proven "
+          f"{refuted_proven}")
+    assert refuted_proven == 0, (
+        "the V=0-only repair IS reachable after all -- reconsider shipping it")
+    assert proven > 0, (
+        "the committed form reaches nothing either, which would make the whole "
+        "promotion an addition nothing reaches")
+
+
+def test_the_convergence_critical_series_is_untouched_by_the_flag():
+    """The suspected change-5 / change-1-2 interaction does NOT run via crit_s."""
+    reg = _registry({
+        "C1": {"status": "OPEN", "severity": 0.9, "open_since_round": 1,
+               "falsifier_verdict": "REFUTED"},
+        "C2": {"status": "OPEN", "severity": 0.8, "open_since_round": 2,
+               "falsifier_verdict": ""}})
+    try:
+        _spec(False)
+        _, crit_off = rr._settled_novelty_series(reg, 3)
+        _spec(True)
+        _, crit_on = rr._settled_novelty_series(reg, 3)
+    finally:
+        _spec(False)
+    print(f"crit_s spec OFF = {crit_off}   spec ON = {crit_on}")
+    assert crit_off == crit_on, (
+        "the gate's critical series DID move -- the brief's suspected "
+        "interaction is real and this claim is refuted")
+    assert sum(crit_on) == 2

