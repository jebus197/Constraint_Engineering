+EXP48 = ROOT / "bench" / "logs" / "exp48_chemistry_exam_live_20260729T044134Z"
+
+pytestmark = pytest.mark.skipif(not RUN_1B.is_dir(), reason="run 1b absent")
+
+
+def test_recorded_root_is_discovered():
