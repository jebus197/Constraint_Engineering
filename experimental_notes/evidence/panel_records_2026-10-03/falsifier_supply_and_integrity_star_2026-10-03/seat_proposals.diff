+        e = {"status": "UNCONFIRMED", "severity": 0.3,
+             "falsifier_verdict": "INTEGRITY_VIOLATION",
+             "integrity_unobserved": True}
+        assert _reg(e).integrity_refused_subcriticals() == []
+
