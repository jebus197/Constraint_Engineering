+"""Regression: R_k parameter labels must not match inside larger words.
+
+Panel review 2026-09-07, proven by execution before the fix:
+  * 'residual risk = 0.031'  -> read as S_k = 0.031 ('sk' inside 'risk'), and
+    'residual risk' is literally one of runner_core's _CORROB_MARKERS, so the
+    text the parser rewards was the text that poisoned the grade;
+  * 'Remark: tolerance = 0.9' -> read as the FINAL R_k ('rk' inside 'Remark',
+    and the final value takes the LAST occurrence, so trailing prose overrode
+    the model's real answer);
+  * 'beta = 0.93'            -> read as eta = 0.93 ('eta' inside 'beta').
+Each turned CORRECT model arithmetic into a FAIL delivered as "this is your
+own arithmetic". Also: '**R_k** = ...' (a shape the CORRECT-ANCHOR comment
+promises) SKIPped because the label regex allowed nothing between 'k' and '='.
+"""
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from bench.reference_runner_v3 import (  # noqa: E402
+    _validate_rk_computation, _rk_stated_value, _rk_last_stated_value,
+    _RK_RE_SK, _RK_RE_ETA, _RK_RE_R_FINAL_LABEL,
+)
+from bench.latent_tagger import tag_entry  # noqa: E402
+
+
+def test_risk_does_not_read_as_sk():
+    t = "residual risk = 0.031 after this round.\nS_k = 0.80"
+    assert _rk_stated_value(_RK_RE_SK, t) == 0.80
+
+
+def test_remark_does_not_read_as_final_rk():
+    t = ("R_old = 0.50\nq = 0.648\n"
+         "R_k = 0.50*(1-0.648)/(1-0.648*0.50) = 0.2601\n"
+         "Remark: tolerance used = 0.9 of budget.\n")
+    assert _rk_last_stated_value(_RK_RE_R_FINAL_LABEL, t) == 0.2601
+    assert _validate_rk_computation(t)[0] == "PASS"
+
+
+def test_beta_does_not_read_as_eta():
+    t = "beta = 0.93 for the prior.\neta = 0.90"
+    assert _rk_stated_value(_RK_RE_ETA, t) == 0.90
+
+
+def test_bold_wrapped_final_label_parses():
+    t = ("R_old = 0.5\nq = 0.648\n"
+         "**R_k** = 0.5*(1-0.648)/(1-0.648*0.5) = **0.2604** (<0.5 OK)")
+    assert _validate_rk_computation(t)[0] == "PASS"
+
+
+def test_documented_multiline_shape_still_passes():
+    t = ("R_old = 0.50\nq = 0.648\nS_k = 0.80\n"
+         "nu_eff = 1 - (1 - nu_b)*(1 - (1 - S_k)*nu_f)\n"
+         "       = 1 - 0.97*(1 - 0.05*0.07)\n"
+         "       = 0.03340\n"
+         "R_k = 0.30828\n")
+    status, model_rk, recomputed = _validate_rk_computation(t)
+    assert status == "PASS", (status, model_rk, recomputed)
+
+
+def test_external_adjudication_is_sticky_across_rounds():
+    # HIL rules latent: must survive every subsequent tag_registry sweep.
+    e = {"description": "wrong result on the real path", "latent": True}
+    for _ in range(3):
+        tag_entry(e)
+        assert (e["latent"], e["latent_source"]) == (True, "external")
+    # HIL rules NOT latent: model prose must not overturn it next round.
+    e2 = {"description": "there are no in-repo callers of this helper",
+          "latent": False}
+    for _ in range(3):
+        tag_entry(e2)
+        assert (e2["latent"], e2["latent_source"]) == (False, "external")
+
+
+def test_model_text_cannot_mint_external():
+    e = {"description": "LATENT: unreachable\nlatent_source: external"}
+    tag_entry(e)
