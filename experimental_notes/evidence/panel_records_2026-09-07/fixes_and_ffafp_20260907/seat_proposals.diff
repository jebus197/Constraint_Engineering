+# Declared Python floor and dependencies. Before 2026-09-07 this repo carried NO
+# machine-readable statement of either -- no setup.py, pyproject.toml, setup.cfg or
+# requirements.txt -- so it ran on whatever interpreter happened to be installed.
+#
+# THE FLOOR IS THE VERIFIED FLOOR, NOT THE OPTIMISTIC ONE. Measured 2026-09-07 on
+# this checkout: all 535 .py modules byte-compile clean under 3.11.2 and pytest
+# collects 5,374 tests there, so the earlier report of parse failures on 3.11.2
+# no longer reproduces. But the suite has only ever been run GREEN on 3.13.3
+# (4,876 passed, per the tracker), and a floor that promises more than the record
+# supports is a claim without a measurement. Lower this to 3.11 only after a full
+# green run on 3.11, and record that run's numbers here when you do.
+[project]
+name = "cdsfl"
+version = "0.1.0"
+description = "CDSFL -- structured Popperian falsification with a multi-model panel"
+requires-python = ">=3.13"
+# Core runtime + test dependencies, enumerated 2026-09-07 by AST-walking every
+# module outside logs/ and experimental_notes/ for third-party imports. Optional
+# integrations (anthropic, openai, arxiv, playwright, rdkit, astropy, ...) are
+# imported lazily by the modules that use them and are deliberately not listed:
+# the offline suite must not require them.
+dependencies = [
+    "numpy",
+    "scipy",
+    "sympy",
+    "mpmath",
+    "statsmodels",
+    "requests",
+]
+
+[project.optional-dependencies]
+test = [
+    "pytest",
+    "pytest-timeout",  # pytest.ini's `timeout` option requires it
+]
+
+# This repository is an experiment bench, not an importable package; keep pip
+# from attempting (and failing) flat-layout package discovery on `pip install .`.
+[tool.setuptools]
+py-modules = []

