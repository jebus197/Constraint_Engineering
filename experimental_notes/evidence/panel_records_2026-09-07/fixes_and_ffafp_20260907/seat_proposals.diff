+#!/usr/bin/env python3
+"""Count the archived convergence events. The number travels with this script.
+
+WHY THIS EXISTS. "25 archived runs record a convergence" was asserted in a
+panel brief on 2026-09-07. Recounted the same day: 25 counts one run twice.
+`bench/logs/exp36_evidence_latest` is a SYMLINK onto
+`bench/logs/exp36_evidence_20260407T004931Z` (hence "byte-identical" reports,
+sha256 940e4e6b... -- same file through two names), so a traversal that follows
+the link sees 25 report paths for 24 events: 15 live, 9 simulated. Two defences
+here, either sufficient: pathlib.rglob does not traverse directory symlinks,
+and content-hash identity would collapse a future REAL copy too. Per the ruling
+`measured-rate-travels-with-its-script`, that number is not to be quoted
+anywhere without this script beside it.
+
+THE RULE, STATED SO IT CAN BE FALSIFIED
+  corpus     : every *_report.json under bench/logs (recursively; the nested
+               copy inside exp36_evidence_latest is IN the corpus -- dedup is
+               what removes it, not a curated exclusion)
+  convergence: the report carries a `convergence_reason` describing a MET
+               condition. Absent field = did not converge. A reason naming
+               budget exhaustion (max_rounds_reached, BUDGET_EXHAUSTED) or a
+               halt (HALTED_*, EXTENSION_STALLED) is NOT a convergence -- a
+               run that stopped is not a run that agreed. This matches the
+               rule already stated in docs/EXPERIMENTAL_RESULTS.md ("read the
+               reason, not converged_at").
+  identity   : sha256 of the report file bytes. Two files, one hash, one event.
+  simulated  : the run directory name starts with "sim". The sim/live label is
+               a property of the RUN, recorded in the directory naming scheme
+               (see test_sim_and_real_are_separated_by_construction_2026-08-31).
+
+Usage: python3 scripts/count_convergence_events.py [--json]
+"""
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parent.parent
+LOGS = REPO_ROOT / "bench" / "logs"
+
+NOT_A_CONVERGENCE = ("max_rounds_reached", "BUDGET_EXHAUSTED",
+                     "HALTED", "EXTENSION_STALLED")
+
+
+def count(logs_dir: Path = LOGS) -> dict:
+    events: dict[str, dict] = {}
+    files = 0
+    for path in sorted(logs_dir.rglob("*_report.json")):
+        try:
+            data = json.loads(path.read_text(encoding="utf-8", errors="replace"))
+        except (ValueError, OSError):
+            continue
+        reason = data.get("convergence_reason")
+        if not reason or any(b in str(reason) for b in NOT_A_CONVERGENCE):
+            continue
+        files += 1
+        digest = hashlib.sha256(path.read_bytes()).hexdigest()
+        rel = str(path.relative_to(logs_dir))
+        ev = events.setdefault(digest, {
+            "paths": [], "reason": str(reason)[:100],
+            "simulated": path.relative_to(logs_dir).parts[0].startswith("sim"),
+        })
+        ev["paths"].append(rel)
+    sim = sum(1 for e in events.values() if e["simulated"])
+    return {
+        "report_files_recording_a_convergence": files,
+        "distinct_events_by_content_hash": len(events),
+        "simulated": sim,
+        "live": len(events) - sim,
+        "duplicates": {h[:16]: e["paths"] for h, e in events.items()
+                       if len(e["paths"]) > 1},
+        "events": {h[:16]: {"paths": e["paths"], "simulated": e["simulated"],
+                            "reason": e["reason"]} for h, e in events.items()},
+    }
+
+
+def main(argv=None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--json", action="store_true")
+    args = ap.parse_args(argv)
+    r = count()
+    if args.json:
+        print(json.dumps(r, indent=2))
+        return 0
+    print("Archived convergence events, deduplicated by content hash")
+    print("=" * 60)
+    print(f"report files recording a convergence : {r['report_files_recording_a_convergence']}")
+    print(f"distinct events                      : {r['distinct_events_by_content_hash']}")
+    print(f"  simulated                          : {r['simulated']}")
+    print(f"  live                               : {r['live']}")
+    if r["duplicates"]:
+        print("duplicate archives of one event:")
+        for h, paths in r["duplicates"].items():
+            print(f"  {h}: " + "  ==  ".join(paths))
+    else:
+        print("no duplicates in the current corpus")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
