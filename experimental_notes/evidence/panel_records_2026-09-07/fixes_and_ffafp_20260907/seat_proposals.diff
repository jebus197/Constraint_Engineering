### bench/tests/test_archive_census_2026-09-07.py
--- /dev/null	2026-09-07 15:13:28
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_1009psuj/repo/bench/tests/test_archive_census_2026-09-07.py	2026-09-07 15:01:18
@@ -0,0 +1,215 @@
+"""The archive counts, recomputed from the archive. Items 4 and 5 of the PoC block.
+
+These are the two numbers a stranger falsifies by counting, so they are counted
+here on every suite run rather than asserted in prose that drifts.
+
+ITEM 5 -- THE s_star DENOMINATOR. Settled: 3816. `reference_runner_v3.py:10602`
+said "3181 of 3181, Wilson [99.88%, 100.00%]" while lines 10775/10781 and three
+exp56 `_sk_note` configs said 3816. 3181 is not a rival count of this quantity:
+it is the LINE COUNT of `dynamic_management.py`, the Exp 12 review artefact,
+which appears 9 times in docs/experimental_notes as "3181 lines". The Wilson
+interval travelled with it, which is the tell -- see the runner docstring for
+the closed-form derivation of n/(n + z^2).
+
+ITEM 4 -- THE RUN COUNT. The reported correction ("25 archived runs" -> "24
+distinct, exp36_evidence_latest is byte-identical to
+exp36_evidence_20260407T004931Z") is RIGHT ABOUT THE BYTES AND WRONG ABOUT THE
+CAUSE, and the cause is what decides the defensible number:
+
+    bench/logs/exp36_evidence_latest -> exp36_evidence_20260407T004931Z
+
+is a SYMLINK. It is a pointer, not a run. The byte-identity is not evidence of
+a duplicated event; it is what a symlink is for, and this repo's own
+`test_results_doc_currency.py` already documents it as one. So the defensible
+enumeration does not need a content hash at all -- it needs to not follow
+symlinks, which is cheaper and cannot merge two things that are genuinely
+different.
+
+That distinction is load-bearing, because content-hash dedup is WRONG HERE in
+the other direction. Measured 2026-09-07 over all 57 report-bearing dirs under
+bench/logs: content-hash dedup collapses TWO pairs, and only one of them is an
+alias. The other is
+
+    bench/logs/experiment_12/experiment_12_report.json
+    bench/logs/experiment_14a/experiment_14a_report.json
+
+byte-identical, both carrying `"experiment": "12_live_wire"`, the same
+timestamp 2026-03-29T21:38:02.690815+00:00, the same 4 rounds and the same 150
+findings -- in directories holding 155 and 21 entries respectively. These are
+two different directories, and 14a is carrying EXPERIMENT 12's REPORT. Hashing
+would silently report them as one run and hide the misfiling; symlink-exclusion
+would report them as two and also hide it. Neither is the check that catches it.
+The check that catches it is asking whether a run's report identifies itself as
+that run, which is the last test in this file.
+"""
+from __future__ import annotations
+
+import collections
+import hashlib
+import json
+import pathlib
+
+import pytest
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parents[2]
+LOGS = REPO_ROOT / "bench" / "logs"
+
+#: Recounted 2026-09-07. Walk every JSON under bench/logs and bench/results and
+#: count scalar `s_star` keys at any depth: 7348 files parsed, 3816 records,
+#: all 3816 reading 0.0, all of them under bench/logs.
+SK_RECORDS = 3816
+
+#: Directories under bench/logs that carry a `*report*.json` and are not
+#: symlinks. Measured 2026-09-07: 57 report-bearing entries, 1 of them the
+#: `exp36_evidence_latest` symlink, so 56 real runs.
+REAL_RUNS = 56
+
+#: Directories whose report does not identify itself as that directory.
+#: A regression fence, not an exemption: if a third one appears, this fails.
+#:
+#: Measured 2026-09-07 -- THREE directories carry a report saying
+#: `"experiment": "12_live_wire"`, and content-hash dedup finds only one of them:
+#:
+#:   experiment_12   ts 2026-03-29T21:38:02  4 rounds  150 findings  sha a7e2fe99
+#:   experiment_14a  ts 2026-03-29T21:38:02  4 rounds  150 findings  sha a7e2fe99
+#:   experiment_13b  ts 2026-03-29T09:35:15  4 rounds  185 findings  sha a8b9efef
+#:
+#: 14a is a byte-identical COPY of 12's report -- a misfiling. 13b is a
+#: genuinely different run (earlier timestamp, 185 findings, different hash)
+#: whose `experiment` field was never changed from the template -- a
+#: mislabelling. Hashing sees the first and is blind to the second, which is
+#: the whole argument for checking self-identification instead of bytes.
+#:
+#: CONSEQUENCE FOR ANY COUNT. The quantity actually at risk is not the number
+#: of runs -- it is findings attributed to an experiment. Three directories
+#: claim to be experiment 12, so a naive attribution credits experiment 12 with
+#: 150 + 185 + 150 = 485 findings across 12 rounds when it ran 150 in 4.
+KNOWN_MISFILED = {"experiment_14a", "experiment_13b"}
+
+pytestmark = pytest.mark.skipif(not LOGS.is_dir(), reason="bench/logs archive not on this machine")
+
+
+def _report_bearing():
+    """(name, report_path, is_symlink) for every dir under bench/logs with a report."""
+    out = []
+    for d in sorted(LOGS.iterdir()):
+        if not d.is_dir():
+            continue
+        reports = [p for p in sorted(d.glob("*.json")) if "report" in p.name.lower()]
+        if reports:
+            out.append((d.name, reports[0], d.is_symlink()))
+    return out
+
+
+def test_the_latest_pointer_is_a_symlink_not_a_duplicate_run():
+    """The premise of the whole item-4 correction. If this ever stops being a
+    symlink, the counting rule below silently starts double-counting."""
+    latest = LOGS / "exp36_evidence_latest"
+    if not latest.exists():
+        pytest.skip("exp36_evidence_latest is not present on this machine")
+    assert latest.is_symlink(), (
+        "exp36_evidence_latest is no longer a symlink. It is now a real directory, "
+        "so excluding symlinks no longer removes it and the run count is inflated by one."
+    )
+    assert latest.resolve().name == "exp36_evidence_20260407T004931Z"
+
+
+def test_run_count_excludes_symlinks_and_matches_the_declared_figure():
+    entries = _report_bearing()
+    real = [n for n, _, sym in entries if not sym]
+    assert len(real) == REAL_RUNS, (
+        f"archived runs recounted to {len(real)}, declared {REAL_RUNS}. "
+        f"({len(entries)} report-bearing entries, {len(entries) - len(real)} of them symlinks.) "
+        "Update REAL_RUNS and every prose statement of it in the same commit."
+    )
+
+
+def test_content_hash_dedup_would_merge_two_runs_that_are_not_the_same_run():
+    """VACUITY-ADJACENT CHECK, and the reason hashing was not adopted.
+
+    Asserts the hazard is real rather than describing it. If hashing ever stops
+    over-merging, this fails and the docstring above must be rewritten.
+    """
+    byhash = collections.defaultdict(list)
+    for name, rep, sym in _report_bearing():
+        if sym:
+            continue
+        byhash[hashlib.sha256(rep.read_bytes()).hexdigest()].append(name)
+    collisions = {h: v for h, v in byhash.items() if len(v) > 1}
+    assert collisions, (
+        "content-hash dedup now merges nothing among non-symlink runs; the argument "
+        "in this module's docstring for preferring symlink-exclusion needs rechecking"
+    )
+    merged = sorted(n for v in collisions.values() for n in v)
+    assert "experiment_12" in merged and "experiment_14a" in merged, (
+        f"expected the exp12/exp14a collision, got {merged}"
+    )
+
+
+def test_every_run_report_identifies_itself_as_that_run():
+    """The check that actually catches the misfiling, which neither counting rule does."""
+    mismatched = []
+    for name, rep, sym in _report_bearing():
+        if sym:
+            continue
+        try:
+            declared = str(json.loads(rep.read_text()).get("experiment") or "")
+        except Exception:                                        # noqa: BLE001
+            continue
+        if not declared:
+            continue
+        stem = name.replace("experiment_", "").replace("exp", "")
+        if not any(tok and tok in name or tok in declared for tok in [declared.split("_")[0]]):
+            continue
+        head = declared.split("_")[0]
+        if head.isdigit() and f"_{head}" not in f"_{stem}":
+            mismatched.append(f"{name}: report says experiment={declared!r}")
+
+    unexpected = [m for m in mismatched if m.split(":")[0] not in KNOWN_MISFILED]
+    assert not unexpected, (
+        "a run directory carries a report belonging to a different experiment:\n  "
+        + "\n  ".join(unexpected)
+    )
+    still_bad = {m.split(":")[0] for m in mismatched}
+    assert still_bad == KNOWN_MISFILED, (
+        f"KNOWN_MISFILED is stale: expected {KNOWN_MISFILED}, measured {still_bad}. "
+        "If experiment_14a's report has been corrected, remove it from KNOWN_MISFILED."
+    )
+
+
+def test_sk_star_denominator_recounts_to_the_declared_figure():
+    total = zero = 0
+
+    def walk(o):
+        nonlocal total, zero
+        if isinstance(o, dict):
+            v = o.get("s_star")
+            if "s_star" in o and not isinstance(v, (dict, list)):
+                total += 1
+                try:
+                    if float(v) == 0.0:
+                        zero += 1
+                except (TypeError, ValueError):
+                    pass
+            for x in o.values():
+                walk(x)
+        elif isinstance(o, list):
+            for x in o:
+                walk(x)
+
+    roots = [LOGS, REPO_ROOT / "bench" / "results"]
+    for root in roots:
+        if not root.is_dir():
+            continue
+        for p in root.rglob("*.json"):
+            try:
+                walk(json.loads(p.read_text()))
+            except Exception:                                    # noqa: BLE001
+                continue
+
+    assert total == SK_RECORDS, (
+        f"s_star records recounted to {total}, declared {SK_RECORDS}. The runner "
+        f"docstring at reference_runner_v3.py:10602 quotes this figure with a Wilson "
+        f"interval derived from it; update both together or they desynchronise again."
+    )
+    assert zero == total, f"{total - zero} of {total} records no longer read 0.0"

