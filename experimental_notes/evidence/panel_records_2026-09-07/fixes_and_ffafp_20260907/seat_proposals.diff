### bench/tests/test_sk_denominator_is_recounted_2026-09-07.py
--- /dev/null	2026-09-07 15:13:27
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_1009psuj/repo/bench/tests/test_sk_denominator_is_recounted_2026-09-07.py	2026-09-07 15:10:21
@@ -0,0 +1,103 @@
+"""The S_k denominator is RECOUNTED from the archive, not quoted.
+
+WHY. On 2026-09-07 the runner carried two denominators for one quantity:
+`sk_threshold_shadow`'s docstring said s_star reads 0.0 in "3181 of 3181"
+archived records while the gate-input comment said "3816 of 3816" -- and each
+number had, at some point, a Wilson interval computed for ITSELF, so checking
+the interval against the count beside it could not catch the split. Recounting
+settled it: 3816 records carry `s_star`, every one reads zero, and 3181 is the
+subtotal whose value is the JSON number 0.0 -- the remaining 635 are the STRING
+"0", all written by sim45 runs. Two honest counters disagreed because neither
+stated its type rule.
+
+WHAT THIS PINS. (1) The archive recount itself: total = float-zeros +
+string-zeros, and no record carries a non-zero s_star (if one ever does, the
+gate has fired and half the project record about it must be rewritten -- that
+must fail loudly, not drift). (2) The numbers quoted in the runner's two
+comment sites equal the recount, so the documented figure can never again
+drift from the measured one. This is a documentation drift guard in the sense
+of test_documentation_drift_guards_2026-08-25.py: the assertion on source text
+is on the QUOTED NUMBER, and the number it must equal is recomputed here by
+walking the archive, not read from anywhere.
+"""
+from __future__ import annotations
+
+import json
+import pathlib
+import re
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parents[2]
+LOGS = REPO_ROOT / "bench" / "logs"
+RUNNER = REPO_ROOT / "bench" / "reference_runner_v3.py"
+
+
+def _recount() -> tuple[int, int, int]:
+    """(total, float_zero, string_zero) over every gate record under bench/logs.
+
+    A gate record is any dict carrying `passes_threshold`, at any depth --
+    the same walk rule as scripts/measure_sk_threshold_gate_fire_rate.py, so
+    the two measurements cannot diverge by corpus definition.
+    """
+    total = float_zero = string_zero = nonzero = 0
+
+    def walk(o):
+        nonlocal total, float_zero, string_zero, nonzero
+        if isinstance(o, dict):
+            if "passes_threshold" in o and "s_star" in o:
+                total += 1
+                v = o["s_star"]
+                if v == 0 and isinstance(v, (int, float)):
+                    float_zero += 1
+                elif v == "0":
+                    string_zero += 1
+                else:
+                    nonzero += 1
+            for x in o.values():
+                walk(x)
+        elif isinstance(o, list):
+            for x in o:
+                walk(x)
+
+    for path in LOGS.rglob("*.json"):
+        try:
+            data = json.loads(path.read_text(errors="ignore"))
+        except (ValueError, OSError):
+            continue
+        walk(data)
+    assert nonzero == 0, (
+        f"{nonzero} archived s_star records are NON-zero. The gate has fired, "
+        "or a writer changed format. Either way every '0 of N' claim about "
+        "this gate is now stale -- recount before trusting any of them."
+    )
+    return total, float_zero, string_zero
+
+
+def test_the_archive_recount_is_the_documented_number():
+    total, fz, sz = _recount()
+    assert total == fz + sz, "a record was counted under no type bucket"
+    assert total > 3000, (
+        f"only {total} gate records found; the corpus this guard measures "
+        "against has gone missing"
+    )
+
+    src = RUNNER.read_text(encoding="utf-8")
+    quoted = {int(n) for n, m in re.findall(
+        r"reads (?:0\.0|zero) in (\d+) of (\d+)", src) if n == m}
+    assert quoted, "the runner no longer states the census -- restore it"
+    assert quoted == {total}, (
+        f"the runner quotes {sorted(quoted)} but the archive recounts {total}. "
+        "Update the docstring AND the gate-input comment together, with the "
+        "float/string split beside them."
+    )
+
+
+def test_the_type_split_is_stated_where_the_number_is():
+    """The 3181/635 split is what let one quantity carry two denominators;
+    whoever states the total must state the split, or the next float-typed
+    counter re-derives 3181 and the drift returns."""
+    total, fz, sz = _recount()
+    src = RUNNER.read_text(encoding="utf-8")
+    assert str(fz) in src and str(sz) in src, (
+        f"the runner states the total but not the split ({fz} float 0.0 / "
+        f"{sz} string \"0\"); state both where the total is stated"
+    )

