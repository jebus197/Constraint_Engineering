### bench/tests/test_python_floor_is_declared_2026-09-07.py
--- /dev/null	2026-09-07 15:13:27
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_1009psuj/repo/bench/tests/test_python_floor_is_declared_2026-09-07.py	2026-09-07 14:59:06
@@ -0,0 +1,119 @@
+"""The declared Python floor exists, and the tree actually parses under it.
+
+WHY. Before 2026-09-07 this repo declared no floor anywhere: no setup.py,
+pyproject.toml, setup.cfg or requirements.txt. It ran on 3.13.3 by accident.
+A stranger had nothing to install against and no statement of what would work.
+
+WHAT THIS ASSERTS, AND WHAT IT CANNOT.
+`ast.parse(..., feature_version=(3, 11))` compiles with the GRAMMAR of the
+declared floor while running on whatever interpreter the suite is using, so the
+check runs on the founder's 3.13 without a second interpreter installed.
+
+Its reach is MEASURED, not assumed (probed 2026-09-07 on 3.13.3):
+
+    type X = int                 -> rejected at feature_version (3,11)
+    def f[T](x: T) -> T: ...     -> rejected at feature_version (3,11)
+    try/except* ValueError       -> ACCEPTED (3.11 grammar; correct)
+    match/case                   -> ACCEPTED (3.10 grammar; correct)
+
+So it catches PEP 695 generics and type-alias statements, which are the 3.12+
+syntax a 3.13-only habit actually introduces. It does NOT catch LIBRARY-level
+floor breaks -- `itertools.batched` (3.12), `pathlib.Path.walk` (3.12) --
+because those parse fine and fail at run time. Saying so is the point: this
+guard is ONE-SIDED, and a green result is not a certificate that the tree runs
+on 3.11.
+
+The two-interpreter check that WOULD close that gap is named in the pyproject
+comment as the command to run:
+
+    python3.11 -m pytest bench/tests --collect-only -q
+
+Measured 2026-09-07: 5374 tests collected, 0 collection errors, on 3.11.2. It
+is not run from inside the suite because it needs an interpreter a stranger's
+machine may not have, and a test that silently skips on every machine is the
+vacuous-guard failure this project has already shipped once.
+"""
+from __future__ import annotations
+
+import ast
+import pathlib
+import re
+import sys
+
+import pytest
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parents[2]
+PYPROJECT = REPO_ROOT / "pyproject.toml"
+
+if sys.version_info >= (3, 11):
+    import tomllib
+else:  # pragma: no cover - the floor itself forbids this branch
+    import tomli as tomllib
+
+
+def _declared_floor() -> tuple:
+    """(major, minor) from `requires-python`, read from the file that ships."""
+    data = tomllib.loads(PYPROJECT.read_text())
+    spec = data["project"]["requires-python"]
+    m = re.search(r">=\s*(\d+)\.(\d+)", spec)
+    assert m, f"requires-python {spec!r} has no `>=MAJOR.MINOR` lower bound"
+    return int(m.group(1)), int(m.group(2))
+
+
+def _tracked_modules():
+    out = []
+    for p in sorted(REPO_ROOT.rglob("*.py")):
+        s = str(p)
+        if "__pycache__" in s or ".mypy_cache" in s or "/.git/" in s:
+            continue
+        out.append(p)
+    return out
+
+
+def test_a_floor_is_declared_at_all():
+    assert PYPROJECT.is_file(), "pyproject.toml is missing: the floor is undeclared again"
+    assert _declared_floor() >= (3, 8), "a floor below 3.8 is not a floor anyone should ship"
+
+
+def test_the_probe_can_actually_reject_something_above_the_floor():
+    """VACUITY CHECK. A grammar check that accepts everything proves nothing.
+
+    This project shipped `boundary_band_sensitivity` as an unconditional
+    constant, vacuous in 41 of 41 archived reports, guarded by a test that read
+    source text instead of calling the function. So the discriminating power of
+    the probe below is asserted, not assumed.
+    """
+    floor = _declared_floor()
+    with pytest.raises(SyntaxError):
+        ast.parse("type Alias = int", feature_version=floor)
+    # ...and it must still accept ordinary code, or it rejects everything.
+    ast.parse("def f(x):\n    return x + 1\n", feature_version=floor)
+
+
+def test_every_tracked_module_parses_under_the_declared_floor():
+    floor = _declared_floor()
+    mods = _tracked_modules()
+    assert len(mods) > 100, f"only {len(mods)} modules found; the walk is broken, not the tree clean"
+
+    failures = []
+    for p in mods:
+        try:
+            ast.parse(p.read_text(errors="ignore"), filename=str(p), feature_version=floor)
+        except SyntaxError as exc:
+            failures.append(f"{p.relative_to(REPO_ROOT)}:{exc.lineno}: {exc.msg}")
+
+    assert not failures, (
+        f"{len(failures)} of {len(mods)} modules use syntax newer than the declared floor "
+        f"{floor[0]}.{floor[1]}. Either lower the syntax or raise `requires-python`:\n  "
+        + "\n  ".join(failures[:20])
+    )
+
+
+def test_dependencies_are_declared_and_not_empty():
+    """A floor with no dependency list still leaves a stranger guessing."""
+    data = tomllib.loads(PYPROJECT.read_text())
+    deps = data["project"]["dependencies"]
+    assert deps, "dependencies list is empty; the tree imports numpy, scipy, sympy at minimum"
+    names = {re.split(r"[<>=!;\s]", d, maxsplit=1)[0].lower() for d in deps}
+    for required in ("numpy", "scipy", "sympy"):
+        assert required in names, f"{required} is imported by the bench but undeclared"

