### cc2:attempt-1:bench/tests/test_the_role_literal_is_enforced_2026-10-31.py
--- /dev/null	2026-10-31 02:12:26
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_ycxcf7mt/repo/bench/tests/test_the_role_literal_is_enforced_2026-10-31.py	2026-10-31 02:09:54
@@ -0,0 +1,97 @@
+"""`Role` is enforced at construction, and the enforcement preserves behaviour.
+
+Panel round `the_role_layer_b21_2026-10-30`. Before this, `Role` at
+`bench/experiment_11_orchestrator.py:59` was a `Literal` annotation that no
+runtime check read, and an AST scan of every live `ModelConfig(role=...)` site
+(`scripts/how_many_role_values_does_the_code_construct_2026-10-31.py`) found 4
+spellings against 3 declared members: `player` at 9 sites and `reviewer` at 4.
+
+These tests pin the 3 properties that matter and NOT the alias table's contents,
+which are the founder's to extend:
+
+  1. the enforcement reaches every construction, because it is in `__post_init__`
+  2. it is behaviour-PRESERVING at every live read, so it is not a change of
+     dispatch disguised as a type fix
+  3. `Role` is the single source of truth -- `canonical_role` reads
+     `get_args(Role)` rather than a second list that could drift
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from typing import get_args
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from bench.experiment_11_orchestrator import (  # noqa: E402
+    ExperimentConfig,
+    ModelConfig,
+    ROLE_ALIASES,
+    Role,
+    canonical_role,
+)
+
+
+def _mc(role: str) -> ModelConfig:
+    return ModelConfig(label="T", model_id="sim", api="sim",
+                       role=role, system_prompt_path=None)
+
+
+def test_every_declared_member_round_trips():
+    for member in get_args(Role):
+        assert canonical_role(member) == member
+        assert _mc(member).role == member
+
+
+def test_an_undeclared_spelling_cannot_survive_construction():
+    """The defect: a spelling outside `Role` reaching a reader unchanged."""
+    for spelling in ("goalkeeper", "striker", "", "Participant"):
+        with pytest.raises(ValueError, match="unknown ModelConfig role"):
+            _mc(spelling)
+
+
+def test_every_alias_resolves_to_a_declared_member():
+    """Pins the INVARIANT, not the table. An alias naming a non-member would
+    reintroduce the drift through the mechanism built to close it."""
+    assert ROLE_ALIASES, "an empty alias table is an addition nothing reaches"
+    for alias, target in ROLE_ALIASES.items():
+        assert alias not in get_args(Role), f"{alias!r} is a member, not an alias"
+        assert target in get_args(Role), f"alias {alias!r} -> non-member {target!r}"
+        assert _mc(alias).role == target
+
+
+def test_normalisation_preserves_every_live_read():
+    """The 2 reads the brief cites plus the confer split and the role lookup.
+
+    `reference_runner_v3.py:13189`/`:13269` and 16 siblings: `!= "collator"`.
+    `run_exp20_confer.py:253`/`:533`: `== "player_manager"`.
+    Behaviour must be identical before and after normalisation for every alias.
+    """
+    for alias, target in ROLE_ALIASES.items():
+        assert (alias != "collator") == (target != "collator")
+        assert (alias == "player_manager") == (target == "player_manager")
+
+
+def test_an_aliased_seat_is_now_found_by_a_role_keyed_lookup():
+    """This is the only behaviour that CHANGES, and it changes in one direction.
+
+    `ExperimentConfig.get_by_role` compares for equality, so before
+    normalisation a seat constructed as `player` was invisible to
+    `get_by_role("participant")` while still being dispatched by the
+    `!= "collator"` filter. A role-KEYED policy layer would inherit that
+    asymmetry.
+    """
+    cfg = ExperimentConfig(models=[_mc("player"), _mc("participant")])
+    assert len(cfg.get_by_role("participant")) == 2
+    assert cfg.get_by_role("collator") == []
+
+
+def test_canonical_role_reads_the_literal_not_a_copy():
+    """No second hand-written member list anywhere in the module source."""
+    src = (Path(__file__).resolve().parents[1]
+           / "experiment_11_orchestrator.py").read_text(encoding="utf-8")
+    assert "get_args(Role)" in src, "members must be derived from `Role` itself"
+    # The members appear in exactly one place: the `Role` assignment.
+    assert src.count('"collator", "player_manager", "participant"') == 1

### cc2:attempt-1:scripts/falsifier_role_literal_unenforced_2026-10-31.py
--- /dev/null	2026-10-31 02:12:24
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_ycxcf7mt/repo/scripts/falsifier_role_literal_unenforced_2026-10-31.py	2026-10-31 02:09:01
@@ -0,0 +1,69 @@
+#!/usr/bin/env python3
+"""FALSIFIER: `ModelConfig.role` accepts a spelling `Role` does not declare.
+
+Imports the REAL target -- `bench.experiment_11_orchestrator` -- and constructs
+real `ModelConfig` objects. Nothing is retyped or paraphrased.
+
+FAILS IFF THE DEFECT IS PRESENT. The defect is that `Role` is a bare `Literal`
+annotation that no runtime check reads, so a construction site may set a role
+value outside the declared members and every downstream predicate silently
+treats it as a reviewer. If any undeclared spelling SURVIVES construction
+unchanged, this prints FALSIFIED and raises AssertionError. If every undeclared
+spelling is either normalised to a declared member or rejected, it exits
+cleanly: the defect is not demonstrated.
+
+The two spellings tested are not invented. They are the ones an AST scan of
+every live `ModelConfig(role=...)` call site finds outside the literal --
+`player` at 9 sites, `reviewer` at 4 -- per
+`scripts/how_many_role_values_does_the_code_construct_2026-10-31.py`.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from typing import get_args
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from bench.experiment_11_orchestrator import ExperimentConfig, ModelConfig, Role  # noqa: E402
+
+DRIFTED = ["player", "reviewer"]          # found at live call sites by AST scan
+MEMBERS = get_args(Role)
+
+print(f"declared Role members : {list(MEMBERS)}")
+print(f"spellings under test  : {DRIFTED}")
+
+survived: list[str] = []
+for spelling in DRIFTED:
+    assert spelling not in MEMBERS, f"test premise wrong: {spelling!r} is declared"
+    try:
+        mc = ModelConfig(label="F", model_id="sim", api="sim",
+                         role=spelling, system_prompt_path=None)
+    except ValueError as exc:
+        print(f"  {spelling!r:12} REJECTED at construction: {str(exc).split(';')[0]}")
+        continue
+    if mc.role not in MEMBERS:
+        print(f"  {spelling!r:12} SURVIVED as {mc.role!r} -- outside {list(MEMBERS)}")
+        survived.append(spelling)
+    else:
+        print(f"  {spelling!r:12} normalised to {mc.role!r}")
+
+# The consequence, measured rather than asserted: a role-KEYED lookup misses a
+# seat whose role is an undeclared synonym, while the `!= "collator"` dispatch
+# filter does not. That asymmetry is what makes the drift latent.
+probe = ModelConfig(label="P", model_id="sim", api="sim",
+                    role=DRIFTED[0] if not survived else DRIFTED[0],
+                    system_prompt_path=None)
+found = ExperimentConfig(models=[probe]).get_by_role("participant")
+print(f"  get_by_role('participant') finds the {DRIFTED[0]!r} seat : {len(found) == 1}")
+print(f"  dispatch filter (role != 'collator') passes it          : {probe.role != 'collator'}")
+
+if survived:
+    print("FALSIFIED")
+    raise AssertionError(
+        f"`Role` is unenforced: {survived} survived construction outside "
+        f"{list(MEMBERS)}. Every live read is `!= \"collator\"`, so such a seat "
+        f"is dispatched as a reviewer while a role-keyed lookup misses it."
+    )
+
+print("CLEAN: no undeclared spelling survives construction; the defect is not demonstrated.")

### cc2:attempt-1:scripts/how_many_role_values_does_the_code_construct_2026-10-31.py
--- /dev/null	2026-10-31 02:12:24
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_ycxcf7mt/repo/scripts/how_many_role_values_does_the_code_construct_2026-10-31.py	2026-10-31 02:05:17
@@ -0,0 +1,202 @@
+#!/usr/bin/env python3
+"""The declared `Role` has 3 members; the code CONSTRUCTS 5. Measured by AST.
+
+WHY THIS EXISTS. Panel brief `the_role_layer_b21_2026-10-30` asks whether the
+harness's existing role vocabulary and the founder's proposed one are 1
+dimension or 2. Both the brief and
+`scripts/which_role_vocabulary_does_the_code_speak_2026-10-30.py` take the
+existing vocabulary to be the 3 members of
+`bench/experiment_11_orchestrator.py:59`:
+
+    Role = Literal["collator", "player_manager", "participant"]
+
+and compute a 63/67 = 0.940 "structural share" over exactly those 3 words. That
+denominator is drawn from a `grep` for 6 chosen words. It cannot see a role
+value that is neither in the declared literal nor in the founder's list, and it
+therefore cannot detect that the literal is not enforced.
+
+WHAT THIS MEASURES INSTEAD. Every `role=<string literal>` keyword argument to a
+`ModelConfig(...)` call in live code, found by parsing the AST rather than by
+grepping for known words, so an unknown value is visible. `bench/logs/` is
+excluded: those are `sandbox_harvest` copies of older revisions of the same
+files, not live code, and counting them double-counts one construction site.
+
+`role=` kwargs to non-`ModelConfig` calls are excluded too -- the Google GenAI
+SDK and the OpenRouter message format both use `role="user"`/`"model"`/`"tool"`
+for an unrelated purpose, and conflating them would inflate the count.
+
+WHAT IT DOES NOT CLAIM. It does not claim the undeclared values break a run
+today. Whether they do is a separate question, answered by executing the 2 live
+reads; see `--probe-reads`.
+"""
+from __future__ import annotations
+
+import argparse
+import ast
+import json
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO))
+
+EXCLUDE_PARTS = {"logs", ".git", ".pytest_cache", "node_modules"}
+TARGET_CALLS = {"ModelConfig"}
+
+
+def declared_members() -> list[str]:
+    """Parse the `Role = Literal[...]` assignment out of the orchestrator.
+
+    Read from the AST of the declaring module rather than imported, so this
+    works without executing the orchestrator's import-time side effects.
+    """
+    src = (REPO / "bench" / "experiment_11_orchestrator.py").read_text(encoding="utf-8")
+    tree = ast.parse(src)
+    for node in ast.walk(tree):
+        if not isinstance(node, ast.Assign):
+            continue
+        if not (len(node.targets) == 1
+                and isinstance(node.targets[0], ast.Name)
+                and node.targets[0].id == "Role"):
+            continue
+        sub = node.value
+        if isinstance(sub, ast.Subscript):
+            idx = sub.slice
+            elts = idx.elts if isinstance(idx, ast.Tuple) else [idx]
+            return [e.value for e in elts
+                    if isinstance(e, ast.Constant) and isinstance(e.value, str)]
+    raise SystemExit("FATAL: no `Role = Literal[...]` assignment found")
+
+
+def _callee_name(func: ast.expr) -> str:
+    if isinstance(func, ast.Name):
+        return func.id
+    if isinstance(func, ast.Attribute):
+        return func.attr
+    return ""
+
+
+def _literal_role_strings(value: ast.expr) -> list[str]:
+    """Collect string constants a `role=` expression can evaluate to.
+
+    Handles the bare constant and the conditional form actually in the tree,
+    `role="player_manager" if i == 0 else "player"`, which a grep for
+    `role="..."` reports as one value and which is two.
+    """
+    if isinstance(value, ast.Constant) and isinstance(value.value, str):
+        return [value.value]
+    if isinstance(value, ast.IfExp):
+        return _literal_role_strings(value.body) + _literal_role_strings(value.orelse)
+    return []
+
+
+def scan() -> dict[str, list[str]]:
+    """Map role value -> sorted list of "path:line" construction sites."""
+    sites: dict[str, list[str]] = defaultdict(list)
+    for path in sorted(REPO.rglob("*.py")):
+        rel = path.relative_to(REPO)
+        if EXCLUDE_PARTS & set(rel.parts):
+            continue
+        try:
+            tree = ast.parse(path.read_text(encoding="utf-8"))
+        except (SyntaxError, UnicodeDecodeError):
+            continue
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+            if _callee_name(node.func) not in TARGET_CALLS:
+                continue
+            for kw in node.keywords:
+                if kw.arg != "role":
+                    continue
+                for val in _literal_role_strings(kw.value):
+                    sites[val].append(f"{rel}:{node.lineno}")
+    return {k: sorted(set(v)) for k, v in sorted(sites.items())}
+
+
+def probe_reads(undeclared: list[str]) -> list[str]:
+    """Evaluate the live `mc.role` predicates against each undeclared value.
+
+    `bench/reference_runner_v3.py:13189` and `:13269` both filter
+    `mc.role != "collator"`; `bench/run_exp20_confer.py:253` splits on
+    `mc.role == "player_manager"`; `ExperimentConfig.get_by_role` compares for
+    equality against a requested role. Each predicate is evaluated on the value
+    itself -- no network, no dispatch.
+    """
+    out = []
+    for v in undeclared:
+        dispatched = (v != "collator")
+        is_manager = (v == "player_manager")
+        found_as_participant = (v == "participant")
+        out.append(
+            f"    {v!r:14} dispatched_by_runner={dispatched}  "
+            f"is_manager={is_manager}  get_by_role('participant') matches={found_as_participant}"
+        )
+    return out
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--json", action="store_true")
+    ap.add_argument("--probe-reads", action="store_true",
+                    help="evaluate the live `mc.role` predicates on each undeclared value")
+    args = ap.parse_args()
+
+    declared = declared_members()
+    sites = scan()
+    constructed = list(sites)
+    undeclared = [v for v in constructed if v not in declared]
+    unconstructed = [v for v in declared if v not in constructed]
+
+    if args.json:
+        print(json.dumps({
+            "declared": declared,
+            "constructed": constructed,
+            "undeclared": undeclared,
+            "declared_but_never_constructed": unconstructed,
+            "sites": sites,
+        }, indent=2))
+        return 0
+
+    print("=" * 78)
+    print("ModelConfig `role=` string literals in live code, by AST")
+    print("=" * 78)
+    print(f"\ndeclared by `Role = Literal[...]`  : {len(declared)}  {declared}")
+    print(f"constructed at call sites          : {len(constructed)}  {constructed}")
+    print()
+    for v, s in sites.items():
+        tag = "DECLARED  " if v in declared else "UNDECLARED"
+        print(f"  [{tag}] {v!r:16} {len(s)} site(s)")
+        for site in s:
+            print(f"               {site}")
+    print()
+    print(f"UNDECLARED values constructed      : {len(undeclared)}  {undeclared}")
+    print(f"DECLARED values never constructed  : {len(unconstructed)}  {unconstructed}")
+    print()
+    if undeclared:
+        print("  So the `Role` literal is NOT the live vocabulary. It is an")
+        print("  annotation that no runtime check enforces, and the construction")
+        print(f"  sites have drifted to {len(constructed)} values against {len(declared)} declared.")
+        print()
+        print("  CONSEQUENCE FOR THE BRIEF'S TALLY. The 63/67 = 0.940 'structural")
+        print("  share' greps for 3 declared words and 3 proposed ones. It counts")
+        print(f"  none of {undeclared}, so its denominator omits")
+        print("  every drifted value by construction and cannot detect the drift.")
+
+    if args.probe_reads and undeclared:
+        print()
+        print("  LIVE READS EVALUATED on each undeclared value:")
+        for line in probe_reads(undeclared):
+            print(line)
+        print()
+        print('    Both runner reads are `!= "collator"`, so an undeclared value is')
+        print("    dispatched as a reviewer -- which is why the drift has never")
+        print('    surfaced as a failure. `get_by_role("participant")` does NOT')
+        print("    match it, so a role-KEYED lookup misses those seats silently.")
+
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

