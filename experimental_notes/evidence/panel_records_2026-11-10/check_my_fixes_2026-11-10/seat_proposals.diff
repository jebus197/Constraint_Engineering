+def _emitted_strings(call: "ast.Call"):
+    """Yield the string literals this call is passed, f-strings included.
+
+    An `Assign` or a bare docstring is deliberately NOT a source: the question
+    is whether the proof EMITS the token, and a literal the proof never hands
+    to a call is not emitted. Concatenation and f-string interpolation are
+    followed because `print("FALSIFIED: " + why)` and `print(f"FALSIFIED {x}")`
+    are both ordinary ways to write the signal.
