+
+    def parts(node):
+        if isinstance(node, _a.Constant) and isinstance(node.value, str):
+            yield node.value
+        elif isinstance(node, _a.JoinedStr):
+            for v in node.values:
+                yield from parts(v)
+        elif isinstance(node, _a.FormattedValue):
+            return
+        elif isinstance(node, _a.BinOp) and isinstance(node.op, _a.Add):
