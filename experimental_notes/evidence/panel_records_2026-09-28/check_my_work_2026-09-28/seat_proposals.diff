+    nustar = s * R * q / (1 - q * R * (1 - s))
+    check(sp.simplify(nustar.subs(R, Rfix) - nu) == 0,
+          "nu* = nu EXACTLY at the floor, so appendix :284's hard exit marks it (the fix)")
+
+
+def satisfiability() -> None:
+    print("\n2. SATISFIABILITY (z3, exact rationals, closed box)")
+    try:
+        import z3
+    except ImportError:
+        print("  [SKIP] z3 not installed; the SymPy closed form already decides the sign")
+        return
+    R, q, s, nu = z3.Reals("R q sigma nu")
+    R_det = R * (1 - q) / (1 - q * R)
+    dR = R - ((s * R_det + (1 - s) * R) * (1 - nu) + nu)
+    E = R * q * s * (1 - nu) - nu * (1 - R)
