### cc2:scripts/execute_not_grep_census_2026-09-17.py
--- /dev/null	2026-09-17 01:37:39
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_km_cdv9k/repo/scripts/execute_not_grep_census_2026-09-17.py	2026-09-17 01:24:17
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Of the flagged DONE entries, how many name ONLY source-text-asserting evidence?
+
+The 2026-09-17 closing brief states "25 of the 30 name evidence that asserts on
+source text where the claim is about behaviour" and commits no script beside
+it, which `measured-rate-travels-with-its-script` forbids. This is that script.
+
+THE CLASSIFIER, AND ITS LIMITS, STATED FIRST. A test file is called
+SOURCE-READING when it obtains another file's text -- `read_text`,
+`open(...).read()`, `inspect.getsource` -- and BEHAVIOURAL when it imports a
+repository module and calls into it. These are not exclusive: a file that reads
+an archive fixture AND calls the code under test is MIXED and counts as
+behavioural, because the behaviour is exercised.
+
+What it cannot do: decide whether the behaviour a file exercises is the
+behaviour its entry CLAIMS. That is a semantic judgement, and a regex does not
+make it. So this script bounds the brief's figure rather than reproducing the
+judgement behind it -- the STRICT count (no named evidence executes anything)
+is a lower bound on how many entries broke `execute-do-not-grep`, and the LOOSE
+count (some named evidence only reads source) is an upper bound. A figure
+outside [strict, loose] cannot be right under any reading.
+"""
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+TASKS = REPO / "experimental_notes" / "CDSFL_MASTER_TASK_LIST.md"
+
+FLAGGED = "1.2 2.2 3.3 5.2 6.1 6.6 8.1 8.3 9.1 9.2 9.3 9.4 10.1 A4 A6 A13 A20 " \
+          "A26 L2 P1 P3 P4 P5 P7 R2 R3 R5 V1 V4 V7".split()
+
+READS_SOURCE = re.compile(
+    r"\.read_text\s*\(|open\s*\([^)]*\)\s*\.read\s*\(|inspect\.getsource|"
+    r"\.read_bytes\s*\(|subprocess\.run\s*\(\s*\[\s*[\"']grep")
+#: A repository module can be brought in at least 4 ways, and the first draft of
+#: this script knew only 1 of them. Each correction moved the answer a long way,
+#: which is the point worth recording:
+#:   draft 1 (`from bench...` only)          -> strict 22
+#:   draft 2 (+ `spec_from_file_location`)   -> strict 11   [L2 loads this way]
+#:   draft 3 (+ `sys.path.insert` then a bare `import <stem>`) -> see output
+#: 9.1 does `sys.path.insert(0, ROOT/"bench")` then `import reference_runner_v3
+#: as rr` and calls `rr.study_programme_report(...)`; V1 does the same with
+#: `scripts/task_list_markers.py`. Neither matched drafts 1 or 2. So rather than
+#: guess at prefixes, resolve every bare import against the module stems that
+#: actually exist in this repository.
+_STEMS = None
+
+
+def repo_module_stems() -> set[str]:
+    global _STEMS
+    if _STEMS is None:
+        _STEMS = {f.stem for d in ("bench", "scripts", "explorer")
+                  for f in (REPO / d).rglob("*.py")} - {"__init__"}
+    return _STEMS
+
+
+def loads_repo_module(src: str) -> bool:
+    if re.search(r"spec_from_file_location|SourceFileLoader", src):
+        return True
+    stems = repo_module_stems()
+    for m in re.finditer(r"^\s*(?:from|import)\s+([A-Za-z_][\w.]*)", src, re.M):
+        head = m.group(1).split(".")[0]
+        if head in ("bench", "scripts", "explorer") or head in stems:
+            return True
+    return False
+
+
+def evidence_map() -> dict[str, list[str]]:
+    t = TASKS.read_text(encoding="utf-8")
+    out = {}
+    for m in re.finditer(
+            r"<!--\s*task:\s*([A-Za-z0-9._]+)\s*\|[^>]*?evidence:\s*([^>]*?)-->", t):
+        out[m.group(1)] = [f.strip() for f in m.group(2).split(",") if f.strip()]
+    return out
+
+
+def classify(path: Path) -> str:
+    if not path.exists():
+        return "MISSING"
+    src = path.read_text(encoding="utf-8", errors="replace")
+    reads, calls = bool(READS_SOURCE.search(src)), loads_repo_module(src)
+    if calls and reads:
+        return "MIXED"
+    if calls:
+        return "BEHAVIOURAL"
+    if reads:
+        return "SOURCE"
+    return "NEITHER"
+
+
+def main() -> int:
+    import numpy as np
+    import scipy.stats as st
+    from statsmodels.stats.proportion import proportion_confint
+
+    ev = evidence_map()
+    strict, loose, missing, nofiles = [], [], [], []
+    rows = []
+    for tid in FLAGGED:
+        files = ev.get(tid, [])
+        if not files:
+            nofiles.append(tid)
+            rows.append((tid, "(none named)", ""))
+            continue
+        kinds = [classify(REPO / f) for f in files]
+        for f, k in zip(files, kinds):
+            if k == "MISSING":
+                missing.append(f"{tid}: {f}")
+        executing = [k for k in kinds if k in ("BEHAVIOURAL", "MIXED")]
+        if not executing:
+            strict.append(tid)
+        # UPPER BOUND: any named file that reads a source text at all. A MIXED
+        # file loads a repository module AND reads a file's text, so it *may*
+        # still assert only on that text -- loading is not asserting. Counting
+        # MIXED here is what makes this an upper bound rather than a guess.
+        if any(k in ("SOURCE", "MIXED") for k in kinds):
+            loose.append(tid)
+        rows.append((tid, f"{len(files)} file(s)", " ".join(sorted(set(kinds)))))
+
+    w = max(len(r[1]) for r in rows)
+    for tid, n, k in rows:
+        mark = "STRICT" if tid in strict else ("loose" if tid in loose else "")
+        print(f"  {tid:5s} {n:<{w}s}  {k:<28s} {mark}")
+
+    n = len(FLAGGED)
+    print(f"\nentries flagged                        : {n}")
+    print(f"entries naming NO evidence file        : {len(nofiles)} {nofiles}")
+    print(f"named evidence files that do not exist : {len(missing)} {missing}")
+    print(f"STRICT (nothing named executes)        : {len(strict)}  {sorted(strict)}")
+    print(f"LOOSE  (any named file reads a source text): {len(loose)}  {sorted(loose)}")
+    print(f"\nbrief states                           : 25 of {n}")
+    lo_b, hi_b = len(strict), len(loose)
+    inside = lo_b <= 25 <= hi_b
+    print(f"mechanical bracket                     : [{lo_b}, {hi_b}] of {n}")
+    print("VERDICT: " + (
+        f"NOT DERIVABLE. 25 lies inside [{lo_b}, {hi_b}], a bracket {hi_b-lo_b} "
+        f"wide on a population of {n}, so this instrument can neither confirm "
+        f"nor refute it. That is the finding: a 2-figure count was cited with no "
+        f"producing script, and the tightest mechanical bracket does not pin it."
+        if inside else
+        f"REFUTED. 25 lies outside [{lo_b}, {hi_b}]."))
+    print(f"  hard floor: {lo_b} of {n} name evidence that loads no repository "
+          f"module at all and therefore cannot execute anything.")
+
+    for label, k in (("strict", len(strict)), ("loose", len(loose))):
+        lo, hi = proportion_confint(k, n, method="wilson")
+        z = st.norm.ppf(0.975); p = k / n; d = 1 + z * z / n
+        c = (p + z * z / (2 * n)) / d
+        h = z * np.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / d
+        assert abs(lo - (c - h)) < 1e-12 and abs(hi - (c + h)) < 1e-12, \
+            "statsmodels and scipy disagree"
+        print(f"  {label:6s} {k}/{n} = {100*p:7.4f}%  "
+              f"Wilson [{100*lo:.4f}%, {100*hi:.4f}%]  (2 tools agree to 0.0e+00)")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

