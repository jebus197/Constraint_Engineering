--- /dev/null	2026-09-17 01:37:39
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_km_cdv9k/repo/scripts/falsifier_import_forms_are_detected_2026-09-17.py	2026-09-17 01:24:06
@@ -0,0 +1,74 @@
+#!/usr/bin/env python3
+"""FALSIFIER: does the execute-do-not-grep census see every way a test loads code?
+
+This guards the defect that broke the census 3 times while it was being written.
+Classifying a test as "asserts on source text, executes nothing" is only sound
+if the classifier recognises how the test actually reaches the code. This
+repository uses at least 3 forms, and a classifier that knows only the first
+reports a test as inert when its assertions are live calls:
+
+  A. `from bench... import X`             -- the obvious one
+  B. `importlib.util.spec_from_file_location(...)`  (L2's evidence file, which
+     loads scripts/note_vagueness_lint.py and calls LINT.lint 17 times)
+  C. `sys.path.insert(...)` then a bare `import reference_runner_v3 as rr`
+     (9.1's evidence file, which calls rr.study_programme_report)
+
+Missing B alone moved the census's strict count from 22 to 11; missing C moved
+it from 11 to 3. The figure is that sensitive, so the detector needs a guard.
+
+Raises AssertionError / prints FALSIFIED iff any known form goes undetected.
+"""
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+CENSUS = REPO / "scripts" / "execute_not_grep_census_2026-09-17.py"
+
+#: (file, form, a live call in that file that a source-only reading would miss)
+CASES = [
+    ("bench/tests/test_falsifier_C0002_compose_purity_2026-09-10.py",
+     "A: direct package import", None),
+    ("bench/tests/test_note_vagueness_lint_2026-08-23.py",
+     "B: importlib spec_from_file_location", "LINT.lint"),
+    ("bench/tests/test_study_programme_is_reported_2026-09-10.py",
+     "C: sys.path.insert + bare import", "rr.study_programme_report"),
+    ("bench/tests/test_done_markers_carry_evidence_2026-09-10.py",
+     "C: sys.path.insert + bare import", "M."),
+]
+
+
+def main() -> int:
+    spec = importlib.util.spec_from_file_location("_census", CENSUS)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    detect = getattr(mod, "loads_repo_module", None)
+    if detect is None:  # draft 1/2 exposed only a regex
+        rx = mod.CALLS_REPO
+        def detect(src): return bool(rx.search(src))
+
+    bad = []
+    for rel, form, call in CASES:
+        p = REPO / rel
+        assert p.exists(), f"case file missing: {rel}"
+        src = p.read_text(encoding="utf-8", errors="replace")
+        got = detect(src)
+        if call is not None and call not in src:
+            bad.append(f"{rel}: expected live call {call!r} is not in the file; "
+                       f"this case no longer tests what it claims")
+        print(f"  {form:38s} detected={got}  {rel.split('/')[-1]}")
+        if not got:
+            bad.append(f"{rel}: form [{form}] NOT detected, so a file that calls "
+                       f"{call} would be classified as executing nothing")
+
+    if bad:
+        print("FALSIFIED")
+        raise AssertionError("the census classifier is blind to a load form:\n  "
+                             + "\n  ".join(bad))
+    print("OK: all 3 load forms detected")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

