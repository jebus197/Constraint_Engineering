+#!/usr/bin/env python3
+"""FALSIFIER: do entry L2's stated figures reproduce from the script it names?
+
+L2 states a measurement -- notes scanned, false positives removed, false
+positives added, share, and a Wilson interval -- and names
+`scripts/quote_exemption_effect_2026-09-09.py` as its source.
+`measured-rate-travels-with-its-script` says a measured figure may be cited
+only if the script that produced it is committed beside it; the point of
+committing it is that the figure can be RE-EXECUTED, not merely attributed.
+
+The existing 8th commit guard, `scripts/wilson_interval_consistency.py`, cannot
+catch a stale figure here: L2's stated pair is 8 of 1138 with Wilson
+[0.4%, 1.4%], which is the exactly correct interval for that count. The figure
+is arithmetically coherent and describes a corpus that no longer exists -- the
+wrong-but-coherent class that guard's own docstring names as out of its reach.
+So this falsifier RUNS the script and compares.
+
+Raises AssertionError / prints FALSIFIED iff a figure stated in L2 differs from
+what the named script prints today. Exits cleanly when they agree.
+"""
+from __future__ import annotations
+
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+TASKS = REPO / "experimental_notes" / "CDSFL_MASTER_TASK_LIST.md"
+SCRIPT = REPO / "scripts" / "quote_exemption_effect_2026-09-09.py"
+
+
+def entry(tid: str) -> str:
+    t = TASKS.read_text(encoding="utf-8")
+    ms = list(re.finditer(r"<!--\s*task:\s*([A-Za-z0-9._]+)\s*\|", t))
+    for i, m in enumerate(ms):
+        if m.group(1) == tid:
+            return t[m.start(): ms[i + 1].start() if i + 1 < len(ms) else len(t)]
+    raise AssertionError(f"entry {tid} not found")
+
+
+def main() -> int:
+    proc = subprocess.run([sys.executable, str(SCRIPT)], capture_output=True, text=True)
+    out = proc.stdout
+    print("--- named script, re-executed ---")
+    print("\n".join(out.splitlines()[:8]))
+    print(f"--- exit code: {proc.returncode} ---")
+
+    def grab(label: str) -> int:
+        m = re.search(rf"{label}\s*:?\s*([0-9]+)", out)
+        assert m, f"script did not print '{label}'"
+        return int(m.group(1))
+
+    notes = grab(r"notes scanned")
+    before = grab(r"findings BEFORE the fix")
+    removed = grab(r"removed \(were inside a verbatim quotation\)")
+    added = grab(r"ADDED   \(would be a regression\)")
+
+    body = entry("L2")
+    bad = []
+    # Each figure is looked for as a STATED number in L2's prose.
+    for name, truth, pat in [
+        ("notes scanned", notes, r"across\s+([0-9,]+)\s+notes"),
+        ("false positives removed", removed, r"([0-9,]+)\s+false positives removed"),
+        ("findings denominator", before, r"of\s+([0-9,]+)\s+findings"),
+    ]:
+        m = re.search(pat, body)
+        if not m:
+            bad.append(f"{name}: L2 states no figure matching /{pat}/")
+            continue
+        stated = int(m.group(1).replace(",", ""))
+        flag = "" if stated == truth else "   <-- MISMATCH"
+        print(f"{name:26s} stated={stated:<6} re-executed={truth:<6}{flag}")
+        if stated != truth:
+            bad.append(f"{name}: L2 states {stated}, script prints {truth}")
+
+    m = re.search(r"([0-9]+)\s+added", body)
+    print(f"{'false positives added':26s} stated={m.group(1) if m else '?':<6} "
+          f"re-executed={added}")
+    if m and int(m.group(1)) != added:
+        bad.append(f"added: L2 states {m.group(1)}, script prints {added}")
+
+    if proc.returncode != 0:
+        bad.append(f"the named script exits {proc.returncode}, so it cannot be "
+                   f"run as a check at all")
+
+    if bad:
+        print("FALSIFIED")
+        raise AssertionError("entry L2 states figures its own named script does "
+                             "not produce:\n  " + "\n  ".join(bad))
+    print("OK: every figure L2 states re-executes from the script it names")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

### cc2:scripts/falsifier_P7_evidence_is_falsifiable_2026-09-17.py
--- /dev/null	2026-09-17 01:37:39
