@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+"""FALSIFIER for task P7. MUTATION-BASED, not textual.
+
+P7 claims 4 mechanisms bind the ASSISTANT mechanically. Its `evidence:` marker
+names one file. The question a DONE marker's evidence must answer is: CAN IT FAIL
+WHEN THE CLAIM IS FALSE? So each mechanism is broken in turn and the named
+evidence is re-run. Evidence that stays green while the mechanism it vouches for
+is destroyed does not establish the claim -- it sits next to it.
+
+RED  = some mechanism can be destroyed with the named evidence still passing.
+GREEN= every mechanism P7 names is covered by evidence that goes red when broken.
+"""
+import pathlib, re, subprocess, sys
+
+REPO = pathlib.Path(__file__).resolve().parents[1]  # was .parent: resolved to scripts/, so every read failed (2026-09-17)
+LIST = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else \
+    REPO / "experimental_notes" / "CDSFL_MASTER_TASK_LIST.md"
+
+MUTATIONS = [
+    ("figure re-execution (check_declared_figures)",
+     REPO / "scripts" / "panel_brief_validate.py",
+     "def check_declared_figures(text: str, repo: Path = REPO,",
+     "def check_declared_figures(text, repo=REPO, *a, **k):\n    return []\n\n"
+     "def _dead_check_declared_figures(text: str, repo: Path = REPO,"),
+    ("DONE-evidence guard (unsupported_done_entries)",
+     REPO / "scripts" / "task_list_markers.py",
+     "def unsupported_done_entries(failed_nodeids, path: Path = LIST) -> dict[str, list[str]]:",
+     "def unsupported_done_entries(failed_nodeids, path=LIST, *a, **k):\n    return {}\n\n"
+     "def _dead_unsupported_done_entries(failed_nodeids, path: Path = LIST) -> dict[str, list[str]]:"),
+]
+
+marker = re.search(r"<!--\s*task:\s*P7\s*\|[^>]*evidence:\s*([^|>]+?)\s*-->",
+                   LIST.read_text(encoding="utf-8"))
+named = [s.strip() for s in marker.group(1).split(",") if s.strip()]
+print(f"P7 evidence marker names {len(named)} file(s):")
+for n in named: print("   ", n)
+
+def run(files):
+    r = subprocess.run([sys.executable, "-m", "pytest", "-q", "-p", "no:cacheprovider",
+                        *[str(REPO / f) for f in files]],
+                       capture_output=True, text=True, cwd=REPO)
+    return r.returncode, (r.stdout.strip().splitlines() or [""])[-1]
+
+code, tail = run(named)
+print(f"\nBASELINE (mechanisms intact): exit={code}  {tail}")
+if code != 0:
+    print("FALSIFIER INCONCLUSIVE: named evidence is red before any mutation.")
+    sys.exit(2)
+
+fails = []
+for label, path, old, new in MUTATIONS:
+    src = path.read_text(encoding="utf-8")
+    assert src.count(old) == 1, f"anchor not unique in {path}: {src.count(old)}"
+    try:
+        path.write_text(src.replace(old, new), encoding="utf-8")
+        code, tail = run(named)
+        verdict = "DETECTED (red)" if code != 0 else "NOT DETECTED (still green)"
+        print(f"\nMUTATION: {label}\n  named evidence -> exit={code}  {tail}\n  {verdict}")
+        if code == 0:
+            fails.append(f"{label}: destroyed, and the named evidence still passes")
+    finally:
+        path.write_text(src, encoding="utf-8")
+
+if fails:
+    print("\nFALSIFIER RED -- P7's evidence does not establish P7's claim:")
+    for f in fails: print("  " + f)
+    sys.exit(1)
+print("\nFALSIFIER GREEN -- every mechanism P7 names is held by the evidence it names.")

