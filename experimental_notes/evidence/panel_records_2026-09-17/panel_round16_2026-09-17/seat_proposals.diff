+#!/usr/bin/env python3
+"""FALSIFIER: does the overclaim census list every entry its own evidence flags?
+
+`scripts/done_audit_overclaim_rate_2026-09-17.py` derives the round-1 half of
+its answer from the committed verdicts file, but carries the round-2 half as a
+HAND-TYPED constant, `ROUND2_UPHELD`. A hand-typed constant is not a
+measurement: it can silently omit an entry the evidence flags, and nothing in
+the script notices, because the constant is never compared against the file it
+was transcribed from.
+
+This falsifier does that comparison. It reads `round2_never_audited_13.json` --
+the same committed evidence -- takes every entry whose verdict is NOT
+"SUPPORTED" (i.e. PARTIAL or UNSUPPORTED: the entry claims more than its
+evidence shows, which is exactly the census's population), intersects with the
+task list's real DONE ids, and checks the census emits all of them.
+
+Raises AssertionError / prints FALSIFIED iff the census omits one.
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+EVID = REPO / "experimental_notes" / "evidence" / "done_audit_2026-09-11"
+CENSUS = REPO / "scripts" / "done_audit_overclaim_rate_2026-09-17.py"
+
+
+def _census():
+    spec = importlib.util.spec_from_file_location("_census", CENSUS)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def main() -> int:
+    mod = _census()
+    emitted, real = mod.overclaiming()
+
+    rounds = json.loads((EVID / "round2_never_audited_13.json").read_text(encoding="utf-8"))
+    r2 = [e for d in rounds for e in d.get("entries", [])]
+    flagged = {str(e["id"]).strip() for e in r2
+               if str(e.get("verdict", "")).strip().upper() != "SUPPORTED"}
+    should = flagged & real
+
+    missing = sorted(should - emitted)
+    print(f"round-2 entries adjudicated      : {len(r2)}")
+    print(f"round-2 NOT 'SUPPORTED'          : {len(flagged)}  {sorted(flagged)}")
+    print(f"  ... of those, real DONE ids    : {len(should)}  {sorted(should)}")
+    const = getattr(mod, "ROUND2_UPHELD", None)
+    if const is None:
+        r2set = mod.round2_upheld()
+        print(f"census round-2 set (DERIVED)     : {len(r2set)}  {sorted(r2set)}")
+    else:
+        print(f"census hand-typed ROUND2_UPHELD  : {len(const)}  {sorted(const)}")
+    print(f"census emits                     : {len(emitted)} ids")
+    print(f"OMITTED BY THE CENSUS            : {missing}")
+
+    # No phantom-id check here: the fix makes `(r1 | round2_upheld()) & real`
+    # intersect BOTH rounds, so a non-existent round-2 id cannot enter the
+    # numerator at all. A detector for a condition the structure forbids is an
+    # addition nothing reaches. The control run in this finding's report is the
+    # committed measurement: reverting the fix reproduces the omission, so the
+    # structural form is what is doing the work.
+
+    if missing:
+        print("FALSIFIED")
+        raise AssertionError(
+            f"the census omits {len(missing)} entry/entries its own committed "
+            f"evidence marks as claiming more than it shows: {missing}. "
+            f"The reported count of {len(emitted)} is short by {len(missing)}.")
+    print("OK: census set matches its evidence")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

