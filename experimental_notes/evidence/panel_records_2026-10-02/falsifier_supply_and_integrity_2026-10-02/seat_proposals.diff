+    print(f"  cut B: post-2026-06-06 (date cut, undated dropped)  : {len(postjun)}")
+    print(f"  rows in A but not B                                 : "
+          f"{len(set(post42) - set(postjun))}")
+    print(f"  rows in B but not A                                 : "
+          f"{len(set(postjun) - set(post42))}")
