+def run_date(run: str):
+    """The date in a run directory name, or None if it carries none."""
+    for rx in DATE_RES:
+        m = rx.search(run)
+        if m:
+            try:
+                return datetime.date(int(m.group(1)), int(m.group(2)),
+                                     int(m.group(3)))
+            except ValueError:
+                pass
+    return None
