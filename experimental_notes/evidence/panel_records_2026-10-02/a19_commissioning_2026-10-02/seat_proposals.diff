+            [{"code": "F706"}, {"code": "E501"}, {"code": None}]) == 1
+
+    def test_ruff_really_does_raise_f706_on_the_extracted_blob(self, tmp_path):
+        """EXECUTE, DO NOT GREP. If ruff stops raising F706 the discount is dead
