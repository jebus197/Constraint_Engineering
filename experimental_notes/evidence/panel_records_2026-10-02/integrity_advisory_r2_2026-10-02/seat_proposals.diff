+def _reg(**entry) -> FindingRegistry:
+    r = FindingRegistry()
+    base = {"status": "UNCONFIRMED", "severity": 0.8, "description": "x"}
+    base.update(entry)
+    r.entries["C9001"] = base
+    return r
