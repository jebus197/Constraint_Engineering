+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_s9u34xto/repo/scripts/stamp_the_brief_artefacts_2026-11-06.py	2026-11-17 00:51:31
@@ -195,3 +195,64 @@
                                    or not lines[at].strip()):
             at += 1
     return "\n".join(lines[:at] + ["", block] + lines[at:]) + "\n"
+
+
+#: ★ B125 HALF 2, THE DISPATCHER REFUSAL. AWAITING FOUNDER RULING -- written so
+#: the composed form can be ruled on against a MEASUREMENT rather than against a
+#: judgement, which is what entry B125 says is missing. Nothing below is armed
+#: until `stamp_brief_at_dispatch` calls it; see that function's own marker.
+#:
+#: WHY THIS EXISTS AT ALL, AND IT IS NOT "THE 2 HALVES CAN COEXIST". Half 1, the
+#: stamp, is BUILT and reached briefs from 2026-11-06. It is also, alone, capable
+#: of ACTIVELY MISLEADING a seat, which is stronger than merely being incomplete:
+#: `stamp_brief_at_dispatch` takes the branch "already present, left as it is"
+#: whenever a stamp table is found, so a table written when the brief was
+#: AUTHORED ships UNVERIFIED if an artefact moved before dispatch -- while the
+#: block's own header tells the seat its reading "was correct against the state
+#: below". Demonstrated 2026-11-17 on a scratch repo: author-time stamp
+#: 91d6a3d55e9fea79, dispatch-time file e5a2301a94c457e5, table shipped unchanged.
+#:
+#: WHY NOT THE EXISTING mtime CHECK, which is the half that already refuses
+#: nothing. `scripts/panel_brief_validate.py:check_currency` compares
+#: MODIFICATION TIMES and is deliberately a WARNING, for a stated reason: "a
+#: validator that blocks on it teaches people to skip the validator." That reason
+#: is CORRECT FOR mtime AND FALSE FOR sha256, and the difference is measured, not
+#: argued. Over the 10 artefacts this round's brief names, a content-preserving
+#: `touch` moves mtime on 10 of 10 (false-positive rate 1.000000) and moves
+#: sha256 on 0 of 10 (0.000000), while a genuine 1-line edit is caught by BOTH on
+#: 10 of 10. So the digest half is what makes a REFUSAL affordable, and the
+#: refusal is what makes the digest half bite. Neither alone does both jobs, and
+#: that is the founder's STRONG sense of composability -- a demonstrated
+#: advantage over each fix alone -- rather than the weak "they do not conflict"
+#: sense his 2026-10-02 wording excludes by name.
+#:
+#: IT REFUSES ONLY ON A VERIFIED MISMATCH, never on its own malfunction. An
+#: unparseable row is SKIPPED rather than treated as drift, because a guard that
+#: refuses when it cannot see is the shape this project keeps having to withdraw.
+_STAMP_ROW = __import__("re").compile(
+    r"^\|\s*`([^`]+)`\s*\|\s*`([0-9a-f]{16})`\s*\|", __import__("re").M)
+
+
+def verify_stamp_currency(text: str, repo: Path = REPO) -> list[tuple[str, str, str]]:
+    """Rows of an EXISTING stamp table whose artefact no longer hashes to it.
+
+    Returns `(path, stamped_prefix, live_prefix)` per mismatch, empty when the
+    table is current, when there is no table, or when no row can be read. A
+    missing file is reported as a mismatch with `live` = `ABSENT`, because a
+    brief naming a file that is gone is the same harm by a shorter route.
+    """
+    if "ARTEFACT STAMPS AT DISPATCH" not in text:
+        return []
+    out: list[tuple[str, str, str]] = []
+    for rel, stamped in _STAMP_ROW.findall(text):
+        p = repo / rel
+        if not p.is_file():
+            out.append((rel, stamped, "ABSENT"))
+            continue
+        try:
+            live = hashlib.sha256(p.read_bytes()).hexdigest()[:16]
+        except OSError:
+            continue                      # cannot see it: not evidence of drift
+        if live != stamped:
+            out.append((rel, stamped, live))
+    return out

