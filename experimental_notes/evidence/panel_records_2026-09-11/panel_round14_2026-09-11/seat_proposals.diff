### cc2:bench/tests/test_restage_preserves_partial_staging_2026-09-11.py
--- /dev/null	2026-09-11 07:13:50
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_1o2g2e06/repo/bench/tests/test_restage_preserves_partial_staging_2026-09-11.py	2026-09-11 07:07:21
@@ -0,0 +1,310 @@
+"""The stage-0 re-staging must not commit hunks the author withheld.
+
+MEASURED 2026-09-11, ROUND 14.  `hooks/stage0_restage.sh` was added earlier the
+same day to cure the opposite defect: repairs wrote the working tree, never
+`git add`ed, so every clone at HEAD shipped unrepaired content (3 failures in a
+fresh clone against 0 in the maintainer's tree).  Its stated mitigation --
+"ONLY the exact paths a repair REPORTS changing are staged" -- bounds which
+FILES are touched.  It does not bound which HUNKS, and `git add -- <path>`
+stages whole files.  Reproduced in a scratch repository before the fix:
+
+    staged by author : L1 AUTHOR-STAGED / L3 original / L5 original
+    working tree     : L1 AUTHOR-STAGED / L3 REPAIRED / L5 AUTHOR-WIP
+    index afterwards : L1 AUTHOR-STAGED / L3 REPAIRED / L5 AUTHOR-WIP  <- swept
+
+AND THE PATHSPEC NOTICE FIRED ON THE WRONG COMMAND.  $GIT_INDEX_FILE, printed
+from a hook under git 2.50.1:
+
+    git commit            .git/index                      real index
+    git commit --amend    .git/index                      real index
+    git commit -a         <gitdir>/index.lock             real index
+    git commit -- <path>  <gitdir>/next-index-<pid>.lock   TEMPORARY index
+
+`index.lock` matched none of the escapes, so every `git commit -am` was told
+"this is a pathspec commit" and that files outside the pathspec would land --
+both false under -a.
+
+EVERY TEST HERE RUNS THE REAL hooks/stage0_restage.sh AGAINST A REAL GIT INDEX.
+`execute-do-not-grep`: a test that reads the hook's text proves only that the
+hook describes itself consistently.  `TestTheControlCanFail` re-runs the same
+scenario against a MUTATED copy of the library with the fix removed and requires
+the sweep-in to reappear -- without it, these assertions could be passing on a
+scenario that never had the defect.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+REPO = Path(__file__).resolve().parents[2]
+LIB = REPO / "hooks" / "stage0_restage.sh"
+
+pytestmark = pytest.mark.skipif(shutil.which("git") is None,
+                                reason="git is not on PATH")
+
+BASE = "L1 original\nL2 original\nL3 original\nL4 original\nL5 original\n"
+AUTHOR_STAGED = ("L1 AUTHOR-STAGED\nL2 original\nL3 original\n"
+                 "L4 original\nL5 original\n")
+WORKTREE = ("L1 AUTHOR-STAGED\nL2 original\nL3 original\n"
+            "L4 original\nL5 AUTHOR-WIP\n")
+REPAIRED = ("L1 AUTHOR-STAGED\nL2 original\nL3 REPAIRED\n"
+            "L4 original\nL5 AUTHOR-WIP\n")
+
+
+def _sh(script: str, cwd: Path) -> subprocess.CompletedProcess:
+    env = dict(os.environ)
+    env.pop("GIT_INDEX_FILE", None)
+    env.pop("GIT_DIR", None)
+    return subprocess.run(["sh", "-c", script], cwd=str(cwd), env=env,
+                          capture_output=True, text=True, timeout=600)
+
+
+def _git(cwd: Path, *args: str) -> str:
+    env = dict(os.environ)
+    env.pop("GIT_INDEX_FILE", None)
+    env.pop("GIT_DIR", None)
+    r = subprocess.run(["git", *args], cwd=str(cwd), env=env,
+                       capture_output=True, text=True, timeout=600)
+    assert r.returncode == 0, f"git {args} failed: {r.stderr}"
+    return r.stdout
+
+
+@pytest.fixture
+def repo(tmp_path: Path) -> Path:
+    """A scratch repo where note.md is PARTIALLY staged, exactly as `git add -p`
+    leaves it: hunk 1 in the index, hunk 2 only in the working tree."""
+    d = tmp_path / "r"
+    d.mkdir()
+    _git(d, "init", "-q", ".")
+    _git(d, "config", "user.email", "t@t")
+    _git(d, "config", "user.name", "t")
+    (d / "note.md").write_text(BASE, encoding="utf-8")
+    _git(d, "add", "-A")
+    _git(d, "commit", "-qm", "base")
+    # Stage hunk 1 only: put AUTHOR_STAGED in the index, WORKTREE on disk.
+    blob = tmp_path / "staged"
+    blob.write_text(AUTHOR_STAGED, encoding="utf-8")
+    h = _git(d, "hash-object", "-w", str(blob)).strip()
+    _git(d, "update-index", "--cacheinfo", f"100644,{h},note.md")
+    (d / "note.md").write_text(WORKTREE, encoding="utf-8")
+    assert _git(d, "status", "--short").strip().startswith("MM"), \
+        "the fixture did not produce a partially staged file"
+    return d
+
+
+def _run_stage0(repo: Path, lib: Path) -> subprocess.CompletedProcess:
+    """Snapshot, let a 'repair' edit the file, then re-stage -- the hook's own
+    order, with the repair standing in for the citation guard.
+
+    The repaired content is delivered by copying a prepared file rather than by
+    `printf`, because `printf %s` does not expand `\n` and the first version of
+    this helper wrote a single line containing a literal backslash-n.  The tests
+    still went red, which is the only reason it was noticed.
+    """
+    src = repo.parent / "repaired_content"
+    src.write_text(REPAIRED, encoding="utf-8")
+    return _sh(
+        f'. "{lib}"\n'
+        'cdsfl_snapshot_partially_staged\n'
+        f'cp "{src}" note.md\n'
+        'printf "  note.md: 3 -> 3  (`sym`)\\n" | '
+        'cdsfl_restage_from_citation_output\n',
+        repo)
+
+
+class TestTheRepairLandsWithoutTheWip:
+    def test_the_repair_reaches_the_index(self, repo):
+        """The whole point of the file: the repair must not lag a commit."""
+        r = _run_stage0(repo, LIB)
+        staged = _git(repo, "show", ":note.md")
+        assert "L3 REPAIRED" in staged, (
+            f"the repair did not reach the index; the defect this file exists "
+            f"to close is back.\nstdout={r.stdout}\nstderr={r.stderr}")
+
+    def test_the_withheld_hunk_is_not_swept_in(self, repo):
+        """THE FINDING.  L5 was deliberately left unstaged; it must stay out."""
+        r = _run_stage0(repo, LIB)
+        staged = _git(repo, "show", ":note.md")
+        assert "AUTHOR-WIP" not in staged, (
+            f"the unstaged hunk was swept into the index and would have been "
+            f"committed.\nindex now:\n{staged}\nstderr={r.stderr}")
+        assert staged == REPAIRED.replace("L5 AUTHOR-WIP", "L5 original"), (
+            f"the index is not (staged content + repair delta):\n{staged}")
+
+    def test_the_working_tree_is_untouched(self, repo):
+        """No stash, so the author's WIP survives on disk whatever happens."""
+        _run_stage0(repo, LIB)
+        assert (repo / "note.md").read_text(encoding="utf-8") == REPAIRED
+
+    def test_an_ordinary_file_still_takes_the_plain_git_add_path(self, tmp_path):
+        """ADDITIVE: the common case must behave exactly as it did before."""
+        d = tmp_path / "o"
+        d.mkdir()
+        _git(d, "init", "-q", ".")
+        _git(d, "config", "user.email", "t@t")
+        _git(d, "config", "user.name", "t")
+        (d / "note.md").write_text(BASE, encoding="utf-8")
+        _git(d, "add", "-A")
+        _git(d, "commit", "-qm", "base")
+        r = _sh(f'. "{LIB}"\ncdsfl_snapshot_partially_staged\n'
+                'printf "changed\\n" > note.md\n'
+                'printf "  note.md: 3 -> 3  (`sym`)\\n" | '
+                'cdsfl_restage_from_citation_output\n', d)
+        assert _git(d, "show", ":note.md") == "changed\n"
+        assert "re-staged note.md" in r.stdout, r.stdout
+
+
+class TestTheControlCanFail:
+    """ANTI-VACUITY.  Three of this session's controls were vacuous on the first
+    attempt.  This one re-runs the identical scenario against the library with
+    the narrow path deleted, and requires the sweep-in to come back."""
