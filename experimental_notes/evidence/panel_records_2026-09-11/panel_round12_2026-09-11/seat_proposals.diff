+    with tempfile.TemporaryDirectory() as d:
+        p = pathlib.Path(d) / "case.py"
+        p.write_text(src)
+        return ms.classify(p)
+
+
+def test_pathlib_open_write_is_action():
+    kind, reasons = _classify(
+        'import pathlib\npathlib.Path("x").open("w").write("gone")\n')
+    assert kind == "ACTION", reasons
+
+
+def test_io_open_write_is_action():
+    kind, reasons = _classify('import io\nio.open("x", "w").write("gone")\n')
+    assert kind == "ACTION", reasons
+
+
+def test_os_open_flags_are_action():
+    kind, reasons = _classify(
+        'import os\nos.open("x", os.O_WRONLY | os.O_CREAT)\n')
+    assert kind == "ACTION", reasons
+
+
+def test_open_mode_keyword_is_action():
+    kind, reasons = _classify('open("x", mode="w").write("gone")\n')
+    assert kind == "ACTION", reasons
+
+
+def test_truncate_is_action():
+    kind, reasons = _classify('f = open("x")\nf.truncate(0)\n')
+    assert kind == "ACTION", reasons
+
+
+def test_plain_reads_stay_measurements():
+    kind, reasons = _classify(
+        'import pathlib\n'
+        'print(open("x").read())\n'
+        'print(pathlib.Path("y").open().read())\n'
+        'print(pathlib.Path("z").open("rb").read())\n'
+        'print(open("w_file.txt").read())\n')
+    assert kind == "MEASUREMENT", reasons
