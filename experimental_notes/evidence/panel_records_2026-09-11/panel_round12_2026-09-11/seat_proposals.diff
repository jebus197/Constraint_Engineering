+"""Panel round 12 (fable seat): tests for 4 instrument defects found this round.
+
+Each test targets a fix applied the same day, and each was RUN RED before the
+fix existed -- the red outputs are quoted in the panel return.
+
+  1. V2 instrument: `tracked()` conflated `git ls-files` rc 128 (not a git
+     repository) with rc 1 (untracked). In this panel's own sandbox -- a
+     worktree export with no `.git` -- the script printed "11 of 11 still fail
+     a MECHANICAL check = 100.0000%" with three confidence intervals: a
+     fabricated figure in the exact direction that puts a wrong number in
+     front of the founder.
+  2. V2 instrument: `check_figures_have_producers` and
+     `check_self_contradiction` ran over `Entry.text` -- the entry LINE -- the
+     same population error the script's own docstring documents as "caught
+     before it became the answer". Over the LINE population 21 entries carry
+     figures; over the BLOCK population 47 do, and W1 is an orphan the
+     shipped instrument could not see.
+  3. A16 classifier: four resolvable write forms classed MEASUREMENT --
+     `Path.open("w")`, `io.open(..., "w")`, `os.open(..., O_WRONLY)`,
+     `open(..., mode="w")` -- plus `f.truncate()`. Each is an ACTION wrongly
+     classed as a measurement, the asymmetric direction the docstring says
+     the classifier is built to prevent.
+  4. A18 census: `declared_fields` drops every list-valued key from the
+     default population (`walk` recurses into lists and records nothing), so
+     an unread list-valued config key could never be flagged.
+"""
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+
+
+def _load(name: str, rel: str):
+    spec = importlib.util.spec_from_file_location(name, REPO / rel)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+# ---------------------------------------------------------------- 1. tracked()
+
+def test_tracked_distinguishes_no_repo_from_untracked(tmp_path):
+    ov = _load("ov_fix", "scripts/overstated_entries_2026-09-11.py")
+    # a directory that is not a git repository: rc 128 must RAISE, not say False
+    no_repo = tmp_path / "norepo"
+    no_repo.mkdir()
+    (no_repo / "f.txt").write_text("x")
+    try:
+        ov.tracked("f.txt", cwd=no_repo)
+    except RuntimeError:
+        pass
+    else:
+        raise AssertionError("tracked() must refuse outside a git repository, "
+                             "not report 'not tracked'")
+    # a real repository: untracked is False, tracked is True
+    repo = tmp_path / "repo"
+    repo.mkdir()
+    subprocess.run(["git", "init", "-q", str(repo)], check=True)
+    (repo / "a.txt").write_text("x")
+    assert ov.tracked("a.txt", cwd=repo) is False
+    subprocess.run(["git", "-C", str(repo), "add", "a.txt"], check=True)
+    assert ov.tracked("a.txt", cwd=repo) is True
+
+
+def test_v2_script_refuses_to_summarise_without_git():
+    """Outside a git repository the script must exit non-zero with a refusal,
+    never print a fabricated failure rate. Run against THIS tree only when it
+    is not a repository (the panel sandbox); otherwise skip -- copying the
+    whole tree is not worth it."""
+    r = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"],
+                       cwd=REPO, capture_output=True, text=True)
+    if r.returncode == 0:
+        import pytest
+        pytest.skip("tree is a git repository; the refusal path needs a "
+                    "non-repo tree")
+    p = subprocess.run([sys.executable,
+                        str(REPO / "scripts/overstated_entries_2026-09-11.py")],
+                       cwd=REPO, capture_output=True, text=True)
+    assert p.returncode != 0, "must refuse outside a git repository"
+    assert "not a git repository" in (p.stdout + p.stderr).lower()
+    assert "still fail a MECHANICAL check" not in p.stdout, \
+        "a summary printed without git is a fabricated figure"
+
+
+# ---------------------------------------------- 2. block population, not line
+
+_FIXTURE = """\
+**1.1 An entry whose figure lives in its continuation paragraph. DONE.**
+<!-- task: 1.1 | state: DONE | status: COMMITTED | evidence: x.py -->
+The continuation line carries 37.3134% and cites no producing script.
+
