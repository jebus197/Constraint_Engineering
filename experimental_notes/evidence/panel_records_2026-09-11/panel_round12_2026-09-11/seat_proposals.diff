+"""Panel round 12 (fable): A7's predicate is underdetermined by its anchor.
+
+The A7 script chose `severity >= 0.7 AND hil_escalated AND no falsifier_code`
+partly because it reproduces the entry's family figure `exp55_v3_control = 8`.
+Measured this round: dropping the severity filter ALSO reproduces 8 on the
+exp55_v3_control family (2 + 6 across its two timestamped runs) while
+returning a total of 32, not 22 -- so the single-anchor check does not
+identify the predicate, and 22 is one member of a family {20, 22, 32}.
+The ACTIONABLE conclusion survives: ANONYMOUS = 0 under the widest candidate
+too. This test pins both facts so the disclosure cannot rot silently.
+"""
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+
+
+def _load():
+    spec = importlib.util.spec_from_file_location(
+        "ep_t", REPO / "scripts/escalation_paths_2026-09-11.py")
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+def test_predicate_family_is_disclosed_and_anonymous_is_robust():
+    ep = _load()
+    fam = ep.predicate_family()
+    shipped = fam["shipped"]
+    no_sev = fam["no_severity_filter"]
+    # both reproduce the anchor -- which is exactly why the anchor cannot
+    # identify the predicate
+    assert shipped["exp55_family"] == 8, shipped
+    assert no_sev["exp55_family"] == 8, no_sev
+    assert shipped["total"] != no_sev["total"], (
+        "if the totals now coincide, the underdetermination disclosure is "
+        "stale and the script text must be revisited")
+    # the conclusion that matters is robust across the family
+    assert shipped["anonymous"] == 0
+    assert no_sev["anonymous"] == 0
+
+
+def test_disclosure_reaches_the_reader(capsys):
+    """The wired check the additive standard requires: main() prints it."""
+    ep = _load()
+    ep.main()
+    out = capsys.readouterr().out
+    assert "UNDERDETERMINED" in out
+    assert "32" in out and "22" in out

