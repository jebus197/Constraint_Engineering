--- /dev/null	2026-09-11 04:09:20
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__q156qdl/repo/scripts/a7_predicate_is_underdetermined_2026-09-11.py	2026-09-11 03:59:52
@@ -0,0 +1,173 @@
+#!/usr/bin/env python3
+"""A7 attack: the family figure `exp55_v3_control = 8` does not pick out ONE predicate.
+
+A7 chose `severity >= 0.7 AND hil_escalated AND no falsifier_code` and defended the
+choice on the ground that it "reproduces the entry's OTHER family figure exactly,
+`exp55_v3_control` = 8, so it is almost certainly the one that was meant."
+
+A single scalar agreeing at a single site is a one-bit test. This script enumerates a
+family of nearby predicates -- each a defensible reading of the same English sentence
+"an archived critical escalated to a human with no falsifier" -- and reports
+(total, exp55_v3_control subtotal) for each. If more than one predicate hits the
+exp55 = 8 anchor while disagreeing on the TOTAL, the anchor does not identify the
+predicate, and A7's 22 is a CHOICE presented as a deduction.
+
+Writes a machine-readable summary so a test asserts on numbers, not on prose.
+"""
+from __future__ import annotations
+
+import json
+import pathlib
+import re
+
+REPO = pathlib.Path(__file__).resolve().parents[1]
+LOGS = REPO / "bench" / "logs"
+FAMILY = "exp55_v3_control"
+
+
+def critical_threshold() -> float:
+    src = (REPO / "bench" / "reference_runner_v3.py").read_text(encoding="utf-8")
+    m = re.search(r"^CRITICAL_SEVERITY_THRESHOLD\s*=\s*([\d.]+)", src, re.M)
+    assert m, "the runner no longer defines CRITICAL_SEVERITY_THRESHOLD"
+    return float(m.group(1))
+
+
+def raw_entries():
+    """(run, report_file, cid, entry) for EVERY registry entry, no deduplication.
+
+    A7 deduplicates first-seen per run. That dedup policy is itself one of the free
+    choices under test, so this generator keeps every occurrence and each predicate
+    applies its own policy.
+    """
+    for run in sorted(LOGS.iterdir()):
+        if not run.is_dir():
+            continue
+        for f in sorted(run.glob("*_report.json")):
+            try:
+                d = json.loads(f.read_text(encoding="utf-8", errors="replace"))
+            except (ValueError, OSError):
+                continue
+            for cid, e in ((d.get("registry") or {}).get("entries") or {}).items():
+                if isinstance(e, dict):
+                    yield run.name, f.name, cid, e
+
+
+def _sev(e):
+    try:
+        return float(e.get("severity"))
+    except (TypeError, ValueError):
+        return None
+
+
+def _no_falsifier_blankish(e) -> bool:
+    """A7's reading: missing key and empty/whitespace string both mean 'no falsifier'."""
+    return not (e.get("falsifier_code") or "").strip()
+
+
+def _no_falsifier_absent_key(e) -> bool:
+    """An equally literal reading: the field is not present at all."""
+    return "falsifier_code" not in e
+
+
+def build(thr: float):
+    def base(e):
+        s = _sev(e)
+        return s is not None and s >= thr and bool(e.get("hil_escalated")) \
+            and _no_falsifier_blankish(e)
+
+    def strict_sev(e):
+        s = _sev(e)
+        return s is not None and s > thr and bool(e.get("hil_escalated")) \
+            and _no_falsifier_blankish(e)
+
+    def absent_key(e):
+        s = _sev(e)
+        return s is not None and s >= thr and bool(e.get("hil_escalated")) \
+            and _no_falsifier_absent_key(e)
+
+    def reason_instead_of_flag(e):
+        s = _sev(e)
+        return s is not None and s >= thr \
+            and bool((e.get("hil_reason") or "").strip()) \
+            and _no_falsifier_blankish(e)
+
+    def also_no_falsification_present(e):
+        return base(e) and not e.get("falsification_present")
+
+    def any_severity(e):
+        return bool(e.get("hil_escalated")) and _no_falsifier_blankish(e)
+
+    def open_only(e):
+        return base(e) and str(e.get("status", "")).upper() != "CLOSED"
+
+    return {
+        "A7 baseline (sev>=thr, hil_escalated, blankish, dedup=first)": ("first", base),
+        "same but dedup=none (every report occurrence)": ("none", base),
+        "same but dedup=last (last report per run wins)": ("last", base),
+        "same but severity STRICTLY > thr": ("first", strict_sev),
+        "'no falsifier' = key ABSENT, not empty-string": ("first", absent_key),
+        "'escalated' = hil_reason non-empty, not the flag": ("first", reason_instead_of_flag),
+        "also require not falsification_present": ("first", also_no_falsification_present),
+        "drop the severity threshold entirely": ("first", any_severity),
+        "baseline restricted to status != CLOSED": ("first", open_only),
+    }
+
+
+def count(dedup: str, pred):
+    """Return (total, exp55 family subtotal, distinct contributing runs)."""
+    if dedup == "none":
+        rows = [(r, c) for r, _f, c, e in raw_entries() if pred(e)]
+    else:
+        per_run = {}
+        for r, _f, c, e in raw_entries():
+            d = per_run.setdefault(r, {})
+            if dedup == "first":
+                d.setdefault(c, e)
+            else:
+                d[c] = e
+        rows = [(r, c) for r, d in per_run.items() for c, e in d.items() if pred(e)]
+    fam = [x for x in rows if x[0].startswith(FAMILY)]
+    return len(rows), len(fam), len({r for r, _ in rows})
+
+
+def sensitivity(thr=None) -> dict:
+    thr = critical_threshold() if thr is None else thr
+    out = {}
+    for name, (dedup, pred) in build(thr).items():
+        total, fam, runs = count(dedup, pred)
+        out[name] = {"total": total, "exp55": fam, "runs": runs}
+    return out
+
+
+def main() -> int:
+    thr = critical_threshold()
+    results = sensitivity(thr)
+    print(f"threshold read from runner: {thr}")
+    print(f"anchor family: {FAMILY}  (A7 claims subtotal 8)\n")
+    print(f"{'total':>6}  {'exp55':>5}  {'runs':>4}  predicate")
+    for name, v in results.items():
+        flag = "  <-- hits the anchor" if v["exp55"] == 8 else ""
+        print(f"{v['total']:6d}  {v['exp55']:5d}  {v['runs']:4d}  {name}{flag}")
+
+    hits = {n: v for n, v in results.items() if v["exp55"] == 8}
+    totals = sorted({v["total"] for v in hits.values()})
+    print(f"\npredicates reproducing exp55_v3_control = 8 : {len(hits)}")
+    print(f"distinct TOTALS among them                  : {totals}")
+    if len(totals) > 1:
+        print("\nTHE ANCHOR DOES NOT IDENTIFY THE PREDICATE. Two or more readings of the\n"
+              "same sentence agree at exp55 and disagree on the total, so 22 is a CHOICE,\n"
+              "not a deduction from the anchor. The total must be reported "
+              "predicate-relative.")
+    else:
+        print("\nThe anchor is consistent with one total among the readings tested; A7's\n"
+              "defence survives THIS sample. It is not thereby proved unique.")
+
+    out = REPO / "logs" / "a7_predicate_sensitivity_2026-09-11.json"
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(json.dumps(results, indent=2, sort_keys=True), encoding="utf-8")
+    print(f"\nwrote {out.relative_to(REPO)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

### cc2:scripts/git_probe.py
--- /dev/null	2026-09-11 04:09:20
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__q156qdl/repo/scripts/git_probe.py	2026-09-11 03:47:50
@@ -0,0 +1,149 @@
+#!/usr/bin/env python3
+"""A git query that cannot be mistaken for an answer.
+
+WHY THIS EXISTS. `git status --porcelain` outside a work tree exits 128 and prints
+NOTHING ON STDOUT. Code that reads only `.stdout` therefore receives the exact
+byte string that means "the tree is clean". Three guards in this repository were
+built that way, and in a staged panel sandbox -- which carries no `.git` -- they
+did not warn, they AGREED:
+
+  * `bench/tests/test_measurement_survey_is_safe_2026-09-11.py` compared porcelain
+    before and against after and asserted equality. Both sides were `''`, so the
+    assertion held while the tree was being written to. The incident that test was
+    written for was a survey OVERWRITING A PRESERVED ARCHIVE.
+  * `scripts/overstated_entries_2026-09-11.py::tracked` returned `rc == 0`, so
+    every path came back UNTRACKED and V2's headline read "11 of 11 still fail a
+    MECHANICAL check = 100.0000%". The true failure was the probe, not the entries.
+  * `scripts/source_text_fragility_2026-09-11.py` read porcelain's stdout for its
+    post-run revert check, which therefore reported the target clean regardless.
+
+THE RULE THIS MODULE ENFORCES. A git probe returns either a MEASUREMENT or the
+explicit value `None`, never a default that reads as good news. `None` is
+UNCHECKED, and UNCHECKED is not a pass -- callers must handle it, and the
+tri-state makes forgetting to a type error rather than a silent green.
+
+`tree_manifest` is the git-independent fallback, so a caller that loses git loses
+the *convenience* of gitignore filtering, not the *check* itself.
+"""
+from __future__ import annotations
+
+import os
+import pathlib
+import subprocess
+
+#: Directories never worth snapshotting, and never part of the work product.
+_EXCLUDED_DIRS = frozenset({
+    ".git", "__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache",
+    ".venv", "venv", "node_modules", ".ipynb_checkpoints",
+})
+#: Build/editor droppings whose mtime moves for reasons no caller means to measure.
+_EXCLUDED_SUFFIXES = (".pyc", ".pyo", ".pyd", ".swp", ".orig")
+_EXCLUDED_NAMES = frozenset({".DS_Store"})
+
+
+class GitUnavailable(RuntimeError):
+    """Raised by `require_git` when a caller's claim genuinely needs git."""
+
+
+def _run(args, repo) -> subprocess.CompletedProcess:
+    try:
+        return subprocess.run(list(args), cwd=str(repo), capture_output=True,
+                              text=True)
+    except (OSError, ValueError) as exc:          # git absent from PATH entirely
+        return subprocess.CompletedProcess(args, 127, "", str(exc))
+
+
+def git_available(repo) -> bool:
+    """True only when `repo` is inside a git work tree AND git can be executed."""
+    return _run(["git", "rev-parse", "--git-dir"], repo).returncode == 0
+
+
+def porcelain(repo, *paths) -> str | None:
+    """`git status --porcelain` output, or None when git could not answer.
+
+    The empty string is reserved for its real meaning -- git ran and found the
+    tree clean. Anything else is None.
+    """
+    r = _run(["git", "status", "--porcelain", "--", *paths] if paths
+             else ["git", "status", "--porcelain"], repo)
+    return r.stdout if r.returncode == 0 else None
+
+
+def is_tracked(repo, path: str) -> bool | None:
+    """True / False / None, where None means git could not be asked.
+
+    `git ls-files --error-unmatch` exits non-zero BOTH for "this path is not
+    tracked" and for "this is not a repository". Distinguishing them is the entire
+    point of this function, so the repository check comes first.
+    """
+    if not git_available(repo):
+        return None
+    return _run(["git", "ls-files", "--error-unmatch", path], repo).returncode == 0
+
+
+def require_git(repo, why: str) -> None:
+    if not git_available(repo):
+        raise GitUnavailable(
+            f"{why}: this needs a git work tree and {repo} is not one. The claim "
+            f"is UNCHECKED, which is not the same as verified.")
+
+
+def tree_manifest(repo) -> dict:
+    """{relative path: (size, mtime_ns)} for the whole tree, WITHOUT using git.
+
+    Coarser than `git status` -- it has no gitignore -- but it is the fallback
+    that keeps a "nothing was written" claim falsifiable when git cannot answer.
+    It notices writes to ignored paths too, which `git status` does not.
+
+    USES `lstat`, NOT `stat`, AND THE FIRST VERSION USED `stat`. Reconciling this
+    function's count against an independent walk of the same tree left ONE file
+    unexplained: `bench/logs/exp36_evidence_20260407T004931Z/` holds a dangling
+    self-referential symlink, `os.stat` follows it, the follow fails, and the entry
+    was dropped. A snapshot that silently omits an entry it cannot follow cannot
+    detect that entry appearing or disappearing, so symlinks are now recorded by
+    their OWN metadata plus their target text.
+    """
+    root = pathlib.Path(repo).resolve()
+    out = {}
+    for dirpath, dirnames, filenames in os.walk(root):
+        dirnames[:] = [d for d in dirnames if d not in _EXCLUDED_DIRS]
+        for name in filenames:
+            if name in _EXCLUDED_NAMES or name.endswith(_EXCLUDED_SUFFIXES):
+                continue
+            full = os.path.join(dirpath, name)
+            try:
+                st = os.lstat(full)
+            except OSError:
+                continue
+            link = os.readlink(full) if os.path.islink(full) else ""
+            out[os.path.relpath(full, root)] = (st.st_size, st.st_mtime_ns, link)
+    return out
+
+
+def manifest_diff(before: dict, after: dict) -> dict:
+    """{'added': [...], 'removed': [...], 'changed': [...]}, each sorted."""
+    b, a = set(before), set(after)
+    return {
+        "added": sorted(a - b),
+        "removed": sorted(b - a),
+        "changed": sorted(p for p in (a & b) if before[p] != after[p]),
+    }
+
+
+def tree_changed(before: dict, after: dict) -> bool:
+    return any(manifest_diff(before, after).values())
+
+
+def describe(repo) -> str:
+    """One line a report can print so a reader knows which mode produced a figure."""
+    return ("git work tree: probes are authoritative" if git_available(repo)
+            else "NO GIT WORK TREE: git-derived checks are UNCHECKED, not clean")
+
+
+if __name__ == "__main__":
+    here = pathlib.Path(__file__).resolve().parents[1]
+    print(describe(here))
+    print("porcelain():", "None (unchecked)" if porcelain(here) is None
+          else repr(porcelain(here))[:200])
+    print("is_tracked(README.md):", is_tracked(here, "README.md"))
+    print("tree_manifest(): %d files" % len(tree_manifest(here)))

