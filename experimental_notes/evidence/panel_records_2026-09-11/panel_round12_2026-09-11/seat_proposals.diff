### cc2:bench/tests/test_a16_classifier_sees_across_modules_2026-09-11.py
--- /dev/null	2026-09-11 04:09:24
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__q156qdl/repo/bench/tests/test_a16_classifier_sees_across_modules_2026-09-11.py	2026-09-11 04:06:12
@@ -0,0 +1,152 @@
+"""A16's survey green-lit a script whose default invocation seals log directories.
+
+`scripts/measurement_scripts_only_2026-09-11.py` decides which scripts the survey
+may execute. Its docstring states the safety rule:
+
+    "Anything this cannot resolve is an ACTION: an unrecognised call, a dynamic
+     attribute, a `subprocess` invocation, an `os.system`."
+
+THE CODE DID NOT DO THAT. An unrecognised call was simply not a reason, so it fell
+through to MEASUREMENT. Probed with synthetic targets, a cross-module write helper,
+a bare `commit_everything()` and `io.open(p, "w")` were ALL classed MEASUREMENT.
+
+AND IT WAS REACHABLE. Of the 57 scripts then classed MEASUREMENT, 12 called into a
+local module the scanner could not see -- 21.0526%, Wilson [12.4745%, 33.2861%].
+Resolving them one level found `scripts/cdsfl_seal_logs.py`: classed MEASUREMENT
+with an EMPTY reason list, it constructs `VerificationChain`, whose body reaches
+`os.replace(tmp_path, path)` at `bench/verification_chain.py:621`. Its DEFAULT
+invocation seals every unsealed directory under logs/confer and logs/chat;
+`--dry-run` is the opt-in for writing nothing. Only argparse's `--help`
+short-circuit keeps the survey off it -- and "5 of 54 scripts consumed --help as a
+positional argument" is this same entry's other finding. Two independent things had
+to hold and one of them was never checked. This is the incident A16 exists for: a
+survey meant to READ running something that WRITES.
+
+THE REPAIR IS ONE FLIP, NOT A SWEEP. Exactly one script changes class. The first
+version of the resolver flipped four, and two of those were wrong: `str.replace`
+counted as a file write (`convergence_location.py:65` is
+`h.strip().lower().replace(" ", "_")`), and symbols were attributed to modules that
+do not define them. Unresolved symbols are now REPORTED rather than reclassified,
+because removing a working measurement from the survey needs evidence too.
+"""
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+import sys
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+SCRIPT = ROOT / "scripts" / "measurement_scripts_only_2026-09-11.py"
+
+
+@pytest.fixture(scope="module")
+def m():
+    spec = importlib.util.spec_from_file_location(SCRIPT.stem, SCRIPT)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class TestTheHoleThatWasOpen:
+    def test_the_seal_script_is_never_offered_to_the_survey(self, m):
+        """THE DEFECT, named at its real path."""
+        kind, reasons = m.classify(ROOT / "scripts" / "cdsfl_seal_logs.py")
+        assert kind == "ACTION", (
+            "cdsfl_seal_logs.py seals log directories through "
+            "VerificationChain -> os.replace and is being offered to a survey "
+            "whose whole purpose is to run only things that read")
+        assert any("verification_chain.py" in r for r in reasons), reasons
+
+    def test_a_write_reached_through_another_module_is_an_action(self, m, tmp_path):
+        helper = ROOT / "scripts" / "_a16_probe_helper.py"
+        caller = ROOT / "scripts" / "_a16_probe_caller.py"
+        helper.write_text("import pathlib\n\n\n"
+                          "def persist(p, d):\n"
+                          "    pathlib.Path(p).write_text(d)\n", encoding="utf-8")
+        caller.write_text("import _a16_probe_helper\n\n"
+                          "_a16_probe_helper.persist('x.json', 'data')\n",
+                          encoding="utf-8")
+        try:
+            kind, reasons = m.classify(caller)
+            assert kind == "ACTION", (
+                "a write one module away is still a write; this is the shape "
+                "that put cdsfl_seal_logs.py in the runnable set")
+            assert any("persist()" in r for r in reasons), reasons
+        finally:
+            helper.unlink(missing_ok=True)
+            caller.unlink(missing_ok=True)
+
+    def test_io_open_in_write_mode_is_an_action(self, m, tmp_path):
+        f = tmp_path / "s.py"
+        f.write_text("import io\nio.open('out.txt', 'w').write('x')\n",
+                     encoding="utf-8")
+        assert m.classify(f)[0] == "ACTION", (
+            "`open` was recognised and `io.open` was not, though they are the "
+            "same call")
+
+
+class TestTheRepairDidNotOverreach:
+    def test_a_string_replace_is_not_a_file_write(self, m):
+        """The false positive that flipped replay_accounting.py."""
+        helper = ROOT / "scripts" / "_a16_probe_strhelper.py"
+        caller = ROOT / "scripts" / "_a16_probe_strcaller.py"
+        helper.write_text("def normalise(s):\n"
+                          "    return s.strip().lower().replace(' ', '_')\n",
+                          encoding="utf-8")
+        caller.write_text("import _a16_probe_strhelper\n\n"
+                          "print(_a16_probe_strhelper.normalise('A B'))\n",
+                          encoding="utf-8")
+        try:
+            assert m.classify(caller)[0] == "MEASUREMENT", (
+                "`s.replace(' ', '_')` is a string method; counting it as a "
+                "file operation removes working measurements from the survey")
+        finally:
+            helper.unlink(missing_ok=True)
+            caller.unlink(missing_ok=True)
+
+    def test_os_replace_through_a_module_is_still_caught(self, m):
+        """The other side of the same discrimination."""
+        helper = ROOT / "scripts" / "_a16_probe_oshelper.py"
+        caller = ROOT / "scripts" / "_a16_probe_oscaller.py"
+        helper.write_text("import os\n\n\n"
+                          "def commit(tmp, dest):\n"
+                          "    os.replace(tmp, dest)\n", encoding="utf-8")
+        caller.write_text("import _a16_probe_oshelper\n\n"
+                          "_a16_probe_oshelper.commit('a', 'b')\n", encoding="utf-8")
+        try:
+            assert m.classify(caller)[0] == "ACTION"
+        finally:
+            helper.unlink(missing_ok=True)
+            caller.unlink(missing_ok=True)
+
+    def test_the_four_named_actions_are_unchanged(self, m):
+        for name in ("cdsfl_sv.py", "cdsfl_qc.py", "cdsfl_recover.py",
+                     "adjudicate_by_repair.py"):
+            assert m.classify(ROOT / "scripts" / name)[0] == "ACTION", name
+
+    def test_a_pure_reader_is_still_a_measurement(self, m, tmp_path):
+        f = tmp_path / "r.py"
+        f.write_text("import json, pathlib\n"
+                     "print(json.loads(pathlib.Path('x').read_text()))\n",
+                     encoding="utf-8")
+        assert m.classify(f)[0] == "MEASUREMENT"
+
+    def test_exactly_one_script_flips_on_cross_module_resolution(self, m):
+        """A sweep would be a removal in disguise; this pins the blast radius."""
+        flipped = []
+        for p in sorted((ROOT / "scripts").glob("*.py")):
+            kind, reasons = m.classify(p)
+            if kind == "ACTION" and reasons and all("reaches" in r for r in reasons):
+                flipped.append(p.name)
+        assert flipped == ["cdsfl_seal_logs.py"], flipped
+
+    def test_unresolved_symbols_are_reported_not_reclassified(self, m):
+        for p in sorted((ROOT / "scripts").glob("*.py")):
+            m.classify(p)
+        assert m.UNRESOLVED, (
+            "no symbol went unresolved at all -- either the resolver became "
+            "perfect or this diagnostic has gone blind")
+        assert all("does not define it" in u for u in m.UNRESOLVED)

### cc2:bench/tests/test_a7_anchor_does_not_identify_the_predicate_2026-09-11.py
--- /dev/null	2026-09-11 04:09:24
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__q156qdl/repo/bench/tests/test_a7_anchor_does_not_identify_the_predicate_2026-09-11.py	2026-09-11 03:59:49
@@ -0,0 +1,90 @@
+"""A7's total of 22 is a CHOICE of predicate, not a deduction from its anchor.
+
+A7 (`scripts/escalation_paths_2026-09-11.py`) reports 22 archived criticals
+escalated with no falsifier, under `severity >= 0.7 AND hil_escalated AND no
+falsifier_code`, and defends that predicate in its own docstring:
+
+    "which returns 22 -- and that predicate reproduces the entry's OTHER family
+    figure exactly, `exp55_v3_control` = 8, so it is almost certainly the one that
+    was meant."
+
+One scalar agreeing at one site is a one-bit test, and a one-bit test cannot
+select among nine readings. Measured by
+`scripts/a7_predicate_is_underdetermined_2026-09-11.py`: EIGHT of nine defensible
+readings of the same English sentence reproduce `exp55_v3_control = 8`, and among
+those eight the TOTAL takes three different values -- 20, 22 and 32. The anchor is
+satisfied by all three, so it distinguishes none of them.
+
+  20  the same predicate with severity STRICTLY greater than the threshold
+  22  A7's reading (and four others, which agree)
+  32  the same predicate with no severity threshold at all
+
+THIS DOES NOT SHOW 22 IS WRONG. It shows the stated reason for believing it is not
+a reason. 22 must travel as "22 under this predicate", with the predicate named.
+"""
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+import sys
+
+import pytest
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+PROBE = ROOT / "scripts" / "a7_predicate_is_underdetermined_2026-09-11.py"
+A7 = ROOT / "scripts" / "escalation_paths_2026-09-11.py"
+
+
+def _load(path: pathlib.Path):
+    spec = importlib.util.spec_from_file_location(path.stem, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+@pytest.fixture(scope="module")
+def sens():
+    return _load(PROBE).sensitivity()
+
+
+@pytest.fixture(scope="module")
+def anchored(sens):
+    return {n: v for n, v in sens.items() if v["exp55"] == 8}
+
+
+class TestTheAnchorIsNotDiscriminating:
+    def test_more_than_one_reading_reproduces_the_anchor(self, anchored):
+        assert len(anchored) >= 2, (
+            f"only {len(anchored)} reading(s) reproduce exp55_v3_control = 8, so "
+            f"the anchor might genuinely identify the predicate after all and "
+            f"A7's defence would stand")
+
+    def test_the_anchored_readings_disagree_on_the_total(self, anchored):
+        """THE CLAIM. If they all agreed, A7's inference would be sound."""
+        totals = sorted({v["total"] for v in anchored.values()})
+        assert len(totals) > 1, (
+            f"every reading that hits the anchor gives total {totals}; the anchor "
+            f"WOULD then pin the total and A7's reasoning would be valid")
+        assert totals == [20, 22, 32], totals
+
+    def test_a7s_own_predicate_is_one_of_the_anchored_readings(self, anchored):
+        base = [v for n, v in anchored.items() if n.startswith("A7 baseline")]
+        assert base and base[0] == {"total": 22, "exp55": 8, "runs": 7}, base
+
+
+class TestTheProbeMeasuresTheSameArchiveA7Does:
+    """Otherwise the disagreement above could be an artefact of reading elsewhere."""
+
+    def test_the_baseline_reproduces_a7s_published_total(self, anchored):
+        a7 = _load(A7)
+        rows = a7.escalated_without_a_falsifier(a7.critical_threshold())
+        assert len(rows) == 22
+        base = [v for n, v in anchored.items() if n.startswith("A7 baseline")][0]
+        assert base["total"] == len(rows), (
+            "the probe and A7 disagree on A7's OWN predicate, so the probe is "
+            "reading a different population and proves nothing about A7")
+
+    def test_the_threshold_is_read_from_the_runner_not_typed(self):
+        probe = _load(PROBE)
+        assert probe.critical_threshold() == _load(A7).critical_threshold()

### cc2:bench/tests/test_archive_predicate_and_vacuous_guards_2026-09-11.py
--- /dev/null	2026-09-11 04:09:24
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel__q156qdl/repo/bench/tests/test_archive_predicate_and_vacuous_guards_2026-09-11.py	2026-09-11 03:59:10
@@ -0,0 +1,212 @@
+"""The archive predicate failed OPEN on an absolute path, and two guards were vacuous.
+
+THREE REPAIRS, ONE FAILURE SHAPE: a check that returns the permissive answer when
+it cannot answer at all.
+
+  F3  `bench/repo_paths.py::is_archived_run_output` matches repo-relative roots
+      (`bench/logs`), so an ABSOLUTE path never matched one and came back False --
+      "not archived", the permissive answer, from the predicate whose whole job is
+      to protect archives. It has already cost this repository one dead branch:
+      `test_derived_docs_match_their_generators_2026-09-01.py:60` records a skip
+      that "never fired and was unreachable" for exactly this reason, "caught
+      2026-09-10 by running it in the clone rather than reading it". That caller
+      hand-rebased its own path and the shared predicate was left unguarded, so
+      the next caller repeated the mistake -- `Path.rglob` yields absolute paths
+      and handing one over is the natural idiom.
+
+  F4  `test_config_aliases_survive_both_paths.py:119` was a 7th instance of the
+      bare-substring shape task 6.4 closed at 6 sites. Measured: the substring
+      admitted 703 archived files the shared predicate excludes, 690 under
+      `bench/results/` and 13 under `bench/logs_quarantine/` -- the exact two roots
+      6.4 names a bare substring as missing. Latent, not biting; wired because a
+      latent divergence from the single source of truth is what 6.4 removed.
+
+  F5  Two git reads whose empty stdout is indistinguishable from success:
+      `test_derived_docs...:165` (a coverage ratchet that reported FULL coverage
+      while examining zero documents) and `test_task_list_entry_count...:136`
+      (expected value 0, which empty input also produces).
+
+EVERY TEST BELOW WAS RUN RED AGAINST THE PRE-FIX BODY IT REPLACES.
+"""
+from __future__ import annotations
+
+import importlib.util
+import json
+import pathlib
+import sys
+
+import pytest
+
+try:                                        # pytest's skip signal, by any name
+    from _pytest.outcomes import Skipped
+except ImportError:                         # pragma: no cover
+    Skipped = pytest.skip.Exception
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+for _p in (str(ROOT), str(ROOT / "scripts")):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+import git_probe  # noqa: E402
+from bench.repo_paths import (  # noqa: E402
+    ARCHIVE_ROOTS,
+    is_archived_run_output,
+    is_production_source,
+    line_mentions_archive_path,
+)
+
+
+def _load(path: pathlib.Path):
+    spec = importlib.util.spec_from_file_location(path.stem, path)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
+
+
+class TestThePredicateNoLongerFailsOpenOnAbsolutePaths:
+    @pytest.mark.parametrize("root", list(ARCHIVE_ROOTS))
+    def test_an_absolute_path_inside_an_archive_root_is_archive(self, root):
+        """THE DEFECT. Pre-fix every one of these returned False."""
+        absolute = ROOT / root / "some_run" / "report.json"
+        assert is_archived_run_output(absolute) is True, (
+            f"{absolute} lies inside declared archive root {root!r} and was "
+            f"classified as production source")
+
+    @pytest.mark.parametrize("root", list(ARCHIVE_ROOTS))
+    def test_the_archive_root_itself_is_archive_in_absolute_form(self, root):
+        assert is_archived_run_output(ROOT / root) is True
+
+    def test_an_absolute_path_inside_the_repo_but_not_archive_is_production(self):
+        assert is_archived_run_output(ROOT / "bench" / "reference_runner_v3.py") is False
+        assert is_production_source(ROOT / "bench" / "reference_runner_v3.py") is True
+
+    def test_an_absolute_path_outside_the_repo_does_not_raise_and_is_not_archive(self):
+        """REBASE, NOT RAISE. `line_mentions_archive_path` scrapes real absolute
+        paths out of source lines and hands them here; raising would break it."""
+        for outside in ("/usr/lib/python3/os.py", "/etc/hosts",
+                        "/var/tmp/bench/logs/x.json"):
+            assert is_archived_run_output(outside) is False
+
+    def test_relative_classification_is_byte_identical_to_before(self):
+        """The fix must add a capability, not move an existing answer."""
+        cases = {
+            "bench/logs": True, "bench/logs/run/x.json": True,
+            "bench/logs_quarantine": True, "bench/logs_quarantine/x": True,
+            "bench/results": True, "bench/results/a/b.json": True,
+            "bench/logsomething/x": False, "bench/reference_runner_v3.py": False,
+            "scripts/git_probe.py": False, "bench/tests/test_x.py": False,
+        }
+        for path, expected in cases.items():
+            assert is_archived_run_output(path) is expected, path
+
+    def test_the_quarantine_root_is_still_never_matched_by_prefix_accident(self):
+        """6.4's load-bearing property, re-checked through the new code path."""
+        assert is_archived_run_output("bench/logs_quarantine/x",
+                                      roots=("bench/logs",)) is False
+        assert is_archived_run_output(ROOT / "bench/logs_quarantine/x",
+                                      roots=("bench/logs",)) is False
+
+    def test_line_scanning_still_works_and_still_ignores_foreign_absolutes(self):
+        assert line_mentions_archive_path('p = "bench/logs/run/x.json"') is True
+        assert line_mentions_archive_path('p = "/usr/lib/python3/os.py"') is False
+        assert line_mentions_archive_path('p = "bench/reference_runner_v3.py"') is False
+
+
+class TestTheSeventhBareSubstringSiteIsWiredAndTheWiringDoesSomething:
+    """An addition nothing reaches is not additive. This measures the difference."""
+
+    def _admitted(self):
+        bare, pred = set(), set()
+        for p in (ROOT / "bench").rglob("*.json"):
+            rel = p.relative_to(ROOT)
+            if "/logs/" not in str(p):
+                bare.add(rel)
+            if not is_archived_run_output(rel):
+                pred.add(rel)
+        return bare, pred
+
+    def test_the_predicate_excludes_archives_the_substring_admitted(self):
+        bare, pred = self._admitted()
+        only_bare = bare - pred
+        assert only_bare, (
+            "the rewire changed nothing: if the bare substring and the shared "
+            "predicate admit the same set, this fix is an addition that does "
+            "nothing and should be reverted rather than kept")
+        roots = {str(p).split("/")[1] for p in only_bare}
+        assert roots <= {"results", "logs_quarantine"}, roots
+        assert len(only_bare) > 100, len(only_bare)
+
+    def test_the_live_guard_actually_CALLS_the_shared_predicate(self):
+        """A WIRING TEST, AND THE FIRST VERSION OF IT WAS VACUOUS.
+
+        The measurement above re-derives both sets itself, so it passes whether or
+        not the site is wired -- reverting the site to `"/logs/" in str(p)` left it
+        GREEN. Caught by mutating the site and re-running, which is the only reason
+        this second test exists. Here the predicate is replaced in the guard's own
+        namespace with a recorder and the guard is RUN, so a site that does not
+        consult it records nothing and fails.
+        """
+        import os
+
+        mod = _load(ROOT / "bench" / "tests"
+                    / "test_config_aliases_survive_both_paths.py")
+        assert mod.ALIASES, "no aliases discovered; the guard would be vacuous"
+        calls = []
+        real = mod.is_archived_run_output
+
+        def recording(path, *a, **k):
+            calls.append(path)
+            return real(path, *a, **k)
+
+        mod.is_archived_run_output = recording
+        try:
+            mod.test_shipped_configs_using_a_legacy_name_are_still_honoured()
+        finally:
+            mod.is_archived_run_output = real
+
+        assert calls, (
+            "the shipped-config guard never consulted bench/repo_paths; it is "
+            "deciding for itself what counts as an archive, which is the "
+            "divergence task 6.4 removed")
+        absolute = [c for c in calls if os.path.isabs(str(c))]
+        assert not absolute, (
+            f"{len(absolute)} path(s) handed to the predicate in ABSOLUTE form, "
+            f"e.g. {absolute[0]!r}")
+        assert any(real(c) for c in calls), (
+            "the predicate was called but excluded nothing, so the wiring is "
+            "inert -- an addition that does nothing is not additive")
+
+
+class TestTheTwoVacuousGuardsCanNoLongerReportSuccessWithoutLooking:
+    def test_the_coverage_ratchet_skips_rather_than_claiming_full_coverage(self):
+        """Pre-fix this returned `{}` when git failed and `assert not stray` held."""
+        mod = _load(ROOT / "bench" / "tests"
+                    / "test_derived_docs_match_their_generators_2026-09-01.py")
+        cls = [getattr(mod, n) for n in dir(mod)
+               if n.startswith("Test") and hasattr(
+                   getattr(mod, n), "_docs_promising_reproduction")]
+        assert cls, "the ratchet's holder class was renamed; this test has gone blind"
+        holder = cls[0]()
+        if git_probe.git_available(ROOT):
+            assert isinstance(holder._docs_promising_reproduction(), dict)
+        else:
+            with pytest.raises(Skipped):
