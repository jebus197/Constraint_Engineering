+    ov = _load("ov_fix3", "scripts/overstated_entries_2026-09-11.py")
+    lst = tmp_path / "LIST.md"
+    lst.write_text(
+        "**2.1 Something. DONE 2026-09-09.**\n"
+        "<!-- task: 2.1 | state: DONE | status: COMMITTED | evidence: z.py -->\n"
+        "But the follow-up says this **NOT DONE** after all.\n")
+    monkeypatch.setattr(ov, "LIST", lst)
