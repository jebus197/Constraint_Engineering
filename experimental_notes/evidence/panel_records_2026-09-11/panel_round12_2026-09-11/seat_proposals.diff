+    # THE NARROWING THAT MATTERS, because the wide figure is not a defect count.
+    # A `git config user.email x` that SETS a value has no stdout to misread; the
+    # dangerous shape is a git READ inside a TEST whose empty stdout makes the
+    # assertion below it examine nothing. Those, and only those, are hand-read.
+    READ_SUBCOMMANDS = ("status", "ls-files", "log", "show", "diff", "grep",
+                        "rev-list", "describe")
+    danger = [r for r in bad
+              if r[0].startswith("bench/tests/") and r[2] in READ_SUBCOMMANDS]
+    print(f"\nNARROWED -- a git READ in a TEST, unguarded: {len(danger)}")
+    for f, line, sub, _v, _w in danger:
+        print(f"  {f}:{line}  git {sub}")
+    if danger:
+        from statsmodels.stats.proportion import proportion_confint
+        in_tests = [r for r in amb if r[0].startswith("bench/tests/")
+                    and r[2] in READ_SUBCOMMANDS]
+        k2, n2 = len(danger), len(in_tests)
+        lo2, hi2 = proportion_confint(k2, n2, method="wilson")
+        lo2c, hi2c = proportion_confint(k2, n2, method="beta")
+        print(f"  unguarded git READS in tests: {k2}/{n2} = {k2 / n2:.4%}")
+        print(f"    Wilson 95%          : [{lo2:.4%}, {hi2:.4%}]")
+        print(f"    Clopper-Pearson 95% : [{lo2c:.4%}, {hi2c:.4%}]")
+
+    print("\nTHE CLASSIFIER OVER-REPORTS BY CONSTRUCTION: a returncode checked one "
+          "frame up\nreads as UNGUARDED here. The list above is short enough to read, "
+          "and is read.\nA figure from this script is a CANDIDATE list, not a defect "
+          "count.")
+    return 0
