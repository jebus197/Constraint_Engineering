+    print(f"  [{'OK ' if ok else 'BAD'}] {name}")
+    if not ok: fail.append(name)
+
+R, q, s, nu = sp.symbols('R q sigma nu', positive=True)
+R_det = R*(1-q)/(1-q*R)
+mixture = sp.simplify((1-q*R)*R_det + q*R*(1-s))
+appendix = s*R_det + (1-s)*R
