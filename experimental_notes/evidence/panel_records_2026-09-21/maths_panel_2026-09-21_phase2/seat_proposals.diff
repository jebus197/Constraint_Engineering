+claim("free-decrease term is q*R(1-R)/(1-qR)",
+      sp.simplify((R - R_det) - q*R*(1-R)/(1-q*R)) == 0)
+claim("appendix excess is sigma*q*R^2(1-q)/(1-qR)",
