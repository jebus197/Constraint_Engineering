+def refusal_causes() -> tuple[Counter, int, int]:
+    """Walk REJECTED records only: (cause counter, sk==0 count, total).
+
+    CORRECTION, blind panel round 2026-09-20. The first conclusion this script
+    printed said the 191 refusals were made 'on the strength of a constant
+    nobody measured'. That inference was wrong, and this function is the
+    measurement that refutes it: every REJECTED record carries sk == 0.0 and a
+    STRUCTURAL cause in its own gate_details (apply/parse failure or a hard
+    gate), recorded before any of q, R_old, nu_b, nu_f could be read.
+    `compute_sk` (bench/reference_runner_v3.py) reads none of those constants;
+    they parameterise the R_k update, not the admission verdict.
+    """
+    causes: Counter = Counter()
+    zero_sk = 0
+    total = 0
+
+    def walk(o):
+        nonlocal zero_sk, total
+        if isinstance(o, dict):
+            sk = o.get("sk_result")
+            if (isinstance(sk, dict) and "tristate" in sk
+                    and str(sk.get("tristate")) == "REJECTED"):
+                total += 1
+                if float(sk.get("sk", 1)) == 0.0:
+                    zero_sk += 1
+                gd = sk.get("gate_details") or {}
+                if "error" in gd:
+                    causes[f"apply/parse: {gd['error']}"] += 1
+                elif (gd.get("g1_ast") or {}).get("score") == 0:
+                    causes["hard gate: g1_ast"] += 1
+                elif (gd.get("g2_compile") or {}).get("score") == 0:
+                    causes["hard gate: g2_compile"] += 1
+                else:
+                    causes["other"] += 1
+            for v in o.values():
+                walk(v)
+        elif isinstance(o, list):
+            for v in o:
+                walk(v)
+
+    for f in sorted(glob.glob(str(ROOT / "bench/logs/*/runner_state.json"))):
+        if os.path.getsize(f) > MAX_BYTES:
+            continue
+        try:
+            raw = open(f, errors="ignore").read()
+        except OSError:
+            continue
+        if "sk_result" not in raw:
+            continue
+        try:
+            walk(json.loads(raw))
+        except Exception:
+            continue
+    return causes, zero_sk, total
+
