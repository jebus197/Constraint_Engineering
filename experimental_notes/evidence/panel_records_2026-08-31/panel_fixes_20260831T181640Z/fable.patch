"""The SS2 rewrite follows the falsifier gate, not the tools flag.

THE COUPLING (measured 2026-08-31): the founder's 2026-08-30 ruling hardwired
enable_tools=True at both round-loop call sites -- correctly, TOOLS DECIDE --
but the SS2 prose->runnable rewrite rode the SAME parameter, so a gate-off
ablation arm started receiving the runnable-falsifier SS2 mid-arc. The comment
at the rewrite site still said "Gate-off => unchanged" while the code no longer
implemented it. The ruling covered tool use, not the rewrite.

These tests exercise the REAL _dispatch_single_model with dispatch stubbed at
the seam, and diff the system prompt that actually leaves.
"""
import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
import reference_runner_v2 as R

# A directive carrying the legacy SS2 prose block the rewrite targets.
PROSE_S2 = ("FALSIFICATION: This section is mandatory. It must contain: "
            "the specific condition that would disprove your claim. "
            "Did you test it?")
DIRECTIVE = f"PREAMBLE.\n{PROSE_S2}\nPOSTAMBLE."


def _dispatch_and_capture(monkeypatch, tmp_path, gate_on):
    captured = {}

    def _stub_dispatch(mc, prompt, cdsfl, wall_clock_limit=0, enable_tools=False):
        captured["system"] = cdsfl
        captured["enable_tools"] = enable_tools
        return "no findings", 0.1

    monkeypatch.setattr(R, "dispatch_to_model", _stub_dispatch)
    monkeypatch.setattr(R, "_compose_for_model",
                        lambda *a, **k: (_ for _ in ()).throw(RuntimeError("no composer")))
    monkeypatch.setattr(R, "should_decompose_v2", lambda *a, **k: False)
    mc = R.ModelConfig(label="CC2-SIM", model_id="sim", api="sim",
                       role="player", system_prompt_path=None,
                       timeout=5, max_retries=1)
    R._dispatch_single_model(
        mc, None, "the round prompt", DIRECTIVE, "code", 0,
        "four_layer", "software", tmp_path,
        True,                      # enable_tools: ALWAYS on (ruling 2026-08-30)
        falsifier_gate_on=gate_on,  # the arm's own variable, decoupled
    )
    return captured


def test_gate_on_rewrites_s2_and_keeps_tools(monkeypatch, tmp_path):
    got = _dispatch_and_capture(monkeypatch, tmp_path, gate_on=True)
    assert "RUNNABLE falsifier, NOT prose" in got["system"]
    assert "Did you test it?" not in got["system"]
    assert got["enable_tools"] is True


def test_gate_off_keeps_the_prose_s2_and_STILL_keeps_tools(monkeypatch, tmp_path):
    """The ablation arm's prompt is unchanged; the tools ruling still holds."""
    got = _dispatch_and_capture(monkeypatch, tmp_path, gate_on=False)
    assert PROSE_S2 in got["system"], "gate-off arm received a rewritten SS2"
    assert "RUNNABLE falsifier, NOT prose" not in got["system"]
    assert got["enable_tools"] is True, (
        "decoupling the rewrite must not undo the tools ruling")


def test_both_call_sites_forward_the_gate_flag():
    src = (pathlib.Path(__file__).resolve().parents[1]
           / "reference_runner_v2.py").read_text(encoding="utf-8")
    assert src.count(
        "falsifier_gate_on=cfg.falsifier_gate_enabled,\n            )] = mc.label") == 2, (
        "a round-loop call site stopped forwarding the gate flag; the rewrite "
        "is riding enable_tools again")


def test_an_unmigrated_caller_gets_yesterdays_coupling_not_a_crash():
    """None => follow enable_tools: the pre-split behaviour, chosen so an
    unupdated caller degrades to the known coupling rather than silently
    changing arms."""
    sig = R._dispatch_single_model.__defaults__
    assert sig == (True, None)

