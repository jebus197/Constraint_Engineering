+def redirect_shadow_log(dir_path: str) -> str:
+    """Point the immune pipeline's shadow log at ``dir_path`` from now on.
+
+    WHY THIS EXISTS (2026-08-31). The pytest diversion above solved the 2026-07-31
+    contamination for TEST runs only. A SIMULATED experiment is neither pytest nor
+    a real panel, so the v3.1/v3.2 simulated runs appended 174 ``-SIM`` lines
+    (measured: log lines 51887-52162, 2026-08-30T17:21:29 to 2026-08-31T02:02:37)
+    to the ARCHIVAL bench/logs/immune_pipeline.log, interleaving simulated and
+    real records in the one file the archive keeps them apart to protect.
+
+    A simulated harness calls this with its own run directory right after
+    creating it. The archival default is untouched for real experiments; the
+    env override and the pytest diversion behave exactly as before. Idempotent;
+    returns the path now being written.
+    """
+    import os as _os2
+    _os2.makedirs(dir_path, exist_ok=True)
+    target = _os2.path.join(dir_path, "immune_pipeline.log")
+    for h in list(_shadow_log.handlers):
+        if isinstance(h, _logging.FileHandler):
+            if _os2.path.abspath(getattr(h, "baseFilename", "")) == _os2.path.abspath(target):
+                return target  # already there
+            _shadow_log.removeHandler(h)
+            try:
+                h.close()
+            except Exception:  # noqa: BLE001 -- a close failure must not lose the redirect
+                pass
+    fh = _logging.FileHandler(target, encoding="utf-8")
+    fh.setLevel(_logging.INFO)
+    fh.setFormatter(_logging.Formatter(
+        "%(asctime)s %(levelname)s %(message)s", datefmt="%Y-%m-%dT%H:%M:%S"))
+    _shadow_log.addHandler(fh)
+    # Children spawned by this run (decomposed dispatch etc.) import their own
+    # copy of this module; the env override above is how THEY find the same file.
+    _os2.environ["CDSFL_SHADOW_LOG_DIR"] = dir_path
+    return target
+
+
