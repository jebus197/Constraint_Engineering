"""Every live `claude -p` spawn carries `--setting-sources ""`.

MEASURED 2026-08-31, by execution: the same haiku probe, same --system-prompt,
same --allowedTools --
  with the flag:    sentinel intact, "NO" inherited config, Bash tool ran.
  without the flag: the model quoted the operator's personal CLAUDE.md path,
                    the working-hours directive, and the operational tracker.

The 2026-08-31 fix covered call_claude_cli and the sim shim; this guard exists
because the sweep then found FIVE MORE live spawn sites without it (cc2_manager,
4x immune_agents, sim_panel_agents) -- an incomplete fix that read as complete.
Legacy harnesses (run_benchmark, run_round_robin, interactive_smoke,
smoke_test_*) are out of scope: they do not run in the current pipeline.
"""
import pathlib
import re

REPO = pathlib.Path(__file__).resolve().parents[2]

LIVE = [
    "bench/experiment_11_orchestrator.py",
    "bench/cc2_manager.py",
    "bench/immune_agents.py",
    "bench/tools/sim_dispatch_shim.py",
    "bench/tools/sim_panel_agents.py",
]

_SPAWN = re.compile(r'"-p"')


def test_every_live_spawn_site_isolates_settings():
    unguarded = []
    for rel in LIVE:
        src = (REPO / rel).read_text(encoding="utf-8")
        for m in _SPAWN.finditer(src):
            # 8000: call_claude_cli carries ~4.5 KB of load-bearing history
            # comments between "-p" and the flag; the window must clear it.
            window = src[m.start():m.start() + 8000]
            if '"--setting-sources", "",' not in window.replace("'", '"'):
                line = src[:m.start()].count("\n") + 1
                unguarded.append(f"{rel}:{line}")
    assert unguarded == [], (
        f"claude -p spawn(s) without --setting-sources: {unguarded}. Each one "
        f"briefs a model with the operator's private instructions.")


def test_the_flag_never_uses_bare():
    """--bare selects API-key auth this account does not have (2026-07-29:
    'Not logged in' on every headless dispatch). The isolation flag must stay
    --setting-sources, which keeps OAuth intact."""
    for rel in LIVE:
        src = (REPO / rel).read_text(encoding="utf-8")
        for m in re.finditer(r'"--bare"', src):
            line_start = src.rfind("\n", 0, m.start()) + 1
            line = src[line_start:src.index("\n", m.start())]
            assert line.lstrip().startswith("#"), (
                f"{rel} passes --bare on a live spawn; that breaks OAuth auth")

=== NEW FILE: bench/tests/test_post_sweep_bookkeeping_2026-08-31.py ===
"""The sweep's aftermath is bookkept: stale fix-efficacy records re-probed to
completion, and sweep-cleared CONFIRMED+verified findings settled.

MEASURED ON THE v3.2 RUN (2026-08-31): 11 of 15 NOT_PROBED_NO_FALSIFIER
records had a falsifier -- the identical 11 the sweep cleared -- and the same
11 stood CONFIRMED+verified because _settle_confirmed_findings runs before the
sweep and never after. Replayed with the drain: 11 of 11 probed (4 capped
passes; outcomes 9 FIX_CURES_ITS_OWN_FALSIFIER, 2 INDETERMINATE_OTHER), 10 of
11 re-settled to CLOSED, and the 11th (C0002) HELD OPEN by the settle's own
unresolved-challenge guard -- which is that guard working, not failing.
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1]))
import reference_runner_v2 as R


class _Cfg:
    test_article = "bench/dm/_memory.py"


def _entry(**kw):
    e = {"status": "CONFIRMED", "verified": True, "verdicts": [],
         "open_since_round": 0, "last_status_change_round": 0,
         "severity": 0.8, "proposed_fix": "fix",
         "falsifier_code": "assert False, 'FALSIFIED'",
         "fix_efficacy": {"outcome": "NOT_PROBED_NO_FALSIFIER"}}
    e.update(kw)
    return e


def _drain(reg, monkeypatch, outcome="FIX_CURES_ITS_OWN_FALSIFIER"):
    import fix_efficacy as FE

    class _R:
        def __init__(self):
            self.outcome, self.detail = outcome, "stubbed"
    monkeypatch.setattr(FE, "probe", lambda *a, **k: _R())
    return R._post_sweep_fix_efficacy_drain(reg, _Cfg())


def test_the_drain_probes_past_the_per_round_cap(monkeypatch):
    """11 stale entries, cap 5: one pass would probe 5; the drain probes 11,
    respecting the cap per pass rather than deleting it."""
    reg = R.FindingRegistry()
    for i in range(11):
        reg.entries[f"C{i:04d}"] = _entry()
    stats = _drain(reg, monkeypatch)
    assert stats["stale"] == 11 and stats["probed"] == 11
    assert stats["passes"] >= 3, "the cap was bypassed, not iterated"
    assert all(e["fix_efficacy"]["outcome"] != "NOT_PROBED_NO_FALSIFIER"
               for e in reg.entries.values())
    assert all(e["fix_efficacy"].get("probed_post_sweep")
               for e in reg.entries.values())


def test_a_record_with_no_falsifier_stays_honestly_unprobed(monkeypatch):
    reg = R.FindingRegistry()
    reg.entries["C0001"] = _entry(falsifier_code="")
    stats = _drain(reg, monkeypatch)
    assert stats == {"stale": 0, "probed": 0, "passes": 0, "outcomes": {}}
    assert reg.entries["C0001"]["fix_efficacy"]["outcome"] == \
        "NOT_PROBED_NO_FALSIFIER"


def test_an_already_probed_record_is_not_reprobed(monkeypatch):
    reg = R.FindingRegistry()
    reg.entries["C0001"] = _entry(
        fix_efficacy={"outcome": "FIX_CURES_ITS_OWN_FALSIFIER"})
    stats = _drain(reg, monkeypatch)
    assert stats["stale"] == 0 and stats["probed"] == 0


def test_the_sweep_attachment_clears_the_stale_stamps():
    """The C0015 class: a fresh runner-verified falsifier from the sweep must
    clear mechanical_fault and the HIL/irreducible stamps, exactly as the
    routing success site does (founder ruling 2026-08-31)."""
    src = (pathlib.Path(__file__).resolve().parents[1]
           / "reference_runner_v2.py").read_text(encoding="utf-8")
    at = src.index('e["resolved_by_sweep"]')
    block = src[at:at + 1400]
    for cleared in ('e["irreducible_escalation"] = False',
                    'e["hil_escalated"] = False',
                    'e.pop("hil_reason", None)',
                    'e["mechanical_fault"] = False'):
        assert cleared in block, f"sweep attachment no longer clears: {cleared}"


def test_bookkeeping_runs_after_the_sweep_in_the_run_loop():
    src = (pathlib.Path(__file__).resolve().parents[1]
           / "reference_runner_v2.py").read_text(encoding="utf-8")
    sweep_at = src.index('result["post_convergence_sweep"] = _post_convergence_sweep(')
    drain_at = src.index("_fe_drain = _post_sweep_fix_efficacy_drain(")
    settle_calls = [i for i in range(len(src))
                    if src.startswith("_settle_confirmed_findings(registry, round_idx)", i)]
    assert drain_at > sweep_at, "the drain no longer follows the sweep"
    assert any(i > sweep_at for i in settle_calls), (
        "no settle pass follows the sweep; sweep-cleared findings will stand "
        "CONFIRMED+verified again")


def test_executed_a_sweep_clear_really_clears_the_stale_stamps(monkeypatch, tmp_path):
    """Not a source scan: run the real _post_convergence_sweep with dispatch
