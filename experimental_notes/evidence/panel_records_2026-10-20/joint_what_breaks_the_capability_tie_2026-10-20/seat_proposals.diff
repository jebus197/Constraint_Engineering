+    # the rotation irreproducible across runs; a replay needs a stable digest to
+    # recover the ladder that was in force.
+    shift = int(_hashlib.sha256(str(seed).encode("utf-8")).hexdigest()[:8], 16)
+    shift %= len(items)
+    return tuple(items[shift:] + items[:shift])
 
