### bench/tests/test_exhausted_valve_reaches_a4_2026-09-09.py
--- /dev/null	2026-09-09 21:26:16
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_k8zypybl/repo/bench/tests/test_exhausted_valve_reaches_a4_2026-09-09.py	2026-09-09 21:23:22
@@ -0,0 +1,146 @@
+"""The A4 `exhausted` release valve must be REACHABLE, not merely present.
+
+Found by fable, panel review round 2, 2026-09-09; confirmed by execution before
+the fix was applied.
+
+`FindingRegistry.unverified_critical_count()` examines ONLY entries with
+status == "UNCONFIRMED", and skips those carrying `exhausted`. The flag is
+written by `_update_finding_statuses` pre-pass 1, whose status tuple did not
+include "UNCONFIRMED" -- so its `else: e.pop("exhausted", None)` stripped the
+flag from every entry the counter can ever see. The valve added on 2026-09-07
+was dead from the day it landed.
+
+WHY IT MATTERS NOW. Round 1's empty-ladder repair makes `routing_deferred` the
+terminal state of every escalated critical in the 1-seat arm (the ladder excludes
+the finding's own source model, so it is empty by construction every round).
+`routing_deferred` is NOT excluded from `unverified_critical_count`, by design --
+the valve was the thing that bounded it. With 1 or 2 such criticals the queue is
+below `max_irreducible_queue`, so HALTED_IRREDUCIBLE_QUEUE_ALARM does not fire
+and the A4 gate blocks the gamma-alt path for the life of the run: the arm burns
+its full round budget and exits BUDGET_EXHAUSTED, which is neither of its two
+pre-registered outcomes.
+
+THE OLD TEST WAS A SOURCE GREP. test_panel_five_fixes_2026-09-07.py:78 asserts
+`'e.get("exhausted")' in body` -- that the LINE EXISTS. It passes against dead
+code. These tests execute it.
+"""
+
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(REPO))
+
+from bench.reference_runner_v3 import (  # noqa: E402
+    FindingRegistry, RunnerConfig, _update_finding_statuses,
+)
+
+
+def _aged_deferred_critical(reg, cid="C0", status="UNCONFIRMED"):
+    reg.entries[cid] = {
+        "canonical_id": cid, "status": status, "severity": 0.9,
+        "description": "an aged, routing-deferred critical",
+        "falsifier_code": "", "falsifier_verdict": "",
+        "source_model": "CC2", "source_aliases": [cid],
+        "verdicts": [{"model": "CC2", "verdict": "CONFIRM", "round": 0}],
+        "open_since_round": 0, "last_status_change_round": 0,
+        "routing_deferred": True,
+    }
+    return reg
+
+
+def test_the_flag_survives_a_round_tick_on_an_unconfirmed_entry():
+    """The defect, executed: one ordinary round tick used to strip the flag."""
+    cfg = RunnerConfig(test_article="x.py", exhausted_round_threshold=2)
+    reg = _aged_deferred_critical(FindingRegistry())
+    reg.entries["C0"]["exhausted"] = True
+    _update_finding_statuses(reg, 7, cfg=cfg)
+    assert reg.entries["C0"].get("exhausted") is True, (
+        "pre-pass 1 popped `exhausted` from an UNCONFIRMED entry -- the only "
+        "status unverified_critical_count reads -- so the valve is unreachable")
+
+
+def test_the_runner_itself_sets_the_flag_and_a4_releases():
+    """End to end: the runner derives the flag and the A4 blocker drops to 0."""
+    cfg = RunnerConfig(test_article="x.py", exhausted_round_threshold=2)
+    reg = _aged_deferred_critical(FindingRegistry())
+    _update_finding_statuses(reg, 1, cfg=cfg)          # age 1 < 2
+    assert reg.entries["C0"].get("exhausted") is False
+    assert reg.unverified_critical_count() == 1, "must still block while young"
+    _update_finding_statuses(reg, 5, cfg=cfg)          # age 5 >= 2
+    assert reg.entries["C0"].get("exhausted") is True, (
+        "the age rule was never evaluated for an UNCONFIRMED entry")
+    assert reg.unverified_critical_count() == 0, (
+        "the valve is present but does not release the A4 blocker")
+
+
+def test_the_valve_does_not_release_early():
+    """It is a release valve, not a bypass: below threshold it must still block."""
+    cfg = RunnerConfig(test_article="x.py", exhausted_round_threshold=6)
+    reg = _aged_deferred_critical(FindingRegistry())
+    for r in range(0, 6):
+        _update_finding_statuses(reg, r, cfg=cfg)
+        assert reg.unverified_critical_count() == 1, (
+            f"released at round {r}, threshold is 6")
+
+
+def test_it_requires_review_activity():
+    """`has_reviews` still gates: an unreviewed critical is not 'exhausted'."""
+    cfg = RunnerConfig(test_article="x.py", exhausted_round_threshold=2)
+    reg = _aged_deferred_critical(FindingRegistry())
+    reg.entries["C0"]["verdicts"] = []
+    _update_finding_statuses(reg, 9, cfg=cfg)
+    assert reg.entries["C0"].get("exhausted") is False
+    assert reg.unverified_critical_count() == 1
+
+
+def test_exp56_cannot_reach_the_valve_with_its_own_numbers():
+    """SECOND, INDEPENDENT KILL, pinned so it cannot be forgotten.
+
+    Every exp56 arm carries max_rounds=8 and leaves exhausted_round_threshold at
+    its default of 8. Rounds run 0..7, so the maximum reachable age is 7 and
+    `age >= 8` is unsatisfiable. The code fix above is necessary but NOT
+    sufficient for exp56: the arms must also set a threshold below max_rounds.
+    """
+    import json
+    cfg_dir = REPO / "bench" / "exp56_configs"
+    default_threshold = RunnerConfig(test_article="x.py").exhausted_round_threshold
+    for f in sorted(cfg_dir.glob("*.json")):
+        d = json.loads(f.read_text(encoding="utf-8"))
+        thr = d.get("exhausted_round_threshold", default_threshold)
+        max_rounds = d["max_rounds"]
+        assert thr < max_rounds, (
+            f"{f.name}: exhausted_round_threshold={thr} >= max_rounds="
+            f"{max_rounds}; the maximum reachable age is {max_rounds - 1}, so "
+            f"the A4 release valve can never fire in this arm and a "
+            f"routing-deferred critical blocks convergence for the whole run")
+
+
+# --- Boundary, added because a mutation proved it untested. -----------------
+# Mutating `>= CRITICAL_SEVERITY_THRESHOLD` to `>` inside
+# irreducible_queue_count left 45 tests GREEN on 2026-09-09. A severity of
+# exactly 0.7 is a value a model plausibly emits, and under the mutant it drops
+# out of the queue the halt alarm reads.
+
+def test_the_queue_counts_a_finding_sitting_exactly_on_the_threshold():
+    from bench.reference_runner_v3 import CRITICAL_SEVERITY_THRESHOLD
+    reg = FindingRegistry()
+    reg.entries["C0"] = {
+        "canonical_id": "C0", "status": "OPEN",
+        "severity": CRITICAL_SEVERITY_THRESHOLD, "description": "on the line",
+        "routing_deferred": True,
+    }
+    assert reg.irreducible_queue_count() == 1, (
+        "a finding at exactly CRITICAL_SEVERITY_THRESHOLD must count toward the "
+        "irreducible queue; the gate is >=, not >")
+
+
+def test_the_queue_excludes_one_epsilon_below_the_threshold():
+    from bench.reference_runner_v3 import CRITICAL_SEVERITY_THRESHOLD
+    reg = FindingRegistry()
+    reg.entries["C0"] = {
+        "canonical_id": "C0", "status": "OPEN",
+        "severity": CRITICAL_SEVERITY_THRESHOLD - 1e-9,
+        "description": "just under", "routing_deferred": True,
+    }
+    assert reg.irreducible_queue_count() == 0

