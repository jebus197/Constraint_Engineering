### cc2:attempt-1:bench/tests/test_the_role_axis_carries_demotion_2026-10-31.py
--- /dev/null	2026-10-31 02:54:54
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_ol9ceyrp/repo/bench/tests/test_the_role_axis_carries_demotion_2026-10-31.py	2026-10-31 02:51:10
@@ -0,0 +1,108 @@
+"""The structural role axis DOES carry promotion and demotion. Pin it.
+
+JOINT ROUND `the_role_layer_b21_2026-10-30`, seat fable, round 2.
+
+The joint brief lists as settled, measured by both seats: "`bench/routing.py` --
+the mechanism that actually promotes and demotes -- contains 0 occurrences of
+`role` ... Promotion and demotion are not on the role axis at all." The first
+clause is true of `bench/routing.py`. The GENERALISATION is false, and these
+tests are the execution that shows it: `bench/dm/` moves seats between role
+values on failure and on measured capability.
+
+  * `FailureHandler.get_recovery` maps a repeated UNDERPERFORM to
+    `RecoveryAction.DOWNGRADE_ROLE` and MUTATES `role_map`, COL -> PAR, then
+    escalates PAR -> EXCLUDE because PAR has no lower role
+    (`bench/dm/_failure_handler.py`, the `IM_F008` branch).
+  * `RoleAssignment.reassign` re-chooses COL between rounds on capability
+    fingerprints, holding PM static for the run duration (HARD constraint C3).
+  * `LoadBalancer._eligibility_mask` gates which seats may receive tasks on the
+    same role values -- PM is excluded from standard tasks when K > 1.
+
+WHY IT MATTERS, AND IT IS THE CAVEAT'S OWN QUESTION. The founder's caveat says
+the football framing was adopted "to help us decide how things should be
+organised, and when models should be demoted/promoted", and asks what the
+scaffolding held up. The answer is not "nothing": it holds up these three
+mechanisms, all keyed on role IDENTITY. A rename that moved the dispatch
+vocabulary (`experiment_11_orchestrator.Role`) without moving this one would
+leave demotion keyed on names no longer used, and nothing would say so. These
+tests make that loud.
+
+They pin BEHAVIOUR (a demotion happens, keyed on role) and NOT the spelling, so
+they survive whichever vocabulary the founder rules for -- they fail only if the
+demotion mechanism stops being role-keyed.
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from bench.dm._failure_handler import FailureHandler          # noqa: E402
+from bench.dm._load_balancer import LoadBalancer              # noqa: E402
+from bench.dm._role_assignment import RoleAssignment          # noqa: E402
+from bench.dm._types import (                                 # noqa: E402
+    CapabilityFingerprint, DynamicManagementConfig, FailureType, ModelSpec,
+    RecoveryAction, Role,
+)
+
+
+def _models() -> list[ModelSpec]:
+    return [
+        ModelSpec("m1", CapabilityFingerprint(0.9, 0.9, 0.9, 0.9)),
+        ModelSpec("m2", CapabilityFingerprint(0.5, 0.8, 0.6, 0.5)),
+        ModelSpec("m3", CapabilityFingerprint(0.2, 0.3, 0.4, 0.3)),
+    ]
+
+
+class TestDemotionIsRoleKeyed:
+    def test_a_repeated_failure_demotes_a_seat_on_the_role_axis(self):
+        cfg = DynamicManagementConfig()
+        fh = FailureHandler(
+            _models(), {"m1": Role.PM, "m2": Role.COL, "m3": Role.PAR}, cfg)
+        assert fh.role_map["m2"] is Role.COL
+
+        first = fh.get_recovery("m2", 1, FailureType.UNDERPERFORM)
+        assert first is RecoveryAction.RETRY
+        assert fh.role_map["m2"] is Role.COL, "a single failure must not demote"
+
+        second = fh.get_recovery("m2", 2, FailureType.UNDERPERFORM)
+        assert second is RecoveryAction.DOWNGRADE_ROLE
+        assert fh.role_map["m2"] is Role.PAR, (
+            "the demotion is a mutation OF THE ROLE MAP -- this is the "
+            "promotion/demotion semantics living on the role axis")
+
+    def test_the_bottom_role_escalates_to_exclusion_rather_than_no_op(self):
+        cfg = DynamicManagementConfig()
+        fh = FailureHandler(
+            _models(), {"m1": Role.PM, "m2": Role.COL, "m3": Role.PAR}, cfg)
+        for r in (1, 2):
+            fh.get_recovery("m2", r, FailureType.UNDERPERFORM)
+        assert fh.role_map["m2"] is Role.PAR
+        third = fh.get_recovery("m2", 3, FailureType.UNDERPERFORM)
+        assert third is RecoveryAction.EXCLUDE
+        assert "m2" not in fh.active_models
+
+    def test_pm_is_static_and_col_is_the_reassignable_one(self):
+        cfg = DynamicManagementConfig()
+        ra = RoleAssignment.assign(_models(), cfg)
+        assert ra.role_map["m1"] is Role.PM
+        assigned = {r for r in ra.role_map.values()}
+        assert Role.COL in assigned, (
+            "the collator value IS constructed -- on the dm declaration, which "
+            "an AST scan of ModelConfig(role=...) call sites cannot see")
+        pm_before = ra.pm_model_id
+        ra.reassign(1, {"m1", "m2", "m3"})
+        assert ra.pm_model_id == pm_before, "PM static for the run (HARD C3)"
+
+    def test_task_admissibility_is_gated_on_the_same_role_values(self):
+        cfg = DynamicManagementConfig()
+        models = _models()
+        from bench.dm._types import Task
+        tasks = [Task(task_id="t1", token_demand=1.0, flaw_class=1, criticality=0.5)]
+        lb = LoadBalancer(
+            models, tasks, {"m1": Role.PM, "m2": Role.COL, "m3": Role.PAR}, cfg)
+        mask = lb._admissibility_mask()
+        # PM is excluded from standard tasks when more than one seat is in play.
+        assert mask[0][0] == 0, "PM excluded from standard tasks when K > 1"
+        assert mask[0][1] == 1 and mask[0][2] == 1, "COL and PAR are eligible"

### cc2:attempt-1:bench/tests/test_the_role_literal_is_enforced_2026-10-31.py
--- /dev/null	2026-10-31 02:54:54
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_ol9ceyrp/repo/bench/tests/test_the_role_literal_is_enforced_2026-10-31.py	2026-10-31 02:46:59
@@ -0,0 +1,97 @@
+"""`Role` is enforced at construction, and the enforcement preserves behaviour.
+
+Panel round `the_role_layer_b21_2026-10-30`. Before this, `Role` at
+`bench/experiment_11_orchestrator.py:59` was a `Literal` annotation that no
+runtime check read, and an AST scan of every live `ModelConfig(role=...)` site
+(`scripts/how_many_role_values_does_the_code_construct_2026-10-31.py`) found 4
+spellings against 3 declared members: `player` at 9 sites and `reviewer` at 4.
+
+These tests pin the 3 properties that matter and NOT the alias table's contents,
+which are the founder's to extend:
+
+  1. the enforcement reaches every construction, because it is in `__post_init__`
+  2. it is behaviour-PRESERVING at every live read, so it is not a change of
+     dispatch disguised as a type fix
+  3. `Role` is the single source of truth -- `canonical_role` reads
+     `get_args(Role)` rather than a second list that could drift
+"""
+from __future__ import annotations
+
+import sys
+from pathlib import Path
+from typing import get_args
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
+
+from bench.experiment_11_orchestrator import (  # noqa: E402
+    ExperimentConfig,
+    ModelConfig,
+    ROLE_ALIASES,
+    Role,
+    canonical_role,
+)
+
+
+def _mc(role: str) -> ModelConfig:
+    return ModelConfig(label="T", model_id="sim", api="sim",
+                       role=role, system_prompt_path=None)
+
+
+def test_every_declared_member_round_trips():
+    for member in get_args(Role):
+        assert canonical_role(member) == member
+        assert _mc(member).role == member
+
+
+def test_an_undeclared_spelling_cannot_survive_construction():
+    """The defect: a spelling outside `Role` reaching a reader unchanged."""
+    for spelling in ("goalkeeper", "striker", "", "Participant"):
+        with pytest.raises(ValueError, match="unknown ModelConfig role"):
+            _mc(spelling)
+
+
+def test_every_alias_resolves_to_a_declared_member():
+    """Pins the INVARIANT, not the table. An alias naming a non-member would
+    reintroduce the drift through the mechanism built to close it."""
+    assert ROLE_ALIASES, "an empty alias table is an addition nothing reaches"
+    for alias, target in ROLE_ALIASES.items():
+        assert alias not in get_args(Role), f"{alias!r} is a member, not an alias"
+        assert target in get_args(Role), f"alias {alias!r} -> non-member {target!r}"
+        assert _mc(alias).role == target
+
+
+def test_normalisation_preserves_every_live_read():
+    """The 2 reads the brief cites plus the confer split and the role lookup.
+
+    `reference_runner_v3.py:13189`/`:13269` and 16 siblings: `!= "collator"`.
+    `run_exp20_confer.py:253`/`:533`: `== "player_manager"`.
+    Behaviour must be identical before and after normalisation for every alias.
+    """
+    for alias, target in ROLE_ALIASES.items():
+        assert (alias != "collator") == (target != "collator")
+        assert (alias == "player_manager") == (target == "player_manager")
+
+
+def test_an_aliased_seat_is_now_found_by_a_role_keyed_lookup():
+    """This is the only behaviour that CHANGES, and it changes in one direction.
+
+    `ExperimentConfig.get_by_role` compares for equality, so before
+    normalisation a seat constructed as `player` was invisible to
+    `get_by_role("participant")` while still being dispatched by the
+    `!= "collator"` filter. A role-KEYED policy layer would inherit that
+    asymmetry.
+    """
+    cfg = ExperimentConfig(models=[_mc("player"), _mc("participant")])
+    assert len(cfg.get_by_role("participant")) == 2
+    assert cfg.get_by_role("collator") == []
+
+
+def test_canonical_role_reads_the_literal_not_a_copy():
+    """No second hand-written member list anywhere in the module source."""
+    src = (Path(__file__).resolve().parents[1]
+           / "experiment_11_orchestrator.py").read_text(encoding="utf-8")
+    assert "get_args(Role)" in src, "members must be derived from `Role` itself"
+    # The members appear in exactly one place: the `Role` assignment.
+    assert src.count('"collator", "player_manager", "participant"') == 1

### cc2:attempt-1:bench/tests/test_the_structural_role_vocabulary_cannot_fork_silently_2026-10-31.py
--- /dev/null	2026-10-31 02:54:54
+++ /var/folders/cc/scptwd_s4cgclnjn5937fyjw0000gn/T/cdsfl_panel_ol9ceyrp/repo/bench/tests/test_the_structural_role_vocabulary_cannot_fork_silently_2026-10-31.py	2026-10-31 02:46:59
@@ -0,0 +1,134 @@
+"""The structural role vocabulary is declared twice and must not fork silently.
+
+ESTABLISHED BY EXECUTION, panel round `the_role_layer_b21_2026-10-30`: the 3
+structural role concepts are declared in 2 unlinked places --
+`bench/experiment_11_orchestrator.py:59` as
+`Role = Literal["collator", "player_manager", "participant"]`, and
+`bench/dm/_types.py:311` as `Role(enum.Enum)` with members PM / COL / PAR, the
+declaration that carries the reassignment semantics (PM static for the run,
+HARD constraint C3; COL and PAR reassignable between rounds by
+`RoleAssignment.reassign`). Nothing mapped the two, and the `Literal` is not
+enforced at runtime: `bench/tools/run_simulated_experiment.py:638` and
+`bench/tools/gemini_tool_switch_test.py:72` passed `role="player"`, a 4th value
+outside the declared vocabulary, to live `ModelConfig` constructions. No code
+compares `== "player"` anywhere (measured 2026-10-31: the only live role
+comparisons are `!= "collator"` at `bench/reference_runner_v3.py:13189`/
+`:13269` and `player_manager` in `bench/run_exp20_confer.py`), so the stray
+value changed no behaviour -- which is exactly why nothing noticed it.
+
+WHY THIS GUARD EXISTS. Entry B21 asks whether the structural vocabulary should
+be renamed to the founder's functional one. Whatever he rules, a rename applied
+to ONE declaration and not the other would silently detach the reassignment
+semantics from the vocabulary used at dispatch. This test makes that fork loud:
+
+  1. the two declarations must stay in explicit bijection;
+  2. every quoted `role=` value passed to `ModelConfig` in live bench code
+     must be a member of the declared `Literal`.
+
+It pins the CORRESPONDENCE, not the words -- if both declarations are renamed
+together, update CORRESPONDENCE here in the same change and the guard holds
+the new vocabulary instead.
+"""
+from __future__ import annotations
+
+import ast
+import pathlib
+import typing
+
+import pytest
+
+from bench import experiment_11_orchestrator as orch
+from bench.dm._types import Role as DmRole
+
+REPO = pathlib.Path(__file__).resolve().parents[2]
+
+#: The asserted bijection between the orchestrator's string vocabulary and the
+#: dm enum's members. A rename of either side alone fails test 1 and names the
+#: other side as the thing left behind.
+CORRESPONDENCE = {
+    "collator": "COL",
+    "player_manager": "PM",
+    "participant": "PAR",
+}
+
+
+def test_the_two_declarations_are_in_bijection():
+    literal_values = set(typing.get_args(orch.Role))
+    enum_values = {m.value for m in DmRole}
+    assert literal_values == set(CORRESPONDENCE), (
+        f"the orchestrator Literal changed to {sorted(literal_values)} without "
+        f"updating the correspondence to bench/dm/_types.py Role; the "
+        f"reassignment semantics (PM static, HARD C3) live on the OTHER "
+        f"declaration and would silently detach")
+    assert enum_values == set(CORRESPONDENCE.values()), (
+        f"bench/dm/_types.py Role changed to {sorted(enum_values)} without "
+        f"updating the correspondence to the orchestrator Literal used at "
+        f"dispatch (mc.role reads in reference_runner_v3)")
+    assert len(set(CORRESPONDENCE.values())) == len(CORRESPONDENCE), (
+        "the correspondence is not a bijection")
+
+
+def _live_python():
+    """Live bench .py files: not tests, not logs, not archived harvests."""
+    for p in (REPO / "bench").rglob("*.py"):
+        rel = p.relative_to(REPO).as_posix()
+        if "/logs/" in rel or rel.startswith("bench/tests/"):
+            continue
+        yield p
+
+
+def _modelconfig_role_values(paths):
+    """Every quoted value passed as `role=` to a ModelConfig(...) call."""
+    out = []
+    for p in paths:
+        try:
+            tree = ast.parse(p.read_text(encoding="utf-8"))
+        except SyntaxError:
+            continue
+        for node in ast.walk(tree):
+            if not isinstance(node, ast.Call):
+                continue
+            fn = node.func
+            name = fn.id if isinstance(fn, ast.Name) else (
+                fn.attr if isinstance(fn, ast.Attribute) else "")
+            if name != "ModelConfig":
+                continue
+            for kw in node.keywords:
+                if kw.arg == "role" and isinstance(kw.value, ast.Constant) \
+                        and isinstance(kw.value.value, str):
+                    try:
+                        rel = p.relative_to(REPO).as_posix()
+                    except ValueError:  # planted file outside the repo
+                        rel = p.name
+                    out.append((rel, kw.value.lineno, kw.value.value))
+    return out
+
+
+def test_every_live_modelconfig_role_is_in_the_declared_vocabulary():
+    declared = set(typing.get_args(orch.Role))
+    strays = [(f, ln, v) for f, ln, v in
+              _modelconfig_role_values(_live_python()) if v not in declared]
+    assert not strays, (
+        "live code passes role values outside the declared Literal, which is "
+        "unenforced at runtime, so the vocabulary has forked silently:\n"
+        + "\n".join(f"    {f}:{ln}  role={v!r}" for f, ln, v in strays))
+
+
+def test_the_scanner_can_see_a_planted_stray(tmp_path):
+    """ANTI-VACUITY: a scanner that misses a planted stray proves nothing."""
+    planted = tmp_path / "planted.py"
+    planted.write_text(
+        "mc = ModelConfig(label='x', role='striker')\n", encoding="utf-8")
+    vals = _modelconfig_role_values([planted])
+    assert ("planted.py" in vals[0][0] if vals else False) or any(
+        v == "striker" for _, _, v in vals), (
+        "a planted out-of-vocabulary role was not seen, so a real one would "
+        "pass too")
+
+
+def test_the_scanner_reads_real_sites():
+    """A scan that finds 0 construction sites is scanning the wrong tree."""
+    vals = _modelconfig_role_values(_live_python())
+    assert len(vals) >= 3, (
+        f"only {len(vals)} quoted ModelConfig role site(s) found in live "
+        f"bench code; the vocabulary scan has gone blind")

