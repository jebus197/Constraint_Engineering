+        print(f"       {nm:34s} invisible-error pairs = {v}")
+    print()
+    print(f"     O2 breakdown: B hides {_B[2]} live question(s) on the banner and")
+    print(f"     still suppresses {_B[3]} on the gate; C hides {_C[2]} and suppresses {_C[3]}.")
+    print()
