+    print(f"      {label}: {k} of {n} = {k / n:.6f}")
+    print(f"          Wilson [{wl:.6f}, {wh:.6f}]  "
+          f"Clopper-Pearson [{cl:.6f}, {ch:.6f}]  "
+          f"2 routes agree to {agree:.3e}")
+
+
+def _load(name, rel):
