+def shell_bindings(cmd: str) -> dict:
+    """Variable -> literal value, for every binding visible in ONE command's text.
+
+    RESOLVE, DO NOT GUESS. A binding whose value is not a literal -- it contains a
+    command substitution or a backtick -- is OMITTED rather than half-expanded, because
+    a truncated fragment classifies as confidently as a real path and is wrong.
+    """
+    m = {}
+    for k, v in _ASSIGN.findall(cmd or ""):
+        v = v.strip().strip("\"\'")
+        if "$(" in v or "`" in v:
+            continue
+        m.setdefault(k, v)
+    for k, vals in _FORLOOP.findall(cmd or ""):
+        toks = [t for t in vals.split() if "$" not in t and "*" not in t]
+        if toks:
+            m.setdefault(k, toks[0])
+    return m
