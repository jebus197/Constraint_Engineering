+_MAIN_WORK_TREE_CACHE: list = []
+
+
+def _main_work_tree() -> str:
+    """The canonical work tree of the repository this file lives in.
+
+    Returns `REPO_ROOT` itself when this is not a worktree, or when git cannot
+    answer -- the failure direction is "no extra root", which is the status quo
+    and never a widening. Cached: `_allow_roots` is called per falsifier and a
+    subprocess per call would be paid hundreds of times a run.
+    """
+    if _MAIN_WORK_TREE_CACHE:
+        return _MAIN_WORK_TREE_CACHE[0]
+    root = os.path.normpath(str(REPO_ROOT))
+    try:
+        import subprocess as _sp
+        common = _sp.run(["git", "rev-parse", "--git-common-dir"],
+                         capture_output=True, text=True, timeout=10,
+                         cwd=str(REPO_ROOT)).stdout.strip()
+        if common:
+            cand = os.path.dirname(os.path.abspath(
+                os.path.join(str(REPO_ROOT), common)))
+            if os.path.isdir(cand):
+                root = os.path.normpath(cand)
+    except Exception:                                    # noqa: BLE001
+        pass
+    _MAIN_WORK_TREE_CACHE.append(root)
+    return root
 
 
